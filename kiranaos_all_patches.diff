+++ scripts/audit/duplicate-payment-detector.js
@@ -0,0 +1,260 @@
+// scripts/audit/duplicate-payment-detector.js
+//
+// KiranaAudit — Duplicate Payment Detector (Phase-1 wedge, proof-point v0)
+//
+// Reads the shop's `payments` and `udharLedger` tables and surfaces payments
+// that look like unintended duplicates. Every finding carries a risk score,
+// human-readable reasons, and the evidence chain the auditor should follow.
+//
+// This is DIAGNOSTIC: it never mutates data. Output is written to the console
+// and (optionally) persisted to an AuditFinding-style JSON file for the
+// working-paper generator.
+//
+// USAGE:
+//   node scripts/audit/duplicate-payment-detector.js --shopId=<id> [--days=90] [--outFile=findings.json]
+//
+// EXIT CODES:
+//   0 — scan finished (findings may or may not exist)
+//   1 — bad arguments or DB error
+//
+// DESIGN NOTES (v0):
+//   Rule 1  Exact-clone within a short window:
+//           same shopId, same billId, same mode, same amount, same day.
+//           SEVERITY: high (this is almost always a double-post).
+//   Rule 2  Near-clone: same customer, same amount, same mode, within 30 min.
+//           SEVERITY: medium (usually a manual re-entry; sometimes legitimate).
+//   Rule 3  Idempotency-key collision path — same idempotencyKey but different
+//           payment rows (should be impossible given the unique index, but we
+//           check as an integrity guard and to flag any historical bypasses).
+//           SEVERITY: critical (violates a DB invariant).
+//   Rule 4  Udhar-payment double-entry: a UdharLedger.type='payment' row that
+//           mirrors an existing Payment row (same bill/customer/day/amount)
+//           where BOTH exist independently. SEVERITY: medium.
+//   Rule 5  Reversal-not-cancelled: a payment marked reversed but the original
+//           still counted in a daily-closing snapshot. SEVERITY: high.
+//
+// NOTES ON FUTURE RULES (v1+):
+//   - Round-tripping (A→B→A within 24h)
+//   - Off-hours entries (payments booked 00:00-05:00 IST)
+//   - Weekend anomalies for cash-only shops
+//   - Benford's law on first-digit distribution of amounts
+
+import { PrismaClient } from "@prisma/client";
+import fs from "node:fs/promises";
+import path from "node:path";
+
+const db = new PrismaClient();
+
+const argv = Object.fromEntries(process.argv.slice(2).map(a => {
+  const [k, v] = a.replace(/^--/, "").split("=");
+  return [k, v ?? true];
+}));
+const shopId = argv.shopId;
+const days   = Number(argv.days ?? 90);
+const outFile = argv.outFile ?? null;
+
+if (!shopId) {
+  console.error("--shopId is required");
+  process.exit(1);
+}
+const since = new Date(Date.now() - days * 86400_000);
+
+// ── helpers ─────────────────────────────────────────────────────────────
+const round2 = (n) => Math.round(Number(n) * 100) / 100;
+const dayKey = (d) => new Date(d).toISOString().slice(0, 10);
+const minuteKey = (d) => Math.floor(new Date(d).getTime() / 60_000);
+const finding = (rule, severity, subjectIds, reasons, evidence) => ({
+  rule, severity,
+  subjects: subjectIds,
+  riskScore: { critical: 95, high: 80, medium: 55, low: 25 }[severity] ?? 50,
+  reasons,
+  evidence,
+  detectedAt: new Date().toISOString(),
+});
+
+async function main() {
+  console.log(`\n🔍 KiranaAudit — Duplicate Payment Detector`);
+  console.log(`   shopId : ${shopId}`);
+  console.log(`   window : last ${days} days (since ${since.toISOString().slice(0, 10)})`);
+  console.log(`─────────────────────────────────────────────────────────────`);
+
+  const payments = await db.payment.findMany({
+    where: { shopId, createdAt: { gte: since } },
+    orderBy: [{ createdAt: "asc" }, { id: "asc" }],
+  });
+  const ledger = await db.udharLedger.findMany({
+    where: { shopId, createdAt: { gte: since }, reversedAt: null },
+    orderBy: [{ createdAt: "asc" }, { id: "asc" }],
+  });
+  console.log(`   payments loaded: ${payments.length}`);
+  console.log(`   udhar-ledger rows loaded: ${ledger.length}\n`);
+
+  const findings = [];
+
+  // ── Rule 1 — exact clone within same day ─────────────────────────────
+  const bucket = new Map();
+  for (const p of payments) {
+    const k = [p.billId, p.mode, round2(p.amount), dayKey(p.createdAt)].join("|");
+    (bucket.get(k) ?? bucket.set(k, []).get(k)).push(p);
+  }
+  for (const [k, arr] of bucket) {
+    if (arr.length < 2) continue;
+    // Excluding those already accounted for by the child-idempotency-key pattern
+    // (e.g. "billId:payment:0:cash" vs "billId:payment:1:cash" are legit splits;
+    // idempotencyKey differing is fine — but same billId+mode+amount+day means
+    // a split payment, which is unusual. Flag as medium unless amount matches
+    // parent bill EXACTLY twice — then it's a clean double-post.
+    findings.push(finding(
+      "R1_EXACT_CLONE_SAME_DAY",
+      "high",
+      arr.map(p => p.id),
+      [
+        `${arr.length} payments share (billId=${arr[0].billId}, mode=${arr[0].mode}, amount=₹${arr[0].amount}, day=${dayKey(arr[0].createdAt)})`,
+        `sum posted: ₹${arr.reduce((s, p) => s + Number(p.amount), 0)} — verify against the bill's grandTotal`,
+      ],
+      { paymentIds: arr.map(p => p.id), idempotencyKeys: arr.map(p => p.idempotencyKey), billId: arr[0].billId }
+    ));
+  }
+
+  // ── Rule 2 — near-clone: same customer, mode, amount within 30 min ───
+  //  (only where customer is present — walk-ins skipped)
+  const byCust = new Map();
+  for (const p of payments) {
+    if (!p.billId) continue;
+    // pull customerId via bill
+  }
+  const billMap = new Map();
+  const billIds = [...new Set(payments.map(p => p.billId).filter(Boolean))];
+  const bills = await db.bill.findMany({ where: { id: { in: billIds } }, select: { id: true, customerId: true, grandTotal: true, billNo: true } });
+  bills.forEach(b => billMap.set(b.id, b));
+  for (const p of payments) {
+    const b = billMap.get(p.billId);
+    if (!b?.customerId) continue;
+    const k = [b.customerId, p.mode, round2(p.amount)].join("|");
+    (byCust.get(k) ?? byCust.set(k, []).get(k)).push({ p, b });
+  }
+  for (const [k, arr] of byCust) {
+    if (arr.length < 2) continue;
+    // check any two are within 30 min AND on different bills
+    for (let i = 0; i < arr.length; i++) {
+      for (let j = i + 1; j < arr.length; j++) {
+        const dt = Math.abs(minuteKey(arr[i].p.createdAt) - minuteKey(arr[j].p.createdAt));
+        if (dt <= 30 && arr[i].b.id !== arr[j].b.id) {
+          findings.push(finding(
+            "R2_NEAR_CLONE_SAME_CUSTOMER_WINDOW",
+            "medium",
+            [arr[i].p.id, arr[j].p.id],
+            [
+              `same customer=${arr[i].b.customerId} paid ₹${arr[i].p.amount} via ${arr[i].p.mode} on two bills within ${dt} min`,
+              `bills: ${arr[i].b.billNo} and ${arr[j].b.billNo}`,
+            ],
+            { paymentIds: [arr[i].p.id, arr[j].p.id], billNos: [arr[i].b.billNo, arr[j].b.billNo] }
+          ));
+        }
+      }
+    }
+  }
+
+  // ── Rule 3 — idempotencyKey collision (integrity guard) ──────────────
+  const byKey = new Map();
+  for (const p of payments) {
+    if (!p.idempotencyKey) continue;
+    (byKey.get(p.idempotencyKey) ?? byKey.set(p.idempotencyKey, []).get(p.idempotencyKey)).push(p);
+  }
+  for (const [key, arr] of byKey) {
+    if (arr.length < 2) continue;
+    findings.push(finding(
+      "R3_IDEMPOTENCY_KEY_COLLISION",
+      "critical",
+      arr.map(p => p.id),
+      [
+        `idempotencyKey='${key}' has ${arr.length} rows — violates @@unique([shopId, idempotencyKey]) invariant`,
+        `likely cause: a bypass path exists (raw SQL / seed / migration); investigate audit_log around ${arr[0].createdAt.toISOString()}`,
+      ],
+      { paymentIds: arr.map(p => p.id) }
+    ));
+  }
+
+  // ── Rule 4 — udhar-payment double-entry with Payment row ─────────────
+  const paidTuples = new Set(payments.map(p => `${p.billId ?? ''}|${p.mode}|${round2(p.amount)}|${dayKey(p.createdAt)}`));
+  for (const l of ledger) {
+    if (l.type !== "payment") continue;
+    if (!l.billId) continue;
+    const tup = `${l.billId}|${l.mode}|${round2(l.amount)}|${dayKey(l.createdAt)}`;
+    if (paidTuples.has(tup)) {
+      findings.push(finding(
+        "R4_UDHAR_PAYMENT_MIRRORS_PAYMENT_ROW",
+        "medium",
+        [l.id],
+        [
+          `UdharLedger row (id=${l.id}) mirrors a Payment row for bill=${l.billId} mode=${l.mode} amt=₹${l.amount} day=${dayKey(l.createdAt)}`,
+          `verify that the daily closing snapshot does not double-count`,
+        ],
+        { ledgerId: l.id, billId: l.billId }
+      ));
+    }
+  }
+
+  // ── Rule 5 — reversed payment still in daily closing ─────────────────
+  const reversedPayments = await db.udharLedger.findMany({
+    where: { shopId, type: "payment", reversedAt: { not: null } },
+    select: { id: true, billId: true, amount: true, mode: true, reversedAt: true, createdAt: true, reversalOfLedgerId: true },
+  });
+  const snapshots = await db.dailyClosingSnapshot.findMany({
+    where: { shopId }, select: { id: true, date: true, lockedByUserId: true },
+  });
+  const lockedDays = new Set(snapshots.filter(s => s.lockedByUserId).map(s => dayKey(s.date)));
+  for (const rev of reversedPayments) {
+    const originalDay = dayKey(rev.createdAt);
+    if (lockedDays.has(originalDay)) {
+      findings.push(finding(
+        "R5_REVERSAL_AFTER_DAILY_CLOSE",
+        "high",
+        [rev.id],
+        [
+          `payment reversed on ${rev.reversedAt.toISOString()} but original day ${originalDay} was already locked`,
+          `daily closing snapshot for ${originalDay} may need restatement`,
+        ],
+        { ledgerId: rev.id, originalDay }
+      ));
+    }
+  }
+
+  // ── report ───────────────────────────────────────────────────────────
+  const summary = { total: findings.length, byRule: {}, bySeverity: {} };
+  for (const f of findings) {
+    summary.byRule[f.rule] = (summary.byRule[f.rule] ?? 0) + 1;
+    summary.bySeverity[f.severity] = (summary.bySeverity[f.severity] ?? 0) + 1;
+  }
+
+  console.log(`═════════════════════════════════════════════════════════════`);
+  console.log(`  📊 SUMMARY`);
+  console.log(`     total findings: ${summary.total}`);
+  console.log(`     by severity  : ${JSON.stringify(summary.bySeverity)}`);
+  console.log(`     by rule      : ${JSON.stringify(summary.byRule)}`);
+  console.log(`═════════════════════════════════════════════════════════════\n`);
+
+  if (findings.length) {
+    for (const f of findings.slice(0, 25)) {
+      console.log(`  ▸ [${f.severity.toUpperCase()} ${f.riskScore}] ${f.rule}`);
+      f.reasons.forEach(r => console.log(`      • ${r}`));
+      console.log("");
+    }
+    if (findings.length > 25) console.log(`  … and ${findings.length - 25} more (see outFile)`);
+  } else {
+    console.log(`  ✅ Clean — no duplicate-payment signals in the last ${days} days.`);
+  }
+
+  if (outFile) {
+    const abs = path.resolve(outFile);
+    await fs.writeFile(abs, JSON.stringify({ shopId, since, summary, findings }, null, 2));
+    console.log(`\n  💾 written to ${abs}`);
+  }
+  await db.$disconnect();
+}
+
+main().catch(async (e) => {
+  console.error(e);
+  await db.$disconnect();
+  process.exit(1);
+});
