+// tests/integration/preview-bug-patches.integration.test.js
+//
+// Regression tests for the 5 bugs discovered during the Emergent live preview
+// (2026-07-25). Each test asserts the exact behaviour the patch introduced, so
+// a future refactor cannot reintroduce the bug.
+//
+// Bugs covered:
+//   #1 Zod loginSchema silently stripped deviceId → session.deviceId = null.
+//      → device-limit bypass + SESSION_DEVICE_MISMATCH on re-login.
+//      Patch also revokes prior open sessions on same-device re-login.
+//   #2 POST /api/udhar/pay alias route + customerId schema field
+//      + GET /api/udhar/routes discoverability.
+//   #3 prisma/seed.js sets pinHash on the demo owner (checked in seed smoke).
+//   #4 POST /api/sync/push response has BOTH `data.results` and `data.events`
+//      as identical arrays.
+//   #5 prisma/schema.prisma binaryTargets include linux-arm64 + linux-musl.
+//
+// Run:  npm run test:integration -- tests/integration/preview-bug-patches.integration.test.js
+//    or node --test tests/integration/preview-bug-patches.integration.test.js
+
+import test, { after, beforeEach, describe } from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import path from "node:path";
+import { createIntegrationContext, resetDatabase, assertFailure, assertSuccess } from "./setup.js";
+import { createTenant, uniqueMobile } from "./factories.js";
+
+const ctx = await createIntegrationContext();
+
+if (ctx.skip) {
+  test("preview-bug-patches integration skipped", { skip: ctx.reason }, () => {});
+} else {
+  after(async () => ctx.close());
+  beforeEach(async () => resetDatabase(ctx.db));
+
+  // ────────────────────────────────────────────────────────────────────
+  describe("Preview bug #1 — loginSchema retains deviceId; re-login revokes prior session", () => {
+    test("login with deviceId in body persists it on the session", async () => {
+      const t = await createTenant(ctx.db);
+      const res = await ctx.post("/api/auth/login", {
+        mobile: t.ownerMobile,
+        password: t.ownerPassword,
+        deviceId: "test-device-A",
+        deviceName: "QA",
+        platform: "web",
+      });
+      const data = assertSuccess(res);
+      assert.ok(data.accessToken);
+
+      const sessions = await ctx.db.session.findMany({
+        where: { userId: t.owner.id, revokedAt: null },
+        select: { deviceId: true },
+      });
+      assert.equal(sessions.length, 1, "exactly one open session");
+      assert.equal(sessions[0].deviceId, "test-device-A", "deviceId survives Zod parse");
+    });
+
+    test("re-login on same device revokes the prior session (no accumulation)", async () => {
+      const t = await createTenant(ctx.db);
+      const first = await ctx.post("/api/auth/login", {
+        mobile: t.ownerMobile, password: t.ownerPassword, deviceId: "dev-1",
+      });
+      assertSuccess(first);
+
+      const second = await ctx.post("/api/auth/login", {
+        mobile: t.ownerMobile, password: t.ownerPassword, deviceId: "dev-1",
+      });
+      assertSuccess(second);
+
+      const open = await ctx.db.session.count({
+        where: { userId: t.owner.id, deviceId: "dev-1", revokedAt: null },
+      });
+      const revoked = await ctx.db.session.count({
+        where: { userId: t.owner.id, deviceId: "dev-1", revokedReason: "REPLACED_BY_NEW_LOGIN" },
+      });
+      assert.equal(open, 1, "only the newest session for dev-1 is open");
+      assert.equal(revoked, 1, "prior session was revoked with correct reason");
+    });
+
+    test("old token stops working after re-login on same device", async () => {
+      const t = await createTenant(ctx.db);
+      const first = await ctx.post("/api/auth/login", {
+        mobile: t.ownerMobile, password: t.ownerPassword, deviceId: "dev-2",
+      });
+      const oldToken = assertSuccess(first).accessToken;
+
+      await ctx.post("/api/auth/login", {
+        mobile: t.ownerMobile, password: t.ownerPassword, deviceId: "dev-2",
+      });
+
+      const check = await ctx.get("/api/auth/me", {
+        token: oldToken,
+        headers: { "x-device-id": "dev-2" },
+      });
+      // 401 (session revoked) is expected; some code paths may map to 403 SESSION_INACTIVE.
+      assert.ok(check.status === 401 || check.status === 403, `expected 401/403, got ${check.status}`);
+      assert.equal(check.body?.success, false);
+    });
+  });
+
+  // ────────────────────────────────────────────────────────────────────
+  describe("Preview bug #2 — /api/udhar/pay alias + discoverability + customerId in schema", () => {
+    async function loginAndActivate(t, deviceId) {
+      const login = assertSuccess(await ctx.post("/api/auth/login", {
+        mobile: t.ownerMobile, password: t.ownerPassword, deviceId,
+      }));
+      await ctx.post("/api/devices/activate",
+        { deviceId, deviceName: "R", platform: "web" },
+        { token: login.accessToken, headers: { "x-device-id": deviceId } });
+      return { token: login.accessToken, deviceId };
+    }
+
+    test("GET /api/udhar/routes lists the pay alias and canonical route", async () => {
+      const t = await createTenant(ctx.db);
+      const { token, deviceId } = await loginAndActivate(t, "dev-r-1");
+      const res = await ctx.get("/api/udhar/routes", { token, headers: { "x-device-id": deviceId } });
+      const data = assertSuccess(res);
+      const paths = data.endpoints.map((e) => e.path);
+      assert.ok(paths.includes("/api/udhar/pay"), "alias route listed");
+      assert.ok(paths.includes("/api/customers/:id/udhar-payment"), "canonical route listed");
+    });
+
+    test("POST /api/udhar/pay processes repayment when customerId is in body", async () => {
+      const t = await createTenant(ctx.db);
+      const { token, deviceId } = await loginAndActivate(t, "dev-r-2");
+
+      const customer = await ctx.db.customer.create({
+        data: { shopId: t.shop.id, name: "Regression Cust", mobile: uniqueMobile(), udharAmount: 500 },
+      });
+      await ctx.db.udharLedger.create({
+        data: {
+          shopId: t.shop.id, customerId: customer.id, customerName: customer.name,
+          type: "debit", mode: "credit", amount: 500,
+          sourceType: "opening_balance", note: "seed",
+        },
+      });
+
+      const res = await ctx.post("/api/udhar/pay",
+        { customerId: customer.id, amount: 100, mode: "cash", clientLedgerId: `reg-pay-${Date.now()}` },
+        { token, headers: { "x-device-id": deviceId } });
+      assertSuccess(res);
+
+      const rows = await ctx.db.udharLedger.findMany({
+        where: { shopId: t.shop.id, customerId: customer.id },
+        select: { type: true, amount: true },
+      });
+      const net = rows.reduce(
+        (s, r) => s + (r.type === "payment" ? -Number(r.amount) : Number(r.amount)),
+        0
+      );
+      assert.equal(net, 400, "balance reduced by 100 → 400");
+    });
+
+    test("POST /api/udhar/pay rejects missing customerId with clear code", async () => {
+      const t = await createTenant(ctx.db);
+      const { token, deviceId } = await loginAndActivate(t, "dev-r-3");
+
+      const res = await ctx.post("/api/udhar/pay",
+        { amount: 10, mode: "cash" },
+        { token, headers: { "x-device-id": deviceId } });
+      assert.equal(res.status, 400);
+      assert.equal(res.body?.success, false);
+      assert.equal(res.body?.code, "CUSTOMER_ID_REQUIRED");
+    });
+  });
+
+  // ────────────────────────────────────────────────────────────────────
+  describe("Preview bug #4 — sync/push response exposes both `results` and `events`", () => {
+    test("both aliases are present and identical", async () => {
+      const t = await createTenant(ctx.db);
+      const login = assertSuccess(await ctx.post("/api/auth/login", {
+        mobile: t.ownerMobile, password: t.ownerPassword, deviceId: "dev-sync",
+      }));
+      await ctx.post("/api/devices/activate",
+        { deviceId: "dev-sync", deviceName: "S", platform: "web" },
+        { token: login.accessToken, headers: { "x-device-id": "dev-sync" } });
+
+      const res = await ctx.post("/api/sync/push", {
+        events: [{
+          clientEventId: `reg-sync-${Date.now()}`,
+          type: "CREATE_CUSTOMER",
+          payload: { clientCustomerId: `loc-${Date.now()}`, name: "Sync Test", mobile: uniqueMobile() },
+        }],
+      }, { token: login.accessToken, headers: { "x-device-id": "dev-sync" } });
+
+      const body = res.body;
+      assert.equal(body.success, true);
+      assert.ok("results" in body, "backward-compat `results` present");
+      assert.ok("events" in body, "new `events` alias present");
+      assert.deepEqual(body.results, body.events, "aliases point to the same array");
+    });
+  });
+
+  // ────────────────────────────────────────────────────────────────────
+  describe("Preview bug #5 — Prisma schema binaryTargets include arm64 + musl", () => {
+    test("schema lists both linux-arm64 and linux-musl targets", () => {
+      const schemaPath = path.join(process.cwd(), "prisma", "schema.prisma");
+      const contents = fs.readFileSync(schemaPath, "utf8");
+      const generator = contents.match(/generator client \{[\s\S]*?\}/);
+      assert.ok(generator, "generator block found");
+      assert.match(generator[0], /linux-arm64-openssl-3\.0\.x/, "arm64 target listed");
+      assert.match(generator[0], /linux-musl-openssl-3\.0\.x/, "musl target listed");
+    });
+  });
+}
