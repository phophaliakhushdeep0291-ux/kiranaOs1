+// scripts/audit/gst-2a-reconciler.js
+//
+// KiranaAudit — GST GSTR-2A vs Purchase Register Reconciler (Phase-1 wedge, v0)
+//
+// Compares the client's Purchase register (from KiranaOS purchases + supplier
+// invoices) against a GSTR-2A extract (auto-populated by GSTN from suppliers'
+// GSTR-1 filings). Surfaces the 5 canonical mismatches every GST audit must
+// find.
+//
+// This is DIAGNOSTIC and READ-ONLY.
+//
+// USAGE:
+//   node scripts/audit/gst-2a-reconciler.js --shopId=<id> \
+//        --gstin=<clientGSTIN> \
+//        --period=<YYYY-MM> \
+//        --gstr2a=<path-to-mock-2a.json> \
+//        [--outFile=findings.json]
+//
+// MOCK 2A FORMAT (subset of real GSTN JSON):
+//   {
+//     "fp": "072026",                    // filing period MMYYYY
+//     "recipient_gstin": "27ABCDE1234F1Z5",
+//     "b2b": [
+//       {
+//         "ctin": "24AAAAA0000A1Z0",     // supplier GSTIN
+//         "trdnm": "Agarwal Whole Sale",
+//         "inv": [
+//           { "inum": "AWS/2026/0088", "idt": "2026-07-05", "val": 12500, "itms": [{ "num": 1, "itm_det": {"txval": 10593.22, "rt": 18, "iamt": 0, "camt": 953.39, "samt": 953.39} }] }
+//         ]
+//       }
+//     ]
+//   }
+//
+// The five canonical mismatches:
+//   M1  In-Register-Not-In-2A: supplier claimed ITC on invoice we recorded,
+//       but supplier has NOT filed it in their GSTR-1. Blocks our ITC claim.
+//       → SEVERITY: high (₹ loss)
+//   M2  In-2A-Not-In-Register: supplier filed an invoice against our GSTIN
+//       that we don't have in books. → SEVERITY: high (missed purchase / ghost)
+//   M3  Amount mismatch: same invoice number/date exists on both sides but
+//       taxable value or GST amount differs. → SEVERITY: medium (data-entry
+//       or under-reporting)
+//   M4  GSTIN mismatch: supplier name matches our vendor master but their
+//       GSTIN on 2A differs from ours. → SEVERITY: medium (vendor master
+//       error OR different registration)
+//   M5  Late-filed / cross-period: supplier's 2A invoice is dated in a prior
+//       period but only appeared this period. Impacts ITC time-limit
+//       (Sec 16(4) — must claim by Oct/Nov following FY end). → SEVERITY:
+//       medium (advisory)
+
+import { PrismaClient } from "@prisma/client";
+import fs from "node:fs/promises";
+import path from "node:path";
+
+const db = new PrismaClient();
+const argv = Object.fromEntries(process.argv.slice(2).map(a => {
+  const [k, v] = a.replace(/^--/, "").split("=");
+  return [k, v ?? true];
+}));
+const { shopId, gstin: recipientGstin, period, gstr2a: gstr2aPath, vendorMaster: vendorMasterPath, outFile } = argv;
+if (!shopId || !recipientGstin || !period || !gstr2aPath) {
+  console.error("required: --shopId --gstin --period=YYYY-MM --gstr2a=<file> [--vendorMaster=<file>]");
+  process.exit(1);
+}
+const round2 = (n) => Math.round(Number(n) * 100) / 100;
+const invKey = (gstin, inum) => `${(gstin || "").toUpperCase()}|${(inum || "").trim().toUpperCase()}`;
+const finding = (mismatch, severity, reasons, evidence) => ({
+  mismatch, severity,
+  riskScore: { critical: 95, high: 85, medium: 60, low: 30 }[severity] ?? 50,
+  reasons, evidence,
+  detectedAt: new Date().toISOString(),
+});
+
+async function main() {
+  console.log(`\n🔍 KiranaAudit — GSTR-2A Reconciler`);
+  console.log(`   shopId    : ${shopId}`);
+  console.log(`   gstin     : ${recipientGstin}`);
+  console.log(`   period    : ${period}`);
+  console.log(`   gstr-2a   : ${gstr2aPath}`);
+  console.log(`─────────────────────────────────────────────────────────────`);
+
+  // Parse 2A
+  const gstr2a = JSON.parse(await fs.readFile(gstr2aPath, "utf8"));
+  const twoAInvoices = [];
+  for (const supplier of (gstr2a.b2b || [])) {
+    for (const inv of (supplier.inv || [])) {
+      const totals = (inv.itms || []).reduce((s, i) => {
+        const d = i.itm_det || {};
+        s.taxable += Number(d.txval || 0);
+        s.tax     += Number(d.iamt || 0) + Number(d.camt || 0) + Number(d.samt || 0);
+        return s;
+      }, { taxable: 0, tax: 0 });
+      twoAInvoices.push({
+        supplierGstin: supplier.ctin,
+        supplierName:  supplier.trdnm,
+        invoiceNo:  inv.inum,
+        invoiceDate: inv.idt,
+        totalValue: Number(inv.val || 0),
+        taxable: round2(totals.taxable),
+        tax: round2(totals.tax),
+      });
+    }
+  }
+  console.log(`   2A invoices loaded: ${twoAInvoices.length}`);
+
+  // Load purchase register from KiranaOS
+  const [year, mon] = period.split("-").map(Number);
+  const start = new Date(Date.UTC(year, mon - 1, 1));
+  const end   = new Date(Date.UTC(year, mon, 1));
+  const purchases = await db.purchaseHistory.findMany({
+    where: { shopId, createdAt: { gte: start, lt: end } },
+  });
+  const suppliers = await db.supplier.findMany({ where: { shopId } });
+  // Load vendor-master overrides (real audit path: an ERP-export JSON supplements
+  // whatever the client's POS captures). KiranaOS's Supplier model doesn't yet
+  // store gstNumber; the audit product ships a vendor-master file for now.
+  let vendorMaster = {};
+  if (vendorMasterPath) {
+    vendorMaster = JSON.parse(await fs.readFile(vendorMasterPath, "utf8"));
+  }
+  const gstinBySupplierName = new Map();
+  for (const s of suppliers) {
+    const key = (s.name || "").trim().toUpperCase();
+    const gstin = vendorMaster[s.name] || vendorMaster[key] || null;
+    gstinBySupplierName.set(key, gstin);
+  }
+  console.log(`   purchase-register rows in period: ${purchases.length}`);
+  console.log(`   suppliers in master: ${suppliers.length} (${Object.keys(vendorMaster).length} with GSTIN override)\n`);
+
+  // Build indexes
+  const bookInvoices = purchases.map(p => {
+    const key = (p.supplierName || "").trim().toUpperCase();
+    return {
+      id: p.id,
+      supplierName:  p.supplierName,
+      supplierGstin: gstinBySupplierName.get(key) ?? null,
+      invoiceNo:  p.invoiceNumber ?? null,
+      invoiceDate: p.createdAt,
+      totalValue:  Number(p.totalCost ?? 0),
+      taxable:     round2(Number(p.totalCost ?? 0) / 1.18),  // heuristic: 18% GST if not captured
+      tax:         round2(Number(p.totalCost ?? 0) - Number(p.totalCost ?? 0) / 1.18),
+    };
+  });
+
+  const bookByKey = new Map();
+  bookInvoices.forEach(b => { if (b.invoiceNo && b.supplierGstin) bookByKey.set(invKey(b.supplierGstin, b.invoiceNo), b); });
+  const twoAByKey = new Map();
+  twoAInvoices.forEach(a => { twoAByKey.set(invKey(a.supplierGstin, a.invoiceNo), a); });
+
+  const findings = [];
+
+  // M1 — in register, not in 2A
+  for (const [k, b] of bookByKey) {
+    if (!twoAByKey.has(k)) {
+      findings.push(finding("M1_IN_REGISTER_NOT_IN_2A", "high",
+        [
+          `Purchase invoice ${b.invoiceNo} from ${b.supplierName} (GSTIN ${b.supplierGstin}) is booked but NOT in GSTR-2A for ${period}.`,
+          `ITC of ₹${round2(b.tax)} at risk — supplier likely hasn't filed GSTR-1.`,
+          `Recommended: send email confirmation to supplier; block ITC until they file.`,
+        ],
+        { purchaseId: b.id, invoiceNo: b.invoiceNo, gstin: b.supplierGstin, taxAtRisk: round2(b.tax) }
+      ));
+    }
+  }
+
+  // M2 — in 2A, not in register
+  for (const [k, a] of twoAByKey) {
+    if (!bookByKey.has(k)) {
+      findings.push(finding("M2_IN_2A_NOT_IN_REGISTER", "high",
+        [
+          `Supplier ${a.supplierName} (GSTIN ${a.supplierGstin}) filed invoice ${a.invoiceNo} against your GSTIN in GSTR-2A but you have NO purchase record.`,
+          `Possible causes: (a) invoice booked in a different period, (b) invoice missed / lost, (c) supplier's GSTR-1 has your GSTIN by mistake, (d) fraud (ghost invoice).`,
+          `Value: ₹${a.totalValue} (tax ₹${a.tax}).`,
+        ],
+        { supplierGstin: a.supplierGstin, invoiceNo: a.invoiceNo, value: a.totalValue }
+      ));
+    }
+  }
+
+  // M3 — same invoice, amount mismatch
+  for (const [k, b] of bookByKey) {
+    const a = twoAByKey.get(k);
+    if (!a) continue;
+    const dTaxable = round2(b.taxable - a.taxable);
+    const dTax     = round2(b.tax - a.tax);
+    if (Math.abs(dTaxable) > 1 || Math.abs(dTax) > 0.5) {
+      findings.push(finding("M3_AMOUNT_MISMATCH", "medium",
+        [
+          `Invoice ${b.invoiceNo} from GSTIN ${b.supplierGstin}: taxable diff ₹${dTaxable}, tax diff ₹${dTax}.`,
+          `Register says taxable=₹${b.taxable}, tax=₹${b.tax}. 2A says taxable=₹${a.taxable}, tax=₹${a.tax}.`,
+        ],
+        { purchaseId: b.id, invoiceNo: b.invoiceNo, deltas: { taxable: dTaxable, tax: dTax } }
+      ));
+    }
+  }
+
+  // M4 — GSTIN mismatch by supplier name
+  const bookBySupplierName = new Map();
+  bookInvoices.forEach(b => bookBySupplierName.set((b.supplierName || "").trim().toUpperCase(), b));
+  for (const a of twoAInvoices) {
+    const b = bookBySupplierName.get((a.supplierName || "").trim().toUpperCase());
+    if (!b || !b.supplierGstin) continue;
+    if (b.supplierGstin.toUpperCase() !== a.supplierGstin.toUpperCase()) {
+      findings.push(finding("M4_GSTIN_MISMATCH_FOR_SAME_SUPPLIER_NAME", "medium",
+        [
+          `Supplier "${a.supplierName}" appears in your vendor master with GSTIN ${b.supplierGstin}, but their GSTR-2A entry uses GSTIN ${a.supplierGstin}.`,
+          `Possible causes: (a) supplier has multiple registrations, (b) master data error, (c) impersonation.`,
+        ],
+        { supplierName: a.supplierName, bookGstin: b.supplierGstin, filedGstin: a.supplierGstin }
+      ));
+    }
+  }
+
+  // M5 — invoice dated in prior period appearing in this period
+  for (const a of twoAInvoices) {
+    const invDate = new Date(a.invoiceDate);
+    if (invDate < start) {
+      findings.push(finding("M5_CROSS_PERIOD_LATE_FILING", "medium",
+        [
+          `Invoice ${a.invoiceNo} from ${a.supplierName} dated ${a.invoiceDate} appeared in GSTR-2A for ${period}.`,
+          `Sec 16(4) time-limit implications — ITC must be claimed by Oct/Nov following FY end.`,
+        ],
+        { invoiceNo: a.invoiceNo, invoiceDate: a.invoiceDate, appearedInPeriod: period }
+      ));
+    }
+  }
+
+  // Summary
+  const summary = { total: findings.length, byMismatch: {}, bySeverity: {}, itcAtRisk: 0 };
+  for (const f of findings) {
+    summary.byMismatch[f.mismatch] = (summary.byMismatch[f.mismatch] ?? 0) + 1;
+    summary.bySeverity[f.severity] = (summary.bySeverity[f.severity] ?? 0) + 1;
+    if (f.mismatch === "M1_IN_REGISTER_NOT_IN_2A") summary.itcAtRisk += Number(f.evidence.taxAtRisk || 0);
+  }
+  summary.itcAtRisk = round2(summary.itcAtRisk);
+
+  console.log(`═════════════════════════════════════════════════════════════`);
+  console.log(`  📊 SUMMARY`);
+  console.log(`     findings   : ${summary.total}`);
+  console.log(`     ITC at risk: ₹${summary.itcAtRisk}`);
+  console.log(`     by mismatch: ${JSON.stringify(summary.byMismatch)}`);
+  console.log(`     by severity: ${JSON.stringify(summary.bySeverity)}`);
+  console.log(`═════════════════════════════════════════════════════════════\n`);
+
+  for (const f of findings.slice(0, 25)) {
+    console.log(`  ▸ [${f.severity.toUpperCase()} ${f.riskScore}] ${f.mismatch}`);
+    f.reasons.forEach(r => console.log(`      • ${r}`));
+    console.log("");
+  }
+
+  if (outFile) {
+    const abs = path.resolve(outFile);
+    await fs.writeFile(abs, JSON.stringify({ shopId, period, recipientGstin, summary, findings }, null, 2));
+    console.log(`  💾 written to ${abs}`);
+  }
+  await db.$disconnect();
+}
+
+main().catch(async (e) => {
+  console.error(e);
+  await db.$disconnect();
+  process.exit(1);
+});
