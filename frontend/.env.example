# Base URL of the deployed backend API (no trailing slash).
# REQUIRED in production — without this the app defaults to http://localhost:3000/api
# which is unreachable from any device other than the machine running the backend.
#
# Example (Render):  VITE_API_BASE_URL=https://kiranaos-backend.onrender.com/api
# Example (Railway): VITE_API_BASE_URL=https://kiranaos-backend.up.railway.app/api
#
# Set this in your Vercel project: Settings → Environment Variables
VITE_API_BASE_URL=https://your-backend-url.example.com/api
