{
    "name": "kirana-os-frontend",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "packageManager": "pnpm@9.15.9",
    "scripts": {
        "dev": "vite --config vite.config.ts --host 0.0.0.0",
        "build": "vite build --configLoader runner --config vite.config.ts",
        "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run --configLoader runner",
        "bundle:check": "node scripts/check-bundle-size.mjs",
        "bundle:kirana": "node scripts/verify-kirana-startup-bundle.mjs",
        "app:check": "node scripts/check-production-app.mjs",
        "i18n:check": "node scripts/check-translation-placeholders.mjs",
        "icons": "node scripts/generate-icons.mjs",
        "catalog:generate": "node scripts/generate-starter-catalog.mjs",
        "security:check": "npm run bundle:check && npm run app:check",
        "prod:check": "npm run typecheck && npm run i18n:check && npm run test && npm run build && npm run security:check",
        "qa:product-packaging": "node scripts/capture-product-packaging-ui.mjs",
        "qa:purchase-receive": "node scripts/capture-purchase-receive-ui.mjs",
        "qa:supplier-settlement": "node scripts/capture-supplier-settlement-ui.mjs",
        "qa:mobile-core-matrix": "node scripts/capture-mobile-core-matrix-v1.mjs",
        "qa:mobile-vertical-matrix": "node scripts/capture-mobile-vertical-matrix-v1.mjs",
        "qa:offline-core-restart": "node scripts/verify-offline-core-restart.mjs"
    },
    "dependencies": {
        "@hookform/resolvers": "^3.10.0",
        "@radix-ui/react-accordion": "^1.2.4",
        "@radix-ui/react-alert-dialog": "^1.1.7",
        "@radix-ui/react-aspect-ratio": "^1.1.3",
        "@radix-ui/react-avatar": "^1.1.4",
        "@radix-ui/react-checkbox": "^1.1.5",
        "@radix-ui/react-collapsible": "^1.1.4",
        "@radix-ui/react-context-menu": "^2.2.7",
        "@radix-ui/react-dialog": "^1.1.7",
        "@radix-ui/react-dropdown-menu": "^2.1.7",
        "@radix-ui/react-hover-card": "^1.1.7",
        "@radix-ui/react-label": "^2.1.3",
        "@radix-ui/react-menubar": "^1.1.7",
        "@radix-ui/react-navigation-menu": "^1.2.6",
        "@radix-ui/react-popover": "^1.1.7",
        "@radix-ui/react-progress": "^1.1.3",
        "@radix-ui/react-radio-group": "^1.2.4",
        "@radix-ui/react-scroll-area": "^1.2.4",
        "@radix-ui/react-select": "^2.1.7",
        "@radix-ui/react-separator": "^1.1.3",
        "@radix-ui/react-slider": "^1.2.4",
        "@radix-ui/react-slot": "^1.2.0",
        "@radix-ui/react-switch": "^1.1.4",
        "@radix-ui/react-tabs": "^1.1.4",
        "@radix-ui/react-toast": "^1.2.7",
        "@radix-ui/react-toggle": "^1.1.3",
        "@radix-ui/react-toggle-group": "^1.1.3",
        "@radix-ui/react-tooltip": "^1.2.0",
        "@tanstack/react-query": "^5.80.6",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^3.6.0",
        "dexie": "^4.4.3",
        "embla-carousel-react": "^8.6.0",
        "input-otp": "^1.4.2",
        "lucide-react": "^0.468.0",
        "next-themes": "^0.4.6",
        "react": "^18.3.1",
        "react-day-picker": "^9.11.1",
        "react-dom": "^18.3.1",
        "react-hook-form": "^7.55.0",
        "react-icons": "^5.4.0",
        "react-resizable-panels": "^2.1.7",
        "recharts": "^2.15.2",
        "sonner": "^2.0.7",
        "tailwind-merge": "^2.5.5",
        "vaul": "^1.1.2",
        "wouter": "^3.3.5",
        "zod": "^3.25.7"
    },
    "devDependencies": {
        "@tailwindcss/typography": "^0.5.15",
        "@tailwindcss/vite": "^4.1.8",
        "@types/node": "^22.15.29",
        "@types/react": "^18.3.23",
        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react": "^4.5.2",
        "axe-core": "4.10.3",
        "sharp": "^0.35.3",
        "tailwindcss": "^4.1.8",
        "terser": "^5.49.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.8.3",
        "vite": "^6.3.5",
        "vitest": "^4.1.8"
    }
}
