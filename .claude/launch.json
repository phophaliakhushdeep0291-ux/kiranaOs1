{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kirana-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "autoPort": true,
      "port": 5173
    },
    {
      "name": "kirana-backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "backend", "run", "dev"],
      "port": 5000
    },
    {
      "name": "kirana-backend-3000",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "backend", "run", "dev"],
      "port": 3000
    }
  ]
}
