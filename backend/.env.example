NODE_ENV=development
PORT=3000
DATABASE_URL="file:./dev.db"
# Production with PgBouncer/pooler: DATABASE_URL points at the POOLED port and
# must include ?pgbouncer=true&connection_limit=10 (Prisma + transaction pooling).
# DIRECT_DATABASE_URL points at the raw Postgres port — used only by migrations.
# Without a pooler, leave it unset: the Docker CMD falls back to DATABASE_URL.
DIRECT_DATABASE_URL=
TEST_DATABASE_URL="file:./prisma/test.db"
POSTGRES_DATABASE_URL="postgresql://kiranaos:kiranaos@localhost:5432/kiranaos?schema=public"
POSTGRES_TEST_DATABASE_URL="postgresql://kiranaos:kiranaos@localhost:5432/kiranaos_test?schema=public"
ALLOW_POSTGRES_TEST_DB=false
REQUIRE_POSTGRES_TEST_DB=false
JWT_SECRET="change-this-super-secret-jwt-key-at-least-32-chars"
JWT_EXPIRES_IN=15m
ALLOWED_ORIGINS=http://localhost:5500,http://localhost:5173
PRODUCT_KNOWLEDGE_USER_AGENT=KiranaOS/1.0 (set-your-support-contact)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_INVOICE_MODEL=gpt-4o-mini
INVOICE_OCR_TIMEOUT_MS=45000
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=1000
STOREFRONT_WRITE_LIMIT_MAX=1000
STOREFRONT_READ_LIMIT_MAX=20000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=100
FRONTEND_APP_URL=http://localhost:5173
# Email verification / password recovery.
# For Gmail, enable 2-step verification on the Google account and use a Gmail app password.
EMAIL_PROVIDER=console
AUTH_EMAIL_FROM=
GMAIL_SMTP_USER=
GMAIL_APP_PASSWORD=
# Google sign-in: OAuth 2.0 Web client id from Google Cloud Console (APIs & Services ->
# Credentials). Same value goes to the frontend as VITE_GOOGLE_CLIENT_ID. Leave empty to
# disable the "Continue with Google" button.
GOOGLE_CLIENT_ID=
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=60
OWNER_PIN_REQUIRED=true
# Failed Owner PIN attempts are persisted in AuditLog, so lockout works across
# backend replicas. The per-shop cap also stops attackers rotating staff users.
OWNER_PIN_MAX_FAILURES=5
OWNER_PIN_SHOP_MAX_FAILURES=10
OWNER_PIN_LOCKOUT_MINUTES=15
LOG_LEVEL=info
ENABLE_DEVICE_LICENSE_SIGNING=true
LICENSE_SIGNING_SECRET="change-this-device-license-secret-at-least-32-chars"
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_DYNAMIC_QR_ENABLED=false
# Generate a dedicated 32-byte value; never reuse JWT/database/provider secrets.
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=
# Counter card terminal. Pine Labs cloud uses the official origin only; the
# adapter appends UploadBilledTransaction/GetCloudBasedTxnStatus/CancelTransaction.
# Keep "simulated" development-only: production refuses to boot with it.
CARD_TERMINAL_PROVIDER=none
CARD_TERMINAL_BASE_URL=
CARD_TERMINAL_API_KEY=
CARD_TERMINAL_MERCHANT_ID=
CARD_TERMINAL_ID=
CARD_TERMINAL_STORE_ID=
# Exact StoreLocation.code assigned to this terminal (for example MAIN).
CARD_TERMINAL_LOCATION_CODE=
CARD_TERMINAL_REQUEST_TIMEOUT_MS=8000
CARD_TERMINAL_CHARGE_TIMEOUT_SECONDS=180
# Server-side subscription coupons. Never calculate discounts only in the frontend.
# Supports percentOff or fixedOffPaise, plus optional plans, billingCycles,
# startsAt and expiresAt restrictions.
SUBSCRIPTION_COUPONS_JSON={"LAUNCH25":{"percentOff":25,"plans":["growth","pro"],"billingCycles":["yearly"],"expiresAt":"2026-12-31T23:59:59.999Z"}}
ALLOW_MANUAL_SUBSCRIPTION_ACTIVATION=false

# Background workers / Redis (Phase 10)
REDIS_URL=
QUEUES_ENABLED=false
# auto: API only when queues are off; API + worker when queues are on.
# Use api/worker only when deploying them as separate services.
PROCESS_ROLE=auto
# Domain-event transport. Use redis only with REDIS_URL; kafka is reserved and
# deliberately rejected in production until an adapter is installed/certified.
EVENT_BUS_PROVIDER=none
WORKER_CONCURRENCY=3
WORKER_INSTANCE_ID=
WORKER_HEARTBEAT_INTERVAL_MS=30000
WORKER_STALE_AFTER_MS=90000
JOB_RETENTION_DAYS=7
BACKUP_RETENTION_DAYS=30
# BullMQ schedules bounded encrypted-artifact expiry cleanup at this interval.
BACKUP_CLEANUP_INTERVAL_HOURS=24
# Required to create shop backup artifacts: base64-encoded 32-byte AES key.
BACKUP_ENCRYPTION_KEY=

# Off-site database backup. Turn this on and the worker takes a pg_dump on a
# schedule, uploads it to STORAGE_PROVIDER, reads it back to verify it, and ages
# out copies past BACKUP_RETENTION_DAYS. Leave it off and there is no automatic
# database-level backup at all — the dump the worker takes stays on a container
# filesystem that does not survive a redeploy.
DATABASE_BACKUP_ENABLED=false
DATABASE_BACKUP_INTERVAL_HOURS=24
# Retention keeps at least this many dumps regardless of age, so a backup job
# that has been failing cannot also delete the last good copy.
DATABASE_BACKUP_MIN_RETAINED=3
# Set by the worker only: delete the local dump once the upload is verified.
# `npm run backup:postgres` and the restore drill both need the file to remain.
DATABASE_BACKUP_DISCARD_LOCAL=false
DAILY_CLOSING_SCHEDULE_HOUR=2
DAILY_CLOSING_TIMEZONE=Asia/Kolkata

# Export storage (Phase 14)
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_FORCE_PATH_STYLE=false
EXPORT_DOWNLOADS_PUBLIC=false
EXPORT_SIGNED_URL_TTL_SECONDS=300
METRICS_ENABLED=true
SMOKE_BASE_URL=http://localhost:3000
SMOKE_EXPECT_WORKER=false
SMOKE_EXPECT_REDIS=false
SMOKE_EXPECT_STORAGE=false

# Phase 16 monitoring/provider validation
METRICS_REQUIRE_TOKEN=false
METRICS_TOKEN=
ERROR_TRACKING_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SMOKE_METRICS_EXPECTED=true
ALLOW_PRODUCTION_SMOKE=false
ALLOW_PRODUCTION_STORAGE_VERIFY=false
ALLOW_PRODUCTION_EXPORT_VERIFY=false
EXPORT_VERIFY_SHOP_ID=
EXPORT_VERIFY_USER_ID=
EXPORT_VERIFY_REPORT_TYPE=daily_closing_csv

# WhatsApp reminder provider (Phase 17)
WHATSAPP_PROVIDER=disabled
WHATSAPP_API_KEY=
WHATSAPP_API_SECRET=
WHATSAPP_SENDER_ID=
# Required for Meta (include Graph API version, e.g. https://graph.facebook.com/v24.0).
# Other providers use their official HTTPS endpoint unless this is set.
WHATSAPP_BASE_URL=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GUPSHUP_APP_NAME=
WHATSAPP_DEFAULT_COUNTRY_CODE=+91
# Public base; provider path is appended (for example /twilio or /meta).
WHATSAPP_WEBHOOK_PUBLIC_URL=
# Meta/Interakt HMAC secret; for Gupshup use it as the redacted callback token.
WHATSAPP_WEBHOOK_SECRET=
# Meta subscription verification token only.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
REMINDER_COOLDOWN_HOURS=6

# Flipkart Seller API. Credentials are process-level secrets and MUST be pinned
# to one KiranaOS shop. Map every Flipkart dispatch location ID to an active,
# exact StoreLocation.code. Unmapped branches and SKUs are never guessed.
FLIPKART_SELLER_API_ENABLED=false
FLIPKART_APP_ID=
FLIPKART_APP_SECRET=
FLIPKART_SHOP_ID=
FLIPKART_LOCATION_MAP_JSON={}
FLIPKART_API_BASE_URL=https://api.flipkart.net
FLIPKART_API_TIMEOUT_MS=20000

# GST compliance. "sandbox" creates visibly non-legal test documents only.
# A certified GSP adapter and credentials are required before legal IRN filing.
GST_PROVIDER=disabled

# Phase 26 operational proof suite
PROOF_BASE_URL=http://localhost:3000
PROOF_REQUIRE_LIVE=false
PROOF_REQUIRE_POSTGRES=false
PROOF_REQUIRE_WORKER=false

# Phase 27 money paise migration guard
ALLOW_MONEY_PAISE_BACKFILL=false

# Phase 28 disaster recovery proof
BACKUP_DIR=./backups
BACKUP_FORMAT=custom
BACKUP_DRY_RUN=false
RESTORE_TEST_DATABASE_URL=
ALLOW_RESTORE_TEST_DB=false
PROOF_REQUIRE_DR=false
DR_CREATE_BACKUP=true
BACKUP_FILE=

# Phase 29 release gate
RELEASE_VERSION=1.0.0
RELEASE_CHANNEL=staging
RELEASE_APPROVED=false
RELEASE_APPROVER=
RELEASE_ROLLBACK_IMAGE=
ALLOW_DESTRUCTIVE_MIGRATION=false

ENABLE_DEV_DEVICE_LIMIT_OVERRIDE=false
DEV_MAX_ACTIVE_DEVICES=0
