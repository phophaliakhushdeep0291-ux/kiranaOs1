// ─────────────────────────────────────────────
// STOCK LEDGER — every stock change is logged
// ─────────────────────────────────────────────
model StockLedger {
  id                      String    @id @default(cuid())
  shopId                  String
  locationId              String?
  productId               String
  productName             String
  // Which packaging this movement belongs to, for "per_pack" products. Without it a
  // per-pack balance cannot be audited or rebuilt from the ledger.
  sellingUnitId           String?
  sellingUnitQty          Float? // movement size in that unit's own counts
  action                  String // sale | purchase | damage | correction | cancel_reversal
  changeBaseQty           Float // positive = stock in, negative = stock out
  oldStockBaseQty         Float
  newStockBaseQty         Float
  purchaseBillAmount      Float     @default(0) // total bill amount if it's a purchase
  purchaseBillAmountPaise BigInt?
  calculatedBuyRate       Float     @default(0) // per rateUnit cost computed from purchase
  calculatedBuyRatePaise  BigInt?
  invoiceNumber           String?
  purchasePaymentStatus   String    @default("paid") // paid | partial | due
  purchasePaymentMode     String?
  purchasePaidAmount      Float     @default(0)
  purchasePaidAmountPaise BigInt?
  purchaseDueAmount       Float     @default(0)
  purchaseDueAmountPaise  BigInt?
  purchaseDueDate         DateTime?
  supplierName            String?
  damageLossValue         Float     @default(0) // cost value of damage, affects P&L
  damageLossValuePaise    BigInt?
  billId                  String?
  clientMovementId        String?
  idempotencyKey          String?
  sourceDeviceId          String?
  sourceType              String?
  sourceId                String?
  // Immutable attribution snapshot. actorUserId is null only for system work;
  // actorName keeps the historical display stable after staff changes.
  actorUserId             String?
  actorName               String?
  note                    String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  shop     Shop           @relation(fields: [shopId], references: [id])
  location StoreLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  product  Product        @relation(fields: [productId], references: [id])
  bill     Bill?          @relation(fields: [billId], references: [id])

  @@unique([shopId, idempotencyKey])
  @@index([shopId, createdAt])
  @@index([shopId, sellingUnitId])
  @@index([shopId, locationId, createdAt])
  @@index([shopId, sourceType, sourceId])
  @@index([shopId, actorUserId, createdAt])
  @@index([productId])
  @@index([shopId, updatedAt, id])
}

// ─────────────────────────────────────────────
// UDHAR LEDGER — every udhar/payment event
// ─────────────────────────────────────────────
model UdharLedger {
  id                 String    @id @default(cuid())
  shopId             String
  locationId         String?
  customerId         String
  customerName       String
  type               String // debit | payment
  amount             Float
  amountPaise        BigInt?
  mode               String // cash | upi | reversal | credit
  billId             String?
  billNo             String?
  clientLedgerId     String?
  idempotencyKey     String?
  sourceDeviceId     String?
  sourceType         String?
  sourceId           String?
  note               String?
  reversedAt         DateTime?
  reversedReason     String?
  reversalOfLedgerId String?
  reversedByUserId   String?
  businessDate       DateTime  @default(now()) // economic event time; preserves offline payment/sale timing
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  shop     Shop           @relation(fields: [shopId], references: [id])
  location StoreLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  customer Customer       @relation(fields: [customerId], references: [id])
  bill     Bill?          @relation(fields: [billId], references: [id])

  @@unique([shopId, idempotencyKey])
  @@index([shopId, customerId, createdAt])
  @@index([shopId, locationId, createdAt])
  @@index([shopId, customerId, businessDate])
  @@index([shopId, locationId, businessDate])
  @@index([shopId, reversalOfLedgerId])
  @@index([shopId, sourceType, sourceId])
  @@index([shopId, updatedAt, id])
}

// ─────────────────────────────────────────────
// TALLY POST — one row per document already pushed into TallyPrime.
//
// Tally's importer is not idempotent: the same envelope sent twice creates the
// vouchers twice, and a shop that double-clicks "Send to Tally" would double a
// month's turnover in its own books. This is the record that makes the second
// send a no-op. It deliberately holds no money — only the identity of what was
// sent — so it can never disagree with the documents it points at.
// ─────────────────────────────────────────────
model TallyPost {
  id            String   @id @default(cuid())
  shopId        String
  documentType  String // sale | sales_return | purchase | purchase_return | receipt | expense
  documentId    String
  voucherNumber String
  remoteId      String
  postedAt      DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, documentType, documentId])
  @@index([shopId, postedAt])
}

// ─────────────────────────────────────────────
// SUPPLIER
// ─────────────────────────────────────────────
model Supplier {
  id        String    @id @default(cuid())
  shopId    String
  name      String
  // Their GSTIN, which is what makes a purchase claimable: it identifies the
  // counterparty on the return, and its first two digits are the supplier's
  // state, which decides whether the tax is central+state or integrated.
  gstin     String?
  mobile    String?
  address   String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  shop             Shop              @relation(fields: [shopId], references: [id])
  purchaseHistory  PurchaseHistory[]
  purchaseOrders   PurchaseOrder[]
  purchaseReceipts PurchaseReceipt[]
  purchaseReturns  PurchaseReturn[]

  @@index([shopId])
  @@index([shopId, deletedAt])
  @@index([shopId, updatedAt, id])
}

// ─────────────────────────────────────────────
// EXPENSE — shop operating expenses (rent, salary, utilities…)
// ─────────────────────────────────────────────
model Expense {
  id                String    @id @default(cuid())
  shopId            String
  locationId        String?
  title             String
  amount            Float     @default(0)
  amountPaise       BigInt?
  idempotencyKey    String?
  clientExpenseId   String?
  sourceDeviceId    String?
  category          String    @default("general")
  paymentMode       String    @default("cash")
  vendor            String?
  status            String    @default("paid")
  recurringInterval String    @default("none")
  nextDueOn         DateTime?
  recordedBy        String?
  recordedByUserId  String? // server-authenticated creator; null only for legacy/system imports
  recordedByRole    String? // immutable role snapshot at creation
  notes             String?
  spentAt           DateTime  @default(now())
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  shop     Shop           @relation(fields: [shopId], references: [id])
  location StoreLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([shopId, idempotencyKey])
  @@unique([shopId, sourceDeviceId, clientExpenseId])
  @@index([shopId])
  @@index([shopId, deletedAt])
  @@index([shopId, spentAt])
  @@index([shopId, locationId, spentAt])
  @@index([shopId, recordedByUserId, spentAt])
  @@index([shopId, updatedAt, id])
}

// ─────────────────────────────────────────────
// OFFER — discounts / coupons applied at billing
// ─────────────────────────────────────────────
model Offer {
  id            String    @id @default(cuid())
  shopId        String
  title         String
  code          String?
  type          String    @default("percentage")
  value         Float     @default(0)
  minBillAmount Float     @default(0)
  maxDiscount   Float     @default(0)
  scope         String    @default("all")
  scopeValue    String?
  validFrom     DateTime?
  validTo       DateTime?
  usageLimit    Int       @default(0)
  usedCount     Int       @default(0)
  discountGiven Float     @default(0)
  active        Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  shop Shop @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@index([shopId, deletedAt])
  @@index([shopId, active])
  @@index([shopId, updatedAt, id])
}

// ─────────────────────────────────────────────
// PURCHASE HISTORY — dealer/supplier price tracking
// ─────────────────────────────────────────────
model PurchaseHistory {
  id                      String    @id @default(cuid())
  shopId                  String
  locationId              String?
  productId               String
  supplierId              String?
  purchaseOrderId         String?
  purchaseOrderItemId     String?
  purchaseReceiptId       String?
  supplierName            String
  qtyBase                 Float // quantity in baseUnit
  pricePerRateUnit        Float // computed: totalCost / (qtyBase / conversionFactor)
  pricePerRateUnitPaise   BigInt?
  totalCost               Float
  totalCostPaise          BigInt?
  billAmount              Float // what was written on the supplier's bill
  billAmountPaise         BigInt?
  invoiceNumber           String?
  purchasePaymentStatus   String    @default("paid") // paid | partial | due
  purchasePaymentMode     String?
  purchasePaidAmount      Float     @default(0)
  purchasePaidAmountPaise BigInt?
  purchaseDueAmount       Float     @default(0)
  purchaseDueAmountPaise  BigInt?
  purchaseDueDate         DateTime?
  note                    String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  shop              Shop               @relation(fields: [shopId], references: [id])
  location          StoreLocation?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  product           Product            @relation(fields: [productId], references: [id])
  supplier          Supplier?          @relation(fields: [supplierId], references: [id])
  purchaseOrder     PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)
  purchaseReceipt   PurchaseReceipt?   @relation(fields: [purchaseReceiptId], references: [id], onDelete: SetNull)

  @@index([shopId, productId, createdAt])
  @@index([shopId, locationId, createdAt])
  @@index([shopId, purchaseOrderId, createdAt])
  @@index([shopId, purchaseReceiptId])
  @@index([shopId, updatedAt, id])
}

model PurchaseOrder {
  id                 String    @id @default(cuid())
  shopId             String
  locationId         String
  supplierId         String?
  orderNumber        String
  supplierName       String
  status             String    @default("draft")
  expectedOn         DateTime?
  expectedTotal      Float     @default(0)
  expectedTotalPaise BigInt?
  vendorReference    String?
  paymentTerms       String?
  deliveryAddress    String?
  termsAndConditions String?
  note               String?
  createdByUserId    String?
  sentAt             DateTime?
  receivedAt         DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  shop     Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  location StoreLocation       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  supplier Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items    PurchaseOrderItem[]
  receipts PurchaseReceipt[]
  history  PurchaseHistory[]

  @@unique([shopId, orderNumber])
  @@index([shopId, locationId, status, createdAt])
  @@index([shopId, supplierId, createdAt])
  @@index([shopId, supplierId, vendorReference])
}

model PurchaseOrderItem {
  id                  String  @id @default(cuid())
  purchaseOrderId     String
  productId           String
  productName         String
  baseUnit            String
  rateUnit            String
  orderedBaseQty      Float
  receivedBaseQty     Float   @default(0)
  expectedRate        Float
  expectedRatePaise   BigInt?
  expectedAmount      Float
  expectedAmountPaise BigInt?

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  receiptItems  PurchaseReceiptItem[]
  history       PurchaseHistory[]

  @@unique([purchaseOrderId, productId])
  @@index([productId])
}

model PurchaseReceipt {
  id                         String    @id @default(cuid())
  shopId                     String
  locationId                 String
  purchaseOrderId            String
  supplierId                 String?
  receiptNumber              String
  supplierInvoiceNumber      String?
  supplierInvoiceAmount      Float?
  supplierInvoiceAmountPaise BigInt?
  // GST contained WITHIN supplierInvoiceAmount, exactly as the supplier's
  // invoice states it. Kept as the tax rather than the taxable value so the
  // goods value stays a residual and can never disagree with the invoice total.
  supplierInvoiceTax         Float     @default(0)
  supplierInvoiceTaxPaise    BigInt?
  expectedGoodsAmount        Float     @default(0)
  expectedGoodsAmountPaise   BigInt?
  priceVarianceAmount        Float     @default(0)
  priceVarianceAmountPaise   BigInt?
  invoiceVarianceAmount      Float?
  invoiceVarianceAmountPaise BigInt?
  matchStatus                String    @default("invoice_pending")
  varianceReason             String?
  varianceApprovedByUserId   String?
  varianceApprovedAt         DateTime?
  idempotencyKey             String?
  totalAmount                Float
  totalAmountPaise           BigInt?
  paidAmount                 Float     @default(0)
  paidAmountPaise            BigInt?
  dueAmount                  Float     @default(0)
  dueAmountPaise             BigInt?
  paymentMode                String?
  dueDate                    DateTime?
  note                       String?
  receivedByUserId           String?
  createdAt                  DateTime  @default(now())

  shop          Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  location      StoreLocation         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  supplier      Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items         PurchaseReceiptItem[]
  history       PurchaseHistory[]
  returns       PurchaseReturn[]

  @@unique([shopId, receiptNumber])
  @@unique([shopId, idempotencyKey])
  @@index([shopId, locationId, createdAt])
  @@index([shopId, purchaseOrderId, createdAt])
  @@index([shopId, matchStatus, createdAt])
}

model PurchaseReceiptItem {
  id                  String  @id @default(cuid())
  receiptId           String
  purchaseOrderItemId String
  productId           String
  quantityBaseQty     Float
  actualRate          Float
  actualRatePaise     BigInt?
  lineAmount          Float
  lineAmountPaise     BigInt?
  stockLedgerId       String?
  purchaseHistoryId   String?

  receipt           PurchaseReceipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem    @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  product           Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventoryLots     InventoryLot[]
  returnItems       PurchaseReturnItem[]

  @@unique([receiptId, purchaseOrderItemId])
  @@index([productId])
}

model PurchaseReturn {
  id                        String    @id @default(cuid())
  shopId                    String
  locationId                String
  supplierId                String?
  purchaseReceiptId         String
  returnNumber              String
  refundMode                String    @default("supplier_credit")
  totalAmount               Float
  totalAmountPaise          BigInt?
  // Input GST being given back with these goods: the returned value's share of
  // the tax on the receipt's invoice. Stored rather than derived at read time so
  // the amount reversed is a fact of the return, not something that shifts if
  // the receipt is reconciled again later.
  taxAmount                 Float     @default(0)
  taxAmountPaise            BigInt?
  supplierCreditAmount      Float     @default(0)
  supplierCreditAmountPaise BigInt?
  refundAmount              Float     @default(0)
  refundAmountPaise         BigInt?
  reason                    String
  supplierReference         String?
  idempotencyKey            String?
  status                    String    @default("active")
  cancelledAt               DateTime?
  cancelledByUserId         String?
  cancellationReason        String?
  createdByUserId           String?
  createdAt                 DateTime  @default(now())

  shop            Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  location        StoreLocation        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  supplier        Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseReceipt PurchaseReceipt      @relation(fields: [purchaseReceiptId], references: [id], onDelete: Restrict)
  items           PurchaseReturnItem[]

  @@unique([shopId, returnNumber])
  @@unique([shopId, idempotencyKey])
  @@index([shopId, locationId, createdAt])
  @@index([shopId, supplierId, createdAt])
  @@index([shopId, purchaseReceiptId, createdAt])
  @@index([shopId, status, createdAt])
}

model PurchaseReturnItem {
  id                    String  @id @default(cuid())
  purchaseReturnId      String
  purchaseReceiptItemId String
  productId             String
  quantityBaseQty       Float
  actualRate            Float
  actualRatePaise       BigInt?
  lineAmount            Float
  lineAmountPaise       BigInt?
  lotAllocationsJson    String  @default("[]")

  purchaseReturn      PurchaseReturn      @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  purchaseReceiptItem PurchaseReceiptItem @relation(fields: [purchaseReceiptItemId], references: [id], onDelete: Restrict)
  product             Product             @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([purchaseReturnId, purchaseReceiptItemId])
  @@index([productId])
}

model InventoryLot {
  id                    String    @id @default(cuid())
  shopId                String
  locationId            String
  productId             String
  purchaseReceiptItemId String?
  sellingUnitId         String?
  producedByRunId       String?
  batchNumber           String
  manufacturedOn        DateTime?
  expiresOn             DateTime
  receivedBaseQty       Float
  availableBaseQty      Float
  costPerRateUnit       Float
  costPerRateUnitPaise  BigInt?
  // The MRP printed on THIS batch's pack, same basis as Product.mrp (the default
  // pack). Null means the batch carries no price of its own and the product MRP
  // applies. Medicine MRP is revised between batches, so the strip in hand and the
  // product record routinely disagree — billing must cap against the strip.
  mrp                   Float?
  mrpPaise              BigInt?
  status                String    @default("active")
  note                  String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  shop                Shop                    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  location            StoreLocation           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  product             Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  purchaseReceiptItem PurchaseReceiptItem?    @relation(fields: [purchaseReceiptItemId], references: [id], onDelete: SetNull)
  allocations         BillItemLotAllocation[]

  @@unique([shopId, locationId, productId, batchNumber, expiresOn])
  @@index([shopId, locationId, status, expiresOn])
  @@index([shopId, productId, expiresOn])
  @@index([shopId, sellingUnitId, status])
  @@index([producedByRunId])
}

model ManufacturingBom {
  id                    String                 @id @default(cuid())
  shopId                String
  finishedProductId     String
  name                  String
  version               Int                    @default(1)
  status                String                 @default("active")
  outputQuantityBaseQty Float
  notes                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  items                 ManufacturingBomItem[]
  runs                  ProductionRun[]

  @@unique([shopId, finishedProductId, version])
  @@index([shopId, status, updatedAt])
}

model ManufacturingBomItem {
  id                String           @id @default(cuid())
  shopId            String
  bomId             String
  materialProductId String
  quantityBaseQty   Float
  wastagePercent    Float            @default(0)
  createdAt         DateTime         @default(now())
  bom               ManufacturingBom @relation(fields: [bomId], references: [id], onDelete: Cascade)

  @@unique([bomId, materialProductId])
  @@index([shopId, materialProductId])
}

model ProductionRun {
  id                   String                  @id @default(cuid())
  shopId               String
  locationId           String
  bomId                String
  runNumber            String
  status               String                  @default("planned")
  plannedOutputBaseQty Float
  actualOutputBaseQty  Float?
  finishedBatchNumber  String?
  manufacturedOn       DateTime?
  expiresOn            DateTime?
  qcStatus             String                  @default("pending")
  notes                String?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  bom                  ManufacturingBom        @relation(fields: [bomId], references: [id], onDelete: Restrict)
  consumptions         ProductionConsumption[]
  outputs              ProductionOutput[]

  @@unique([shopId, runNumber])
  @@index([shopId, status, createdAt])
  @@index([shopId, finishedBatchNumber])
}

model ProductionConsumption {
  id                String        @id @default(cuid())
  shopId            String
  runId             String
  productId         String
  inventoryLotId    String?
  plannedBaseQty    Float
  actualBaseQty     Float
  sourceBatchNumber String?
  createdAt         DateTime      @default(now())
  run               ProductionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([shopId, productId])
  @@index([inventoryLotId])
}

model ProductionOutput {
  id              String        @id @default(cuid())
  shopId          String
  runId           String
  productId       String
  sellingUnitId   String?
  inventoryLotId  String?
  packagingSku    String?
  quantityBaseQty Float
  packageCount    Float?
  batchNumber     String
  createdAt       DateTime      @default(now())
  run             ProductionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([shopId, productId, batchNumber])
  @@index([inventoryLotId])
}

model TradeOrder {
  id                    String           @id @default(cuid())
  shopId                String
  locationId            String
  orderNumber           String
  buyerPoNumber         String?
  customerId            String?
  customerName          String
  customerGstin         String?
  billingAddress        String?
  shippingAddress       String?
  orderType             String           @default("domestic")
  status                String           @default("draft")
  currencyCode          String           @default("INR")
  exchangeRate          Float            @default(1)
  priceBasis            String?
  requestedDeliveryDate DateTime?
  iec                   String?
  lutBondReference      String?
  countryOfDestination  String?
  countryOfOrigin       String?
  portOfLoading         String?
  portOfDischarge       String?
  incoterm              String?
  paymentTerms          String?
  notes                 String?
  billId                String?
  confirmedAt           DateTime?
  allocatedAt           DateTime?
  packedAt              DateTime?
  dispatchedAt          DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  items                 TradeOrderItem[]
  dispatch              TradeDispatch?

  @@unique([shopId, orderNumber])
  @@index([shopId, status, createdAt])
  @@index([shopId, buyerPoNumber])
  @@index([shopId, customerId, createdAt])
}

model TradeOrderItem {
  id               String                 @id @default(cuid())
  shopId           String
  orderId          String
  productId        String
  sellingUnitId    String?
  sku              String?
  buyerProductCode String?
  description      String
  hsn              String?
  quantity         Float
  quantityBaseQty  Float
  unitPrice        Float
  gstRate          Float                  @default(0)
  lineDiscount     Float                  @default(0)
  lineTotal        Float
  packedQuantity   Float                  @default(0)
  createdAt        DateTime               @default(now())
  order            TradeOrder             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  allocations      TradeOrderAllocation[]

  @@index([shopId, productId])
  @@index([orderId])
}

model TradeOrderAllocation {
  id              String         @id @default(cuid())
  shopId          String
  orderItemId     String
  inventoryLotId  String
  batchNumber     String
  quantityBaseQty Float
  createdAt       DateTime       @default(now())
  orderItem       TradeOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([orderItemId, inventoryLotId])
  @@index([shopId, inventoryLotId])
}

model TradeDispatch {
  id                 String     @id @default(cuid())
  shopId             String
  orderId            String     @unique
  dispatchNumber     String
  dispatchDate       DateTime
  transporterName    String?
  transporterGstin   String?
  vehicleNumber      String?
  lrAwbNumber        String?
  ewayBillNumber     String?
  shippingBillNumber String?
  shippingBillDate   DateTime?
  containerNumber    String?
  packageCount       Float?
  netWeight          Float?
  grossWeight        Float?
  sealNumber         String?
  notes              String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  order              TradeOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([shopId, dispatchNumber])
  @@index([shopId, dispatchDate])
}

model BillItemLotAllocation {
  id              String   @id @default(cuid())
  billItemId      String
  inventoryLotId  String
  quantityBaseQty Float
  createdAt       DateTime @default(now())

  billItem     BillItem     @relation(fields: [billItemId], references: [id], onDelete: Cascade)
  inventoryLot InventoryLot @relation(fields: [inventoryLotId], references: [id], onDelete: Restrict)

  @@unique([billItemId, inventoryLotId])
  @@index([inventoryLotId])
}

model UserLocationAccess {
  id                 String   @id @default(cuid())
  shopId             String
  userId             String
  locationId         String
  canSell            Boolean  @default(true)
  canPurchase        Boolean  @default(false)
  canManageInventory Boolean  @default(false)
  canTransfer        Boolean  @default(false)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  shop     Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  location StoreLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
  @@index([shopId, locationId, active])
  @@index([shopId, userId, active])
}

// ─────────────────────────────────────────────
// AI ACTION LOG
// ─────────────────────────────────────────────
model AiActionLog {
  id               String   @id @default(cuid())
  shopId           String
  userId           String?
  transcript       String
  parsedActionJson String // JSON string of the parsed command
  permissionLevel  String // safe | confirm | owner_pin | blocked
  status           String // parsed | executed | rejected | failed
  error            String?
  createdAt        DateTime @default(now())

  shop Shop  @relation(fields: [shopId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@index([shopId, createdAt])
}

// ─────────────────────────────────────────────
// AUDIT LOG — central security/action audit trail
// ─────────────────────────────────────────────
model AuditLog {
  id           String   @id @default(cuid())
  shopId       String
  userId       String?
  deviceId     String?
  module       String? // billing | inventory | auth | sync | devices | settings | ...
  action       String
  entityType   String?
  entityId     String?
  beforeJson   String?
  afterJson    String?
  metadataJson String?
  result       String? // success | failure
  durationMs   Int?
  ipAddress    String?
  userAgent    String?
