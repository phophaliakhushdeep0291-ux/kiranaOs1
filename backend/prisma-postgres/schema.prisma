// ─────────────────────────────────────────────
// FINANCIAL ASSURANCE ENGINE — continuous financial-control monitoring.
// These tables store findings, evidence and review trails ABOUT canonical
// transactions; they are strictly read-only toward financial truth and are
// never a source for balances, stock or reports. Findings are never deleted;
// status history rows are append-only. See docs/AI_AUDIT_ARCHITECTURE.md.
// ─────────────────────────────────────────────
model AuditRule {
  id              String   @id @default(cuid())
  shopId          String
  ruleCode        String
  enabled         Boolean  @default(true)
  weightOverride  Int?
  thresholdsJson  String   @default("{}")
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, ruleCode])
  @@index([shopId, enabled])
}

model AuditRun {
  id                String    @id @default(cuid())
  shopId            String
  runType           String // TRANSACTION_TRIGGERED | SCHEDULED | MANUAL
  status            String    @default("RUNNING") // RUNNING | COMPLETED | FAILED | PARTIAL
  engineVersion     String
  rulesetVersion    String
  scopeJson         String    @default("{}")
  periodFrom        DateTime?
  periodTo          DateTime?
  entitiesEvaluated Int       @default(0)
  findingsCreated   Int       @default(0)
  findingsUpdated   Int       @default(0)
  summaryJson       String    @default("{}")
  error             String?
  triggeredByUserId String?
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  shop        Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  evaluations AuditEvaluation[]

  @@index([shopId, createdAt])
  @@index([shopId, status, createdAt])
  @@index([shopId, runType, createdAt])
}

// Immutable record of one deterministic evaluation of one entity: the input
// snapshot hash plus the full result JSON make every risk score reproducible
// even after the underlying transaction is later edited.
model AuditEvaluation {
  id                     String   @id @default(cuid())
  shopId                 String
  auditRunId             String
  sourceEntityType       String
  sourceEntityId         String
  inputHash              String
  engineVersion          String
  rulesetVersion         String
  triggeredRuleCodesJson String   @default("[]")
  riskScore              Int      @default(0)
  resultJson             String   @default("{}")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  shop Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  run  AuditRun @relation(fields: [auditRunId], references: [id], onDelete: Cascade)

  @@unique([auditRunId, sourceEntityType, sourceEntityId])
  @@index([shopId, sourceEntityType, sourceEntityId, createdAt])
  @@index([shopId, createdAt])
}

model AuditFinding {
  id                 String    @id @default(cuid())
  shopId             String
  dedupeKey          String // `${sourceEntityType}:${sourceEntityId}` — one finding per entity
  sourceEntityType   String
  sourceEntityId     String
  sourceEventType    String?
  firstAuditRunId    String?
  lastAuditRunId     String?
  lastEvaluationId   String?
  title              String
  status             String    @default("OPEN") // OPEN | EVIDENCE_REQUESTED | UNDER_REVIEW | CONFIRMED_ISSUE | FALSE_POSITIVE | CORRECTED | ACCEPTED_RISK | CLOSED
  primaryCategory    String?
  riskScore          Int       @default(0)
  riskLevel          String    @default("LOW") // LOW | MEDIUM | HIGH | CRITICAL
  confidence         Float     @default(1)
  // amountPaise = size of the record involved (drives materiality banding).
  // discrepancyPaise = the money actually in question (the shortfall, drift or
  // difference a rule measured). Dashboards and reports must total the second:
  // summing record sizes across entity types double-counts the same rupee and
  // mixes inventory valuation with cash. Null = no rule quantified a gap.
  amountPaise        BigInt?
  discrepancyPaise   BigInt?
  scoreBreakdownJson String    @default("{}")
  aiExplanation      String?
  aiExplanationLang  String?
  assignedReviewerId String?
  occurredAt         DateTime?
  resolvedAt         DateTime?
  resolutionType     String?
  reopenCount        Int       @default(0)
  engineVersion      String
  rulesetVersion     String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  shop                 Shop                        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  rules                AuditFindingRule[]
  evidence             AuditEvidence[]
  evidenceRequirements AuditEvidenceRequirement[]
  statusHistory        AuditFindingStatusHistory[]
  reviews              AuditReview[]
  caseLinks            AuditCaseFinding[]

  @@unique([shopId, dedupeKey])
  @@index([shopId, status, createdAt])
  @@index([shopId, riskLevel, status])
  @@index([shopId, sourceEntityType, sourceEntityId])
  @@index([shopId, assignedReviewerId, status])
  @@index([shopId, createdAt])
}

model AuditFindingRule {
  id                String   @id @default(cuid())
  shopId            String
  findingId         String
  ruleCode          String
  ruleVersion       Int
  category          String
  severity          String
  scoreContribution Int
  detailsJson       String   @default("{}")
  active            Boolean  @default(true) // still triggering as of the last evaluation
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  shop    Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  finding AuditFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@unique([findingId, ruleCode])
  @@index([shopId, ruleCode, createdAt])
}

model AuditEvidenceRequirement {
  id                String    @id @default(cuid())
  shopId            String
  findingId         String
  evidenceType      String
  description       String
  status            String    @default("REQUESTED") // REQUESTED | PROVIDED | VERIFIED | REJECTED | INSUFFICIENT | NOT_APPLICABLE
  requestedByUserId String?
  dueAt             DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  shop     Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  finding  AuditFinding    @relation(fields: [findingId], references: [id], onDelete: Cascade)
  evidence AuditEvidence[]

  @@index([shopId, status, createdAt])
  @@index([findingId])
}

model AuditEvidence {
  id                    String    @id @default(cuid())
  shopId                String
  findingId             String
  requirementId         String?
  evidenceType          String
  referenceKind         String    @default("text") // text | reference | url | file | transaction_ref
  referenceValue        String
  originalFilename      String?
  mimeType              String?
  sizeBytes             Int?
  checksumSha256        String?
  storageKey            String?
  uploadedByUserId      String?
  verificationStatus    String    @default("PROVIDED") // PROVIDED | VERIFIED | REJECTED | INSUFFICIENT | NOT_APPLICABLE
  verifiedByUserId      String?
  verifiedAt            DateTime?
  extractedMetadataJson String    @default("{}")
  reviewerNotes         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  shop        Shop                      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  finding     AuditFinding              @relation(fields: [findingId], references: [id], onDelete: Cascade)
  requirement AuditEvidenceRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  @@index([shopId, findingId, createdAt])
  @@index([shopId, verificationStatus, createdAt])
}

// Append-only: rows are created on every finding status transition and never
// updated or deleted. updatedAt exists for model-shape consistency only.
model AuditFindingStatusHistory {
  id              String   @id @default(cuid())
  shopId          String
  findingId       String
  previousStatus  String?
  newStatus       String
  changedByUserId String?
  changedByRole   String?
  comment         String?
  evidenceId      String?
  approvalLevel   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shop    Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  finding AuditFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([shopId, findingId, createdAt])
  @@index([shopId, createdAt])
}

model AuditReview {
  id             String   @id @default(cuid())
  shopId         String
  findingId      String
  reviewerUserId String?
  reviewerRole   String?
  decision       String // CONFIRMED_ISSUE | FALSE_POSITIVE | ACCEPTED_RISK | CORRECTED | NEEDS_MORE_EVIDENCE
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shop    Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  finding AuditFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([shopId, findingId, createdAt])
}

model AuditCase {
  id              String    @id @default(cuid())
  shopId          String
  title           String
  summary         String?
  status          String    @default("OPEN") // OPEN | UNDER_REVIEW | CLOSED
  riskLevel       String    @default("LOW")
  createdByUserId String?
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shop     Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  findings AuditCaseFinding[]

  @@index([shopId, status, createdAt])
}

model AuditCaseFinding {
  id        String   @id @default(cuid())
  shopId    String
  caseId    String
  findingId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop    Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  case    AuditCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  finding AuditFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@unique([caseId, findingId])
  @@index([shopId, findingId])
}

// Shop-specific behavioral baselines from robust statistics. INSUFFICIENT_DATA
// baselines must never contribute to a risk score.
model AuditBaseline {
  id             String   @id @default(cuid())
  shopId         String
  metricKey      String
  scopeKey       String   @default("global")
  windowDays     Int      @default(90)
  sampleCount    Int      @default(0)
  minimumSamples Int      @default(30)
  status         String   @default("INSUFFICIENT_DATA") // OK | INSUFFICIENT_DATA
  median         Float?
  p25            Float?
  p75            Float?
  p90            Float?
  p99            Float?
  mean           Float?
  statsJson      String   @default("{}")
  computedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, metricKey, scopeKey])
  @@index([shopId, computedAt])
}

// ─────────────────────────────────────────────
// USER ACTIVITY & PERSONALIZATION (§13)
//
// ActivityEvent is the append-only fact table: one row per meaningful user
// action, in the POS or in an online customer session. It is behavioural
// telemetry and never a financial record — nothing here is authoritative for
// money, stock or tax, and losing a row must not change a business outcome.
//
// ActivityAggregate is the read model. Recomputing "the 10 products this user
// bills most" from millions of raw events on every keystroke is not viable on a
// counter PC, so ingest folds each event into a small set of counters that the
// personalization endpoints read directly.
// ─────────────────────────────────────────────
model ActivityEvent {
  id            String   @id @default(cuid())
  // Client-generated id, unique so a retried offline batch cannot double-count.
  eventId       String   @unique
  shopId        String
  userId        String?
  orgId         String?
  deviceId      String?
  sessionId     String?
  eventType     String
  module        String   @default("other")
  screen        String?
  appVersion    String?
  networkStatus String? // online | offline
  source        String   @default("pos") // pos | online | server
  durationMs    Int?
  // Sanitized, size-capped event-specific fields (query, results, productId, …).
  metadataJson  String   @default("{}")
  // When it happened on the device. Distinct from createdAt (ingest time)
  // because an offline device can deliver the same batch hours later.
  occurredAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, occurredAt])
  @@index([shopId, eventType, occurredAt])
  @@index([shopId, userId, occurredAt])
  @@index([shopId, sessionId])
}

model ActivityAggregate {
  id     String  @id @default(cuid())
  shopId String
  // The owning user, or the sentinel "*" for a shop-wide rollup (trending
  // products, shop feature adoption). A sentinel rather than NULL because both
  // SQLite and Postgres treat NULLs as distinct in a unique index, which would
  // silently let every shop-wide upsert insert a duplicate row instead of
  // incrementing the existing one.
  userId String  @default("*")
  // product_billed | product_searched | search_query | report | customer |
  // payment_method | filter | page | online_product_view | feature | task_time
  kind   String
  key    String // the thing being counted (productId, report slug, query text…)
  label  String? // display text captured at write time, so reads need no join

  count           Int   @default(0)
  // Half-life decayed score. Raw counts let a product billed 500 times last year
  // outrank one billed 30 times this week; the decay keeps suggestions current.
  score           Float @default(0)
  // Summed duration, for "which tasks consume the most time" and the averages.
  totalMs         Int   @default(0)
  durationSamples Int   @default(0)

  metaJson    String   @default("{}")
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId, kind, key])
  @@index([shopId, kind, score])
  @@index([shopId, userId, kind, lastSeenAt])
}

// ─────────────────────────────────────────────
// CLOTH RENTAL — a garment booked out for a run of days.
// A booking holds stock without moving it; availability for a window is the
// owned count minus the qty held by active bookings overlapping that window.
// Dates are day-granular shop-timezone boundaries (see utils/dates.js).

model RentalBooking {
  id            String @id @default(cuid())
  shopId        String
  bookingNumber String

  customerId      String?
  customerName    String
  customerPhone   String
  customerAddress String  @default("")
  idProofType     String?
  idProofNumber   String?

  fromDate   DateTime
  toDate     DateTime
  returnedAt DateTime?
  status     String    @default("booked") // booked | picked_up | returned | cancelled

  rentAmount    Float @default(0)
  depositAmount Float @default(0)
  advancePaid   Float @default(0)
  lateFee       Float @default(0)
  damageCharge  Float @default(0)

  notes           String?
  createdByUserId String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shop  Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items RentalBookingItem[]

  @@unique([shopId, bookingNumber])
  @@index([shopId, deletedAt])
  @@index([shopId, status, fromDate, toDate])
  @@index([shopId, status, toDate])
  @@index([shopId, customerPhone])
}

model RentalBookingItem {
  id        String  @id @default(cuid())
  bookingId String
  // Deliberately not a foreign key — the line records what physically went out
  // and must outlive the product row.
  productId String?

  name       String
  unit       String @default("piece")
  qty        Float  @default(1)
  ratePerDay Float  @default(0)
  amount     Float  @default(0)

  booking RentalBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([productId])
}

// The statutory register a chemist produces on inspection: who prescribed it,
// for whom, what was actually dispensed, and against which bill. Online-first —
// written once at the counter, so it is not mirrored to devices.

model Prescription {
  id             String @id @default(cuid())
  shopId         String
  registerNumber String

  doctorName   String
  doctorRegNo  String?
  doctorClinic String?

  // The patient is captured here, not only through a Customer row: most are
  // one-off walk-ins, and the register must outlive any linked customer edit.
  customerId     String?
  patientName    String
  patientPhone   String  @default("")
  patientAge     String? // free text — paediatric entries read "6 months"
  patientGender  String? // male | female | other
  patientAddress String  @default("")

  scheduleType String    @default("h") // h | h1 | x | otc | other
  prescribedOn DateTime
  dispensedAt  DateTime?
  status       String    @default("pending") // pending | dispensed | cancelled

  // Not foreign keys — the register entry is the legal record and survives the
  // bill being cancelled or purged.
  billId     String?
  billNumber String?

  refillsAllowed Int @default(0)
  refillsUsed    Int @default(0)

  imageUrl        String?
  notes           String?
  createdByUserId String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shop  Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items PrescriptionItem[]

  @@unique([shopId, registerNumber])
  @@index([shopId, deletedAt])
  @@index([shopId, prescribedOn])
  @@index([shopId, status, prescribedOn])
  @@index([shopId, scheduleType, prescribedOn])
  @@index([shopId, patientPhone])
  @@index([shopId, billId])
}

model PrescriptionItem {
  id             String  @id @default(cuid())
  prescriptionId String
  // Deliberately not a foreign key — the line records what was physically
  // dispensed and must outlive the product row.
  productId      String?

  name           String
  strength       String?
  dosage         String?
  qty            Float   @default(1)
  unit           String  @default("strip")
  batchNumber    String?
  substitutedFor String?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@index([productId])
}

// Serialised electronics stock: the shop sells THAT handset, and a return or
// warranty claim has to find the same physical unit again. Online-first —
// written when the box is opened, read by lookup, not mirrored to devices.

model ProductUnit {
  id     String @id @default(cuid())
  shopId String

  // Not a foreign key, and the name is copied — the unit records a physical
  // thing that left the shop and must outlive the catalogue row.
  productId   String
  productName String

  // At least one identifier is required; a unit nobody can identify is just stock.
  imei         String?
  imei2        String?
  serialNumber String?

  status    String @default("in_stock") // in_stock | sold | returned | rma | lost | scrapped
  condition String @default("new") // new | open_box | refurbished

  purchaseBillId String?
  supplierId     String?
  costPrice      Float    @default(0)
  receivedAt     DateTime @default(now())

  billId        String?
  billNumber    String?
  customerId    String?
  customerName  String?
  customerPhone String    @default("")
  soldAt        DateTime?
  sellingPrice  Float     @default(0)

  // An absolute end date, not only a duration: shop policy can change, this
  // unit's cover cannot.
  warrantyMonths Int       @default(0)
  warrantyUntil  DateTime?

  notes           String?
  createdByUserId String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // NULLs are distinct, so units without an IMEI do not collide with each other.
  @@unique([shopId, imei])
  @@unique([shopId, serialNumber])
  @@index([shopId, imei2])
  @@index([shopId, status])
  @@index([shopId, productId, status])
  @@index([shopId, billId])
  @@index([shopId, customerPhone])
  @@index([shopId, warrantyUntil])
}

// Auto parts: "does this fit?" is the trade's whole question, and nothing in the
// shared catalogue can answer it. A fitment is a claim that one product fits one
// vehicle over a range of years; a part has many, and a vehicle takes many parts.

model PartFitment {
  id     String @id @default(cuid())
  shopId String

  // Not a foreign key, and the name is copied — the claim is reference data the
  // shop built up and must survive a product being renamed or replaced.
  productId   String
  productName String

  make    String
  model   String
  variant String? // null means every variant

  // Open-ended: yearFrom null = "since forever", yearTo null = "still current".
  yearFrom Int?
  yearTo   Int?

  notes     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, make, model])
  @@index([shopId, productId])
  @@index([shopId, make])
}

// What else will do when the wanted part is not on the shelf. The other side may
// be a stocked product or just a number the shop knows about.
model PartCrossReference {
  id     String @id @default(cuid())
  shopId String

  productId   String
  productName String

  alternateProductId String?
  partNumber         String
  brand              String?
  // oem | alternative | supersedes | superseded_by
  kind               String  @default("alternative")

  notes     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, productId])
  @@index([shopId, partNumber])
}

// Which size system a footwear style is sold in. The size run itself is ordinary
// variant machinery (a Size axis, one selling unit per size); what cannot be
// derived is whether "8" means UK, EU or US, and that is all this records.

model FootwearSizeProfile {
  id     String @id @default(cuid())
  shopId String

  // Not a foreign key, and the name is copied — consistent with the other trade
  // registers, so the profile survives a catalogue row being renamed.
  productId   String
  productName String

  sizeSystem String  @default("uk") // uk | us | eu | cm (India uses UK numbering)
  gender     String  @default("unisex") // mens | womens | kids | unisex
  widthFit   String?

  notes     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, productId])
  @@index([shopId, deletedAt])
}

// Class book lists: "Class 6, DPS" -> eleven books, four notebooks and a
// geometry box. A list is a recipe, not stock and not an order — readiness is
// computed against the live catalogue every time it is read.

model BookList {
  id     String @id @default(cuid())
  shopId String

  schoolName   String
  className    String
  academicYear String // "2026-27" — Indian academic years straddle two calendar years
  // Empty rather than null: NULLs are DISTINCT in a unique index, so a
  // nullable column would let the same class be entered twice.
  name         String @default("")

  notes    String?
  isActive Boolean @default(true)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  shop  Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items BookListItem[]

  @@unique([shopId, schoolName, className, academicYear, name])
  @@index([shopId, deletedAt])
  @@index([shopId, schoolName, className])
  @@index([shopId, academicYear])
}

model BookListItem {
  id     String @id @default(cuid())
  listId String

  // Not a foreign key, and the name is copied — the list keeps naming the book
  // even after the shop stops stocking it, and a null productId is how
  // "we don't carry this" is recorded.
  productId String?
  name      String

  qty        Float   @default(1)
  unit       String  @default("piece")
  isOptional Boolean @default(false)

  notes     String?
  sortOrder Int     @default(0)

  list BookList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId])
  @@index([productId])
}

// The furniture sales order: the trade where the sale happens before the goods
// leave the floor. Quote, advance, made-to-order, reserve, deliver, install —
// for that whole stretch the money and the goods are in different places, which
// a bill cannot express. The order is NOT a bill; it settles nothing and links
// to the bill raised when the goods finally go out.

model FurnitureOrder {
  id          String @id @default(cuid())
  shopId      String
  orderNumber String

  // Captured on the order itself: a showroom sale is often a one-off, and the
  // delivery address must keep saying where THIS wardrobe went.
  customerId      String?
  customerName    String
  customerPhone   String  @default("")
  deliveryAddress String  @default("")

  // quote | confirmed | in_production | ready | delivered | installed | cancelled
  status String @default("quote")

  // grandTotal is computed server-side so a client cannot disagree with the
  // arithmetic it will later be billed on.
  itemsTotal     Float @default(0)
  discount       Float @default(0)
  deliveryCharge Float @default(0)
  installCharge  Float @default(0)
  grandTotal     Float @default(0)

  quotedOn    DateTime
  promisedOn  DateTime? // what the customer was told
  deliveredAt DateTime?
  installedAt DateTime?

  isCustom Boolean @default(false)

  // Not a foreign key: the order records the promise and outlives a cancelled bill.
  billId     String?
  billNumber String?

  notes           String?
  createdByUserId String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shop     Shop                    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items    FurnitureOrderItem[]
  payments FurnitureOrderPayment[]

  @@unique([shopId, orderNumber])
  @@index([shopId, deletedAt])
  @@index([shopId, status, promisedOn])
  @@index([shopId, customerPhone])
  @@index([shopId, quotedOn])
}

model FurnitureOrderItem {
  id      String @id @default(cuid())
  orderId String

  // Null for a made-to-order piece not in the catalogue, which is most of what
  // this trade sells to order.
  productId String?
  name      String
  variant   String? // "Teak, 6ft, walnut finish"

  qty    Float @default(1)
  rate   Float @default(0)
  amount Float @default(0)

  // Whether this line holds a piece off the floor while the order is open.
  reserveStock Boolean @default(true)

  notes String?

  order FurnitureOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

// Advances against an order. Several are normal, so this is a child table rather
// than one column that could only ever hold the last one.
model FurnitureOrderPayment {
  id      String @id @default(cuid())
  orderId String

  amount    Float    @default(0)
  mode      String   @default("cash")
  paidOn    DateTime
  reference String?
  notes     String?

  createdByUserId String?
  createdAt       DateTime @default(now())

  order FurnitureOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// Tester stock: a unit opened for customers to try, which will never be sold.
// Counted as sellable it makes the shelf wrong, surfaces later as shrinkage that
// looks like theft, and hides what testers cost. Opening one moves stock out
// through the ordinary inventory path; this records where it went.

model TesterUnit {
  id     String @id @default(cuid())
  shopId String

  // Not a foreign key, and the name is copied — the record survives a catalogue
  // row being renamed.
  productId   String
  productName String
  // The shade: a tester is opened per shade, not per product.
  variant     String?

  status       String    @default("in_use") // in_use | replaced | discarded
  openedOn     DateTime
  expectedDays Int       @default(90)
  closedOn     DateTime?

  // Snapshotted at opening: a later price change must not rewrite last
  // quarter's tester cost.
  costValue Float @default(0)

  // The stock movement this tester came out of, when one was made.
  stockLedgerId String?

  notes           String?
  createdByUserId String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, deletedAt])
  @@index([shopId, status, openedOn])
  @@index([shopId, productId, status])
}

// ─────────────────────────────────────────────
// RESTAURANT — the floor and the recipe book
// See the SQLite twin for the full rationale.
// ─────────────────────────────────────────────

// A table on the restaurant floor. The floor plan used to live only in the
// till's own IndexedDB, which was fine while the only reader was the till. A QR
// code stuck to table 5 is read by a stranger's phone, and that phone talks to
// the server — which knew nothing about table 5. `code` is what the QR carries;
// it is short and human-checkable, and deliberately not a secret, because it
// names a piece of furniture in a public room. What protects the shop is that a
// guest can only add to their own table's order — never see a bill or a total.
model RestaurantTable {
  id         String  @id @default(cuid())
  shopId     String
  locationId String?

  code    String // printed on the QR sticker: "t5", "terrace-2"
  name    String
  section String @default("Dining")
  seats   Int    @default(4)

  selfOrderEnabled Boolean @default(true)
  active           Boolean @default(true)
  sortOrder        Int     @default(0)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  reservations TableReservation[]
  location     StoreLocation?     @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([shopId, code])
  @@index([shopId, deletedAt])
  @@index([shopId, section, sortOrder])
  @@index([shopId, locationId, active])
}

// One ingredient of one dish — the line that turns "we sold 4 butter chickens"
// into "we are down 600 g of butter". Without it a restaurant's stock figures
// are fiction: the POS decrements the dish, and nobody buys or stores a dish.
//
// qtyBase is per ONE portion, in the ingredient's own base unit, so depletion is
// a subtraction with no conversion to get wrong. Neither product id is a foreign
// key, consistent with the other trade registers. Rows are deleted outright: a
// recipe line is configuration, and a soft-deleted one would sit inside the
// unique index and silently refuse to let the cook add the ingredient back.
// A table booked ahead of service. The floor is the scarce resource, so the one
// rule that matters is that two parties are never promised the same table at the
// same time — enforced in the service against the interval, because a unique index
// cannot express "overlaps".
//
// tableId is nullable on purpose: a booking taken over the phone often has a time
// and a party size before anyone decides which table it sits at, and refusing to
// record it until a table is chosen would push the host back to paper.
model TableReservation {
  id              String    @id @default(cuid())
  shopId          String
  locationId      String?
  tableId         String?
  guestName       String
  guestPhone      String?
  partySize       Int       @default(2)
  reservedFor     DateTime
  durationMinutes Int       @default(90)
  // booked -> seated -> completed, or cancelled / no_show. Only the open statuses
  // hold a table, so a cancelled booking frees the slot immediately.
  status          String    @default("booked")
  source          String    @default("phone")
  note            String?
  seatedAt        DateTime?
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shop     Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  location StoreLocation?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  table    RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([shopId, reservedFor])
  @@index([shopId, status, reservedFor])
  @@index([shopId, tableId, reservedFor])
  @@index([shopId, updatedAt, id])
}

// Who is rostered on, and when. Kept deliberately thin: this is the schedule the
// manager publishes, not a timeclock — hours actually worked are a separate
// question and inventing them from a roster would be fiction.
//
// Overlapping shifts for one person are refused for the same reason two parties
// cannot hold one table: the schedule is only useful if it cannot say someone is
// in two places at once.
model StaffShift {
  id         String   @id @default(cuid())
  shopId     String
  locationId String?
  userId     String
  startsAt   DateTime
  endsAt     DateTime
  position   String?
  status     String   @default("scheduled")
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  shop     Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  location StoreLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shopId, startsAt])
  @@index([shopId, userId, startsAt])
  @@index([shopId, updatedAt, id])
}

// A self-order terminal standing in the shop. It is the same storefront the table
// QR already serves, minus the table: the guest orders against the terminal and
// carries an order number away, so nothing about the menu, stock or order path is
// duplicated for it.
model KioskTerminal {
  id            String    @id @default(cuid())
  shopId        String
  locationId    String?
  code          String
  name          String
  active        Boolean   @default(true)
  requirePrepay Boolean   @default(false)
  lastSeenAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  shop     Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  location StoreLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([shopId, code])
  @@index([shopId, active])
  @@index([shopId, updatedAt, id])
}

model DishRecipeComponent {
  id     String @id @default(cuid())
  shopId String

  dishProductId       String
  ingredientProductId String
  ingredientName      String

  qtyBase    Float   @default(0)
  wastagePct Float   @default(0)
  optional   Boolean @default(false)
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, dishProductId, ingredientProductId])
  @@index([shopId, dishProductId])
  @@index([shopId, ingredientProductId])
}

// A kitchen ticket (KOT) — what the pass is actually working off.
//
// This lives on the server rather than on the till because the kitchen display
// is a DIFFERENT DEVICE from the counter that fires it. Held device-locally, a
// ticket never reached the screen it was written for.
//
// tableId and billId are deliberately NOT foreign keys. A table's order is the
// parked HeldBill on the till taking it, whose id is local to that device; the
// server only groups by it. That also lets a ticket outlive the sitting it came
// from, which is what a kitchen record is for.
model KitchenTicket {
  id         String  @id @default(cuid())
  shopId     String
  locationId String?

  // Per-shop, server-assigned. The till cannot number these: two devices firing
  // at the same moment would both read the same highest number and pick it.
  ticketNo Int

  tableId   String
  tableName String
  // The sitting this belongs to, so a re-seated table starts owing the kitchen
  // everything on the new order rather than inheriting the last party's tally.
  billId    String

  // new | preparing | ready | served
  status    String    @default("new")
  // KotLine[]: { key, name, qty, unit, note }. A fired snapshot — never queried
  // line by line, so it is one column rather than a child table.
  linesJson String    @default("[]")
  firedAt   DateTime  @default(now())
  servedAt  DateTime?

  // Durable create idempotency: a retried fire must not put the dish on twice.
  // Nullable, and NULLs are DISTINCT in a unique index, so tickets without a
  // key never collide with each other.
  idempotencyKey String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  shop     Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  location StoreLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([shopId, idempotencyKey])
  @@unique([shopId, ticketNo])
  @@index([shopId, deletedAt, firedAt])
  @@index([shopId, status, firedAt])
  @@index([shopId, billId])
}

// ─────────────────────────────────────────────
// MENU ADD-ONS — "extra cheese", "no onion", "choose your bread"
// ─────────────────────────────────────────────
// A group is defined ONCE per shop and attached to as many dishes as serve it.
// Petpooja-style per-dish add-on lists mean editing the price of extra cheese in
// forty places; here the paneer tikka and the paneer roll share one group, and a
// price rise is one edit.
//
// What a group carries is the RULE, not just the list: how many options a guest
// must pick (minSelect 1 = "choose your bread" is compulsory) and how many they
// may (maxSelect). Those two numbers are what stop a kitchen receiving an order
// for a burger with no bun or with four.
model MenuAddonGroup {
  id        String    @id @default(cuid())
  shopId    String
  name      String
  // 0 = optional. 1 or more = the guest must choose that many before the line
  // can be added, which is how a compulsory choice is expressed.
  minSelect Int       @default(0)
  // 0 = no ceiling. Anything else caps the picks.
  maxSelect Int       @default(0)
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  shop    Shop                @relation(fields: [shopId], references: [id])
  options MenuAddonOption[]
  dishes  ProductAddonGroup[]

  @@unique([shopId, name])
  @@index([shopId, isActive, sortOrder])
}

model MenuAddonOption {
  id              String  @id @default(cuid())
  shopId          String
  groupId         String
  name            String
  // May be zero, and often is: "no onion" and "less spicy" are instructions the
  // kitchen needs and the guest is not charged for.
  priceDelta      Float   @default(0)
  priceDeltaPaise BigInt?
  // The stock item this actually consumes, when it consumes one. Null means a
  // cooking instruction rather than an ingredient, so nothing is deducted.
  linkedProductId String?
  linkedQtyBase   Float   @default(1)
  sortOrder       Int     @default(0)
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop           Shop            @relation(fields: [shopId], references: [id])
  group          MenuAddonGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  billItemAddons BillItemAddon[]

  @@unique([shopId, groupId, name])
  @@index([shopId, groupId, isActive])
}

/// Which dishes offer which group. The join is what makes a group reusable.
model ProductAddonGroup {
  id        String @id @default(cuid())
  shopId    String
  productId String
  groupId   String
  sortOrder Int    @default(0)

  shop    Shop           @relation(fields: [shopId], references: [id])
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  group   MenuAddonGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([productId, groupId])
  @@index([shopId, productId])
}

/// What was actually chosen on one sold line, snapshotted.
///
/// Every descriptive field is copied rather than joined, for the same reason a
/// bill item copies the product name: a receipt reprinted next year must read
/// what was sold at the price it was sold for, not what the option is called and
/// costs today. optionId is nullable so retiring an option never orphans a bill.
model BillItemAddon {
  id         String  @id @default(cuid())
  billItemId String
  optionId   String?
  groupName  String
  name       String
  price      Float   @default(0)
  pricePaise BigInt?
  quantity   Float   @default(1)

  createdAt DateTime @default(now())

  billItem BillItem         @relation(fields: [billItemId], references: [id], onDelete: Cascade)
  option   MenuAddonOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@index([billItemId])
  @@index([optionId])
}

// Provider-neutral order and payout reconciliation. Importers map their own
// CSV headers onto these canonical fields; no proprietary format is guessed.
model ChannelSettlementImport {
  id                 String    @id @default(cuid())
  shopId             String
  locationId         String?
  provider           String
  fileName           String
  fileHash           String
  mappingJson        String
  periodFrom         DateTime?
  periodTo           DateTime?
  rowCount           Int       @default(0)
  grossPaise         BigInt    @default(0)
  calculatedNetPaise BigInt    @default(0)
  paidNetPaise       BigInt    @default(0)
  variancePaise      BigInt    @default(0)
  status             String    @default("processed")
  importedByUserId   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  shop     Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  location StoreLocation?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  rows     ChannelSettlementRow[]

  @@unique([shopId, provider, fileHash])
  @@index([shopId, createdAt])
  @@index([shopId, locationId, createdAt])
  @@index([shopId, provider, createdAt])
}

model ChannelSettlementRow {
  id                         String    @id @default(cuid())
  importId                   String
  shopId                     String
  locationId                 String?
  provider                   String
  rowNumber                  Int
  rowFingerprint             String
  externalOrderId            String
  orderDate                  DateTime
  channelStatus              String?
  currency                   String    @default("INR")
  grossPaise                 BigInt
  merchantDiscountPaise      BigInt    @default(0)
  platformCommissionPaise    BigInt    @default(0)
  paymentFeePaise            BigInt    @default(0)
  taxOnFeesPaise             BigInt    @default(0)
  tcsPaise                   BigInt    @default(0)
  tdsPaise                   BigInt    @default(0)
  adjustmentPaise            BigInt    @default(0)
  refundPaise                BigInt    @default(0)
  providerExpectedNetPaise   BigInt?
  calculatedExpectedNetPaise BigInt
  paidNetPaise               BigInt
  variancePaise              BigInt
  mismatchTypesJson          String    @default("[]")
  matchStatus                String    @default("open")
  candidateCustomerOrderId   String?
  candidateBillId            String?
  matchedCustomerOrderId     String?
  matchedBillId              String?
  bankStatementTransactionId String?
  resolutionStatus           String    @default("open")
  resolutionNote             String?
  resolvedByUserId           String?
  resolvedAt                 DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  import   ChannelSettlementImport  @relation(fields: [importId], references: [id], onDelete: Cascade)
  shop     Shop                     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  location StoreLocation?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  events   ChannelSettlementEvent[]

  @@unique([importId, rowNumber])
  @@index([shopId, externalOrderId])
  @@index([shopId, locationId, orderDate])
  @@index([shopId, resolutionStatus, orderDate])
  @@index([shopId, provider, orderDate])
  @@index([importId, matchStatus])
}

model ChannelSettlementEvent {
  id           String   @id @default(cuid())
  shopId       String
  rowId        String
  action       String
  previousJson String
  nextJson     String
  reason       String?
  actorUserId  String?
  createdAt    DateTime @default(now())

  shop Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  row  ChannelSettlementRow @relation(fields: [rowId], references: [id], onDelete: Cascade)

  @@index([shopId, rowId, createdAt])
  @@index([shopId, action, createdAt])
}

// ─────────────────────────────────────────────
// COMBOS — a thali, a meal deal, "burger + fries + coke"
// ─────────────────────────────────────────────
// A combo needs no pricing of its own: it IS a Product, sold at that product's
// price, taxed and reported through the same path as any dish. What it adds is
// the list of dishes a guest actually receives, which is what the kitchen has to
// cook and what stock has to lose.
//
// Depth is deliberately ONE. A component must be a plain dish, never another
// combo. That is not a simplification for its own sake: it makes a cycle
// impossible to write, so no query can loop and no thali can contain itself.
// combos.service.js enforces it with a sentence rather than a stack overflow.
model MenuComboComponent {
  id     String @id @default(cuid())
  shopId String

  /// The sellable combo. Its own price is what the guest pays.
  comboProductId     String
  componentProductId String
  /// Copied so a combo report reads without a join, like a recipe's ingredientName.
  componentName      String

  /// How many of this dish the combo includes — 2 roti in a thali.
  quantity  Float   @default(1)
  sortOrder Int     @default(0)
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, comboProductId, componentProductId])
  @@index([shopId, comboProductId])
  /// "Which combos include roti?" — asked whenever a dish is 86'd or repriced.
  @@index([shopId, componentProductId])
}
