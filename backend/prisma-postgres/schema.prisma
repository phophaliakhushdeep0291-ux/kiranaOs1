model StoreLocation {
  id                  String   @id @default(cuid())
  shopId              String
  code                String
  name                String
  address             String?
  city                String?
  gstNumber           String?
  gstStateCode        String?
  gstLegalName        String?
  gstTradeName        String?
  gstRegistrationType String?
  phone               String?
  isPrimary           Boolean  @default(false)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  shop                     Shop                      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  stocks                   LocationStock[]
  outgoingTransfers        StockTransfer[]           @relation("TransferFrom")
  incomingTransfers        StockTransfer[]           @relation("TransferTo")
  bills                    Bill[]
  stockLedger              StockLedger[]
  udharLedger              UdharLedger[]
  purchaseHistory          PurchaseHistory[]
  expenses                 Expense[]
  dailyClosings            DailyClosingSnapshot[]
  retailPaymentIntents     RetailPaymentIntent[]
  purchaseOrders           PurchaseOrder[]
  purchaseReceipts         PurchaseReceipt[]
  purchaseReturns          PurchaseReturn[]
  customerOrders           CustomerOrder[]
  userAccess               UserLocationAccess[]
  pricingRules             PricingRule[]
  loyaltyTransactions      LoyaltyTransaction[]
  stockCountSessions       StockCountSession[]
  storageBins              StorageBin[]
  inventoryLots            InventoryLot[]
  restaurantTables         RestaurantTable[]
  tableReservations        TableReservation[]
  staffShifts              StaffShift[]
  kioskTerminals           KioskTerminal[]
  kitchenTickets           KitchenTicket[]
  channelSettlementImports ChannelSettlementImport[]
  channelSettlementRows    ChannelSettlementRow[]

  @@unique([shopId, code])
  @@index([shopId, active, createdAt])
  @@index([shopId, isPrimary])
}

model LocationStock {
  id                String   @id @default(cuid())
  shopId            String
  locationId        String
  productId         String
  // Which variant this row allocates. NULL is the product-level row every pooled
  // product uses and every existing row already is. The primary location holds no
  // row at all — its quantity is the product total minus what branches hold.
  //
  // NULLs are DISTINCT in a unique index, so @@unique does not stop two
  // product-level rows for one location; the migration adds a partial unique
  // index over the NULL case. See the SQLite twin for the full rationale.
  sellingUnitId     String?
  stockBaseQty      Float    @default(0)
  lowStockThreshold Float?
  updatedAt         DateTime @updatedAt

  shop        Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  location    StoreLocation       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellingUnit ProductSellingUnit? @relation(fields: [sellingUnitId], references: [id], onDelete: Cascade)

  @@unique([locationId, productId, sellingUnitId])
  @@index([shopId, productId])
  @@index([shopId, sellingUnitId])
}

model StorageBin {
  id         String   @id @default(cuid())
  shopId     String
  locationId String
  code       String
  name       String
  zone       String?
  // pick = the face a cashier picks from, bulk = reserve pallets/sacks behind it,
  // staging = received-but-not-put-away. Put-away suggestions read this.
  kind       String   @default("pick")
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  shop       Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  location   StoreLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  placements BinPlacement[]

  @@unique([locationId, code])
  @@index([shopId, locationId, active])
  @@index([shopId, updatedAt, id])
}

// Where inside a location a product physically sits. This is deliberately NOT a
// second stock ledger: LocationStock (and Product.stockBaseQty for the primary)
// stays authoritative for how much a location holds, and the quantity not yet
// assigned to any bin is derived as location stock minus the sum of placements.
// The only mutation is a move between two bins of the SAME location, which nets
// to zero, so no bin operation can change what a location owns. A design that let
// bins own quantity would need every sale, transfer and count to know about bins
// and would drift the moment one path forgot.
model BinPlacement {
  id            String   @id @default(cuid())
  shopId        String
  binId         String
  productId     String
  // Per-pack products place each size separately, for the same reason
  // LocationStock does: a placement that cannot say which size it holds cannot be
  // picked from or audited.
  sellingUnitId String?
  stockBaseQty  Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shop        Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  bin         StorageBin          @relation(fields: [binId], references: [id], onDelete: Cascade)
  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellingUnit ProductSellingUnit? @relation(fields: [sellingUnitId], references: [id], onDelete: Cascade)

  @@unique([binId, productId, sellingUnitId])
  @@index([shopId, productId])
  @@index([shopId, updatedAt, id])
}

model StockCountSession {
