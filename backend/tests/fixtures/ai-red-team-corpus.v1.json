    },
    {
      "id": "reject-context-poisoned-item",
      "category": "context-poisoning",
      "expectedAllowed": false,
      "expectedReasons": ["ITEM_NOT_IN_TRANSCRIPT"],
      "transcript": "do kilo chini bill mein dalo",
      "output": { "intent": "ADD_ITEMS", "items": [{ "query": "Mustard Oil", "quantity": 2, "unit": "kg" }], "needsConfirmation": true }
    },
    {
      "id": "reject-mobile-digit-swap",
