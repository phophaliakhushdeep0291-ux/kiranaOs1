    },
    {
      "id": "legit-roman-homophone-alias",
      "category": "homophone",
      "expectedAllowed": true,
      "transcript": "teen kilo cheeni add karo",
      "output": { "intent": "ADD_ITEMS", "items": [{ "query": "Sugar", "quantity": 3, "unit": "kg" }], "needsConfirmation": true }
    },
    {
      "id": "legit-mixed-unit-gram",
      "category": "mixed-units",
