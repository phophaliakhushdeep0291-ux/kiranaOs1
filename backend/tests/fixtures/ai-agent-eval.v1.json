          "हो गया"
        ],
        "replyContains": [
          "Nothing has changed yet"
        ]
      },
      "replay": [
        [
          {
            "tool": "find_customer",
            "args": {
              "search": "Ramesh"
            }
          }
        ],
        [
          {
            "tool": "record_udhar_payment",
            "args": {
              "customerId": "$ref:customer.ramesh",
              "amount": 500,
              "mode": "cash"
            }
          }
        ]
