{
  "version": "v1",
  "service": "KiranaOS Backend",
  "basePath": "/api",
  "updatedForPhase": "48-production-sellable-hardening",
  "clientRules": {
    "authHeader": "Authorization: Bearer <accessToken>",
    "deviceHeader": "x-device-id: <activatedDeviceId>",
    "ownerPinHeader": "x-owner-pin: <4-digit owner PIN>",
    "jsonContentType": "application/json",
    "moneyPrecision": "Money values are accepted only as finite numbers with max 2 decimal places unless a field explicitly uses integer paise.",
    "syncPagination": "New clients must persist response.sync.entityCursors and send them back as the cursors query JSON on the next pull.",
    "tenantScope": "The frontend must never send or trust body.shopId for tenant selection. Tenant context comes from the authenticated token; x-shop-id is reserved for future platform/admin flows.",
    "deviceActivationFlow": [
      "POST /api/auth/login",
      "POST /api/devices/activate with Authorization header",
      "Use returned deviceId in x-device-id for protected shop APIs",
      "GET /api/devices/license with Authorization + x-device-id when offline license is needed"
    ],
    "offlineSyncFlow": [
      "Create local outbox records while offline",
      "When online, POST /api/sync/push in batches not exceeding PUSH_MAX_BATCH_SIZE",
      "Then GET /api/sync/pull with per-entity cursors",
      "Persist serverVersion/entityCursors before applying UI refresh"
    ]
  },
  "standardErrors": {
    "401": [
      "INVALID_TOKEN_PAYLOAD",
      "USER_SESSION_INACTIVE"
    ],
    "402": [
      "SYNC_SUBSCRIPTION_INACTIVE",
      "PREMIUM_SUBSCRIPTION_INACTIVE"
    ],
    "403": [
      "DEVICE_BLOCKED",
      "DEVICE_REMOVED",
      "DEVICE_NOT_ACTIVE",
      "FEATURE_NOT_INCLUDED",
      "PLAN_TOO_LOW"
    ],
    "409": [
      "CONCURRENT_STOCK_MODIFICATION_RETRY",
      "UDHAR_PAYMENT_CONCURRENT_MODIFICATION",
      "PRODUCT_NAME_DUPLICATE"
    ]
  },
