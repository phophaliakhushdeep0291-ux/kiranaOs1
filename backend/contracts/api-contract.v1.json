      "path": "/api/sync/retry",
      "authRequired": true,
      "deviceRequired": true,
      "purpose": "acknowledge frontend retry request; local outbox remains source of truth"
    },
    {
      "method": "POST",
      "path": "/api/sync/ack",
      "authRequired": true,
      "deviceRequired": true,
      "feature": "cloud_backup or auto_two_way_sync",
      "requestMustSupport": [
        "server_seq"
      ],
      "responseMustInclude": [
        "acknowledgement.applied_server_seq",
        "acknowledgement.server_seq",
        "acknowledgement.lag",
        "acknowledgement.stale_ack_ignored"
      ],
      "syncGuarantees": [
        "acknowledgements never move a device cursor backwards",
        "a device cannot acknowledge a sequence greater than the current shop server sequence"
      ],
      "purpose": "record the highest server sequence durably applied by the authenticated device"
    },
    {
      "method": "GET",
      "path": "/api/sync/devices",
      "authRequired": true,
      "deviceRequired": true,
      "roles": [
        "owner",
        "admin"
      ],
      "responseMustInclude": [
        "server_seq",
        "summary.attention",
        "devices"
      ],
      "purpose": "show tenant-scoped per-device applied sequence, lag, freshness, and fleet attention counts"
    },
    {
      "method": "GET",
      "path": "/api/sync/conflicts",
      "authRequired": true,
      "deviceRequired": true,
      "roles": [
        "owner",
        "admin"
      ],
      "responseMustInclude": [
        "conflicts",
        "summary",
        "pagination.nextCursor"
      ],
      "purpose": "list the tenant-scoped durable sync conflict ledger"
    },
    {
      "method": "POST",
      "path": "/api/sync/conflicts/report",
      "authRequired": true,
      "deviceRequired": true,
      "purpose": "idempotently report a client-detected conflict with redacted bounded snapshots"
    },
    {
      "method": "POST",
      "path": "/api/sync/resolve-conflict",
      "authRequired": true,
      "deviceRequired": true,
      "roles": [
        "owner",
        "admin"
      ],
      "purpose": "optimistically resolve or dismiss a durable conflict with an audit trail"
    },
    {
      "method": "GET",
      "path": "/api/sync/pull",
      "authRequired": true,
      "deviceRequired": true,
      "feature": "cloud_backup or auto_two_way_sync",
      "responseMustInclude": [
        "sync.protocol",
        "sync.nextServerSeq",
        "sync.serverVersion",
        "sync.hasMore"
      ],
      "purpose": "pull server changes using monotonic server_sequence_v2, with legacy cursor compatibility"
