// KiranaOS Prisma Schema
// SQLite for dev, PostgreSQL-compatible for production
// Switch provider to "postgresql" and update DATABASE_URL when deploying

generator client {
  provider      = "prisma-client-js"
  // Include both the developer's native platform and the Linux target used in Docker.
  // Without this, a client generated on Windows/macOS will fail on debian-based containers.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// Integration tests use a separate generated client so a running Windows
// development server cannot lock the production client's query-engine DLL.
generator integrationClient {
  provider      = "prisma-client-js"
  output        = "../generated/integration-prisma-client"
  binaryTargets = ["native"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// SHOP — top-level tenant. All data is shopId-scoped.
// ─────────────────────────────────────────────
model Shop {
  id           String   @id @default(cuid())
  name         String
  ownerName    String
  city         String
  address      String
  gstNumber    String?
  phone        String?
  settingsJson String   @default("{}") // shop preferences: printer, taxes, notifications, security toggles
  dataEpoch    Int      @default(0) // increments after destructive recovery; stale devices must rebootstrap
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users                         User[]
  products                      Product[]
  customers                     Customer[]
  bills                         Bill[]
  payments                      Payment[]
  retailPaymentIntents          RetailPaymentIntent[]
  stockLedger                   StockLedger[]
  udharLedger                   UdharLedger[]
  suppliers                     Supplier[]
  purchaseHistory               PurchaseHistory[]
  purchaseOrders                PurchaseOrder[]
  purchaseReceipts              PurchaseReceipt[]
  purchaseReturns               PurchaseReturn[]
  userLocationAccess            UserLocationAccess[]
  aiActionLogs                  AiActionLog[]
  auditLogs                     AuditLog[]
  sessions                      Session[]
  authTokens                    AuthToken[]
  offlineSyncEvents             OfflineSyncEvent[]
  syncConflicts                 SyncConflict[]
  syncIdMappings                SyncIdMapping[]
  syncCommands                  SyncCommand[]
  changeLogs                    ChangeLog[]
  financialLedger               FinancialLedger[]
  billCounter                   BillCounter?
  subscriptions                 Subscription[]
  onboardingPurchases           OnboardingPurchase[]
  paymentTransactions           PaymentTransaction[]
  devices                       Device[]
  deviceLicenses                DeviceLicense[]
  deviceReplacementChallenges   DeviceReplacementChallenge[]
  reportExportJobs              ReportExportJob[]
  reminderTemplates             ReminderTemplate[]
  reminderLogs                  ReminderLog[]
  dailyClosingSnapshots         DailyClosingSnapshot[]
  expenses                      Expense[]
  offers                        Offer[]
  customerOrders                CustomerOrder[]
  pricingRules                  PricingRule[]
  productSellingUnits           ProductSellingUnit[]
  inventoryLots                 InventoryLot[]
  pricingDecisionEvents         PricingDecisionEvent[]
  integrationApiKeys            IntegrationApiKey[]
  webhookEndpoints              WebhookEndpoint[]
  webhookDeliveries             WebhookDelivery[]
  storeLocations                StoreLocation[]
  locationStocks                LocationStock[]
  stockTransfers                StockTransfer[]
  transferDocumentCounters      TransferDocumentCounter[]
  loyaltyPrograms               LoyaltyProgram[]
  loyaltyAccounts               LoyaltyAccount[]
  loyaltyTransactions           LoyaltyTransaction[]
  complianceDocuments           ComplianceDocument[]
  stockCountSessions            StockCountSession[]
  giftCards                     GiftCard[]
  giftCardTransactions          GiftCardTransaction[]
  backupArtifacts               BackupArtifact[]
  errorGroups                   ErrorGroup[]
  errorEvents                   ErrorEvent[]
  supportRequests               SupportRequest[]
  deviceHealthSnapshots         DeviceHealthSnapshot[]
  supportSessions               SupportSession[]
  deviceCommands                DeviceCommand[]
  activityEvents                ActivityEvent[]
  activityAggregates            ActivityAggregate[]
  rentalBookings                RentalBooking[]
  prescriptions                 Prescription[]
  productUnits                  ProductUnit[]
  partFitments                  PartFitment[]
  partCrossReferences           PartCrossReference[]
  footwearSizeProfiles          FootwearSizeProfile[]
  bookLists                     BookList[]
  furnitureOrders               FurnitureOrder[]
  testerUnits                   TesterUnit[]
  restaurantTables              RestaurantTable[]
  kitchenTickets                KitchenTicket[]
  dishRecipeComponents          DishRecipeComponent[]
  menuAddonGroups               MenuAddonGroup[]
  menuAddonOptions              MenuAddonOption[]
  productAddonGroups            ProductAddonGroup[]
  menuComboComponents           MenuComboComponent[]
  auditRules                    AuditRule[]
  auditRuns                     AuditRun[]
  auditEvaluations              AuditEvaluation[]
  auditFindings                 AuditFinding[]
  auditFindingRules             AuditFindingRule[]
  auditEvidenceRequirements     AuditEvidenceRequirement[]
  auditEvidence                 AuditEvidence[]
  auditFindingStatusHistory     AuditFindingStatusHistory[]
  auditReviews                  AuditReview[]
  auditCases                    AuditCase[]
  auditCaseFindings             AuditCaseFinding[]
  auditBaselines                AuditBaseline[]
  bankStatementImports          BankStatementImport[]
  bankStatementTransactions     BankStatementTransaction[]
  bankReconciliationAllocations BankReconciliationAllocation[]
  bankReconciliationEvents      BankReconciliationEvent[]
  channelSettlementImports      ChannelSettlementImport[]
  channelSettlementRows         ChannelSettlementRow[]
  channelSettlementEvents       ChannelSettlementEvent[]
  maintenanceLock               ShopMaintenanceLock?
}

model ShopMaintenanceLock {
  shopId         String   @id
  tokenHash      String
  reason         String
  lockedByUserId String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// ─────────────────────────────────────────────
// PRICING RULE — Smart Adaptive Pricing Engine.
// A normalized owner-defined price rule (customer / group / quantity / promo).
// String enums per repo convention (sqlite has no native enums). Money is Float
// rupees; the engine rounds to paise via the shared roundMoney. Rules are the
// backend source of truth; clients cache active rules for offline pricing.
// ─────────────────────────────────────────────
model PricingRule {
  id          String  @id @default(cuid())
  shopId      String
  name        String
  description String?
  ruleType    String // CUSTOMER_FIXED_PRICE | CUSTOMER_QUANTITY_PRICE | CUSTOMER_GROUP_PRICE | CUSTOMER_GROUP_QUANTITY_PRICE | PRODUCT_QUANTITY_PRICE | SELLING_UNIT_PRICE | PROMOTIONAL_PRICE | PAYMENT_METHOD_PRICE
  status      String  @default("ACTIVE") // DRAFT | ACTIVE | PAUSED | EXPIRED | ARCHIVED
  priority    Int     @default(0)

  productId     String?
  locationId    String?
  unitCode      String?
  sellingUnitId String?
  customerId    String?
  customerGroup String?

  minQuantity Float?
  maxQuantity Float?

  fixedUnitPrice  Float?
  adjustmentType  String? // FIXED_PRICE | FIXED_DISCOUNT | PERCENTAGE_DISCOUNT | MARKUP_ON_COST | MARGIN_ON_COST
  adjustmentValue Float?

  minimumMarginPercent Float?
  paymentMethod        String?
  combinePolicy        String? // CANNOT_COMBINE | CAN_COMBINE | BEST_PRICE_WINS | CUSTOMER_CONTRACT_WINS | PROMOTION_WINS
  validFrom            DateTime?
  validUntil           DateTime?

  requiresOwnerApproval Boolean  @default(false)
  createdByUserId       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  shop        Shop                @relation(fields: [shopId], references: [id])
  location    StoreLocation?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  sellingUnit ProductSellingUnit? @relation(fields: [sellingUnitId], references: [id], onDelete: SetNull)

  @@index([shopId, status, priority])
  @@index([shopId, productId])
  @@index([shopId, locationId, status, priority])
  @@index([shopId, sellingUnitId])
  @@index([shopId, customerId])
  @@index([shopId, customerGroup])
  @@index([shopId, updatedAt, id])
}

// A product-specific unit/pack identity. Quantity slabs are evaluated in
// counts of this selected unit; conversionToBase is used only for inventory.
// Examples: Packet 500 g -> 500 gram, Packet 1 kg -> 1000 gram,
// Box of 10 packets -> 10 packet/piece base units.
model ProductSellingUnit {
  id                String   @id @default(cuid())
  shopId            String
  productId         String
  name              String
  unitType          String
  unitCode          String
  packSizeValue     Float?
  packSizeUnit      String?
  conversionToBase  Float    @default(1)
  barcode           String?
  defaultPrice      Float
  defaultPricePaise BigInt?
  minimumPrice      Float?
  minimumPricePaise BigInt?
  maximumPrice      Float?
  maximumPricePaise BigInt?
  costPrice         Float?
  costPricePaise    BigInt?
  // Per-packaging stock, used only when the parent product is "per_pack".
  // Held in this unit's own counts (packets, boxes), NOT in product base units, so
  // "we are down to 4 of the 500 g packs" is answerable without a conversion.
  // Pooled products leave these null and keep reading Product.stockBaseQty.
  onHandQty         Float?
  lowStockThreshold Float?
  reorderLevel      Float?
  // Where this row sits on the parent's declared axes — "L" and "Blue". Null on
  // ordinary packaging rows ("500 g packet", "8-pack"), which have no axes.
  // Typed columns rather than a JSON blob because these are grouped and filtered
  // on ("what is left in L?"), which a blob cannot answer without a table scan.
  variantValue1     String?
  variantValue2     String?
  isDefault         Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  shop         Shop          @relation(fields: [shopId], references: [id])
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  pricingRules PricingRule[]
  billItems    BillItem[]

  @@unique([shopId, productId, unitCode])
  @@index([shopId, productId, isActive])
  @@index([shopId, barcode])
  @@index([shopId, updatedAt, id])
}

model PricingDecisionEvent {
  id                      String   @id @default(cuid())
  shopId                  String
  billId                  String?
  billItemId              String?
  productId               String
  sellingUnitId           String?
  customerId              String?
  customerGroup           String?
  quantity                Float
  productCost             Float?
  productCostPaise        BigInt?
  defaultPrice            Float
  defaultPricePaise       BigInt?
  recommendedPrice        Float
  recommendedPricePaise   BigInt?
  finalAcceptedPrice      Float
  finalAcceptedPricePaise BigInt?
  appliedRuleId           String?
  recommendationSource    String
  confidence              Float?
  wasOverridden           Boolean  @default(false)
  overrideReason          String?
  reusableDecision        Boolean  @default(true)
  oneTimeSpecialPrice     Boolean  @default(false)
  excludedFromLearning    Boolean  @default(false)
  exclusionReason         String?
  decidedByUserId         String?
  deviceId                String?
  createdAt               DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id])

  @@index([shopId, productId, customerId])
  @@index([shopId, productId, sellingUnitId])
  @@index([shopId, createdAt])
}

// ─────────────────────────────────────────────
// CUSTOMER ORDER — an order a customer submits from the public QR order page.
// Lands in the owner's "Orders Received" inbox; the owner turns it into a bill.
// itemsJson is a storefront snapshot: [{ productId, name, unit, price, qty }].
// ─────────────────────────────────────────────
model CustomerOrder {
  id                String    @id @default(cuid())
  shopId            String
  locationId        String?
  customerName      String
  customerMobile    String
  customerAddress   String?
  itemsJson         String    @default("[]")
  itemCount         Int       @default(0)
  estimatedTotal    Float     @default(0)
  note              String?
  fulfillmentType   String    @default("delivery") // delivery | pickup | dine_in
  promisedSlot      String?
  // Where the guest is sitting, when the order came off a table's QR code. Both
  // the id and the name are kept: the id is how the floor screen finds the table,
  // the name is what the kitchen ticket prints and must survive the table being
  // renamed or removed from the floor plan.
  tableId           String?
  tableName         String?
  guestCount        Int?
  sourceChannel     String    @default("customer_portal") // pos | customer_portal | api | marketplace
  externalOrderId   String?
  paymentStatus     String    @default("unpaid") // unpaid | partially_paid | paid | refunded
  fulfillmentStatus String    @default("unfulfilled") // unfulfilled | preparing | ready | fulfilled | cancelled
  status            String    @default("new") // new | accepted | ready | fulfilled | rejected | cancelled
  billId            String?
  idempotencyKey    String?
  acceptedAt        DateTime?
  readyAt           DateTime?
  fulfilledAt       DateTime?
  rejectedAt        DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  shop     Shop           @relation(fields: [shopId], references: [id])
  location StoreLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([shopId, idempotencyKey])
  @@index([shopId, locationId, status, createdAt])
  @@index([shopId, status, createdAt])
  @@index([shopId, sourceChannel, createdAt])
  @@index([shopId, fulfillmentStatus, createdAt])
  @@index([shopId, paymentStatus, createdAt])
  // "What has this table ordered tonight?" — the floor screen's only question.
  @@index([shopId, tableId, status, createdAt])
}

// ─────────────────────────────────────────────
// BILL COUNTER — transaction-safe per-shop bill number counter
// ─────────────────────────────────────────────
model BillCounter {
  id                 String   @id @default(cuid())
  shopId             String   @unique
  lastNumber         Int      @default(0)
  estimateLastNumber Int      @default(0)
  returnLastNumber   Int      @default(0)
  updatedAt          DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id])
}

// ─────────────────────────────────────────────
// USER — owner / staff / admin
// ─────────────────────────────────────────────
model User {
  id              String    @id @default(cuid())
  shopId          String
  name            String
  mobile          String?
  email           String?
  emailVerifiedAt DateTime?
  googleSub       String? // Google account id (ID-token `sub`) once linked
  passwordHash    String
  role            String    @default("staff") // owner | staff | admin
  pinHash         String? // 4-digit PIN for owner actions
  disabledAt      DateTime? // staff deactivation; never hard-delete audited users
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shop                        Shop                         @relation(fields: [shopId], references: [id])
  aiActionLogs                AiActionLog[]
  auditLogs                   AuditLog[]
  sessions                    Session[]
  authTokens                  AuthToken[]
  devices                     Device[]
  deviceReplacementChallenges DeviceReplacementChallenge[]
  reportExportJobs            ReportExportJob[]
  locationAccess              UserLocationAccess[]

  @@unique([shopId, mobile])
  @@unique([shopId, email])
  @@index([googleSub])
}

model AuthToken {
  id          String    @id @default(cuid())
  userId      String
  shopId      String
  type        String // email_verification | password_reset
  tokenHash   String    @unique
  sentToEmail String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
  shop Shop @relation(fields: [shopId], references: [id])

  @@index([userId, type, consumedAt])
  @@index([shopId, type, createdAt])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────
// SESSION — refresh token sessions for logout/revocation
// ─────────────────────────────────────────────
model Session {
  id                   String    @id @default(cuid())
  userId               String
  shopId               String
  deviceId             String? // Browser/device id that owns this login session. Used for concurrent device limits.
  deviceRecordId       String?
  deviceSessionVersion Int?
  tokenFamily          String?
  refreshTokenHash     String
  userAgent            String?
  ipAddress            String?
  expiresAt            DateTime
  revokedAt            DateTime?
  revokedReason        String?
  lastUsedAt           DateTime?
  createdAt            DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id])
  shop   Shop    @relation(fields: [shopId], references: [id])
  device Device? @relation(fields: [deviceRecordId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([shopId, revokedAt])
  @@index([shopId, deviceId, revokedAt])
  @@index([deviceRecordId, revokedAt])
  @@index([tokenFamily])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────
// PRODUCT
// Unit handling:
//   kg item  → displayUnit=kg,  baseUnit=g,  rateUnit=kg
//   ltr item → displayUnit=ltr, baseUnit=ml, rateUnit=ltr
//   piece    → all three = piece
//   packet   → all three = packet
// stockBaseQty is always in baseUnit
// ─────────────────────────────────────────────
model Product {
  id                           String    @id @default(cuid())
  shopId                       String
  name                         String
  category                     String    @default("general")
  aliasesJson                  String    @default("[]") // JSON array of alternate names/spellings
  displayUnit                  String    @default("piece")
  baseUnit                     String    @default("piece")
  rateUnit                     String    @default("piece")
  stockBaseQty                 Float     @default(0)
  costPerRateUnit              Float     @default(0) // weighted average buy price
  costPerRateUnitPaise         BigInt? // Phase 27 shadow integer paise column
  minPricePerRateUnit          Float     @default(0) // never sell below this
  minPricePerRateUnitPaise     BigInt? // Phase 27 shadow integer paise column
  defaultPricePerRateUnit      Float     @default(0) // default sell price
  defaultPricePerRateUnitPaise BigInt? // Phase 27 shadow integer paise column
  gstRate                      Float     @default(0) // e.g. 5, 12, 18
  hsn                          String?
  barcode                      String? // scanned/typed product barcode
  sku                          String? // stock-keeping unit code
  brand                        String? // optional brand/maker
  mrp                          Float     @default(0) // printed maximum retail price (display only, not reconciled)
  reorderLevel                 Float     @default(0) // suggested reorder quantity
  description                  String? // optional product notes
  imageUrl                     String? // optional product image (data URL or hosted URL)
  isLooseItem                  Boolean   @default(false) // sold loose by weight (no fixed package)
  lowStockThreshold            Float     @default(0) // alert when stock <= this
  // How the packagings of this product share stock.
  //   "pooled"   — one base-unit pool behind every selling unit. Correct for loose
  //                goods: 1 kg and a 5 kg bag both come out of the same sack, so
  //                splitting them would strand stock and block valid sales.
  //   "per_pack" — each selling unit holds its own count. Correct for distinct
  //                pre-packed SKUs (70 g packet vs 8-pack) that sit separately on
  //                the shelf and are reordered separately.
  // Defaults to "pooled" so existing products keep their current behaviour.
  packagingMode                String    @default("pooled")
  // The variant grid, in axis order:
  //   [{"name":"Size","values":["S","M","L"]},{"name":"Colour","values":["Blue","White"]}]
  // Empty array = an ordinary product, which is what every kirana item stays.
  // A variant is a ProductSellingUnit row — it already owns a barcode, a price
  // and its own onHandQty — tagged with its position on these axes. That is why
  // there is no separate variant table: billing, scanning and stock need no new
  // join, and a garment shop stops hand-typing one Product per size × colour.
  //
  // AXIS ORDER IS LOAD-BEARING: a child row's variantValue1 is its value on
  // axes[0]. Reordering this array silently remaps every existing row, so once
  // variants exist treat it as append-only.
  //
  // A product with axes must be "per_pack": each size/colour holds its own
  // stock, and on "pooled" they would all read one shared number and report
  // availability that is simply untrue. Enforced in products.service.js.
  variantAxesJson              String    @default("[]")
  batchTrackingEnabled         Boolean   @default(false)
  // Which drug schedule this medicine falls under: h | h1 | x | otc, or null for
  // anything that is not a scheduled drug (including every non-pharmacy product).
  //
  // Null is what makes this safe to add: enforcement is driven by the data, so a
  // catalogue nobody has classified behaves exactly as it does today. Marking a
  // product IS the act of opting it into the prescription requirement.
  drugSchedule                 String?
  // ── Menu card (restaurants) ────────────────────────────────────────────────
  // A dish is an ordinary Product — it is priced, billed, taxed and stocked
  // through exactly the same path as a packet of biscuits. What a menu adds is
  // how the dish is *presented and cooked*, which no retail column carries.
  //
  // Every one of these is nullable or defaulted, so a kirana catalogue is
  // untouched and a restaurant fills them in one dish at a time.
  menuCourse                   String? // "Starters" / "Main course" / "Breads" — free text: no cuisine is assumed
  foodType                     String? // veg | nonveg | egg | vegan | jain — the mark Indian menus are legally expected to carry
  spiceLevel                   Int? // 0 none … 3 very hot
  prepMinutes                  Int? // what the kitchen promises, shown to the guest before they order
  menuTags                     String? // csv: bestseller,chef-special,new,jain-available
  // Today's "86" list. Distinct from stock and from isActive: the dish exists,
  // is priced and returns tomorrow — the kitchen has simply run out of it now.
  menuAvailable                Boolean   @default(true)
  menuSortOrder                Int       @default(0)
  clientProductId              String? // stable client-generated id, for offline-create idempotency
  idempotencyKey               String? // durable create idempotency key (survives retries/pull echoes)
  sourceDeviceId               String? // device that created the product offline
  deletedAt                    DateTime? // soft delete
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  shop                 Shop                  @relation(fields: [shopId], references: [id])
  billItems            BillItem[]
  stockLedger          StockLedger[]
  purchaseHistory      PurchaseHistory[]
  sellingUnits         ProductSellingUnit[]
  locationStocks       LocationStock[]
  transferItems        StockTransferItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  purchaseReceiptItems PurchaseReceiptItem[]
  purchaseReturnItems  PurchaseReturnItem[]
  stockCountLines      StockCountLine[]
  inventoryLots        InventoryLot[]
  addonGroups          ProductAddonGroup[]

  @@unique([shopId, idempotencyKey])
  @@unique([shopId, sourceDeviceId, clientProductId])
  // One barcode, one product. Capture-on-first-scan binds codes from the counter,
  // where a mistake is silent: a code pointing at two products bills whichever one
  // the query happened to return. NULL is not a value in a unique index, so the
  // hundreds of products that legitimately have no barcode do not collide.
  //
  // A soft-deleted product KEEPS its barcode reserved, because it can be restored
  // from the recycle bin — releasing the code would let a restore resurrect a real
  // duplicate. products.service.js turns the resulting constraint error into a
  // message that names the owning product and says it is in the recycle bin.
  @@unique([shopId, barcode])
  @@index([shopId, deletedAt])
  // The menu card, in the order it is printed: "give me this shop's dishes,
  // grouped by course". Asked on every guest scan, so it is indexed.
  @@index([shopId, menuCourse, menuSortOrder])
  // Sync pull keyset pagination: WHERE shopId=X AND updatedAt>=since ORDER BY updatedAt ASC, id ASC
  @@index([shopId, updatedAt, id])
}

// ─────────────────────────────────────────────
// CUSTOMER / KHATA
// Matching is by mobile number, not name
// ─────────────────────────────────────────────
model Customer {
  id                    String    @id @default(cuid())
  shopId                String
  name                  String
  mobile                String?
  address               String?
  gstNumber             String?
  stateCode             String?
  type                  String    @default("regular") // regular | udhar
  customerGroup         String? // owner-defined pricing group (Wholesale/VIP/…)
  udharAmount           Float     @default(0) // current outstanding
  udharAmountPaise      BigInt? // Phase 27 shadow integer paise column
  reminderOverrideUntil DateTime?
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  shop           Shop            @relation(fields: [shopId], references: [id])
  bills          Bill[]
  udharLedger    UdharLedger[]
  reminderLogs   ReminderLog[]
  loyaltyAccount LoyaltyAccount?
  giftCards      GiftCard[]

  @@unique([shopId, mobile])
  @@index([shopId, deletedAt])
  // Sync pull keyset pagination
  @@index([shopId, updatedAt, id])
}

// ─────────────────────────────────────────────
// BILL
// ─────────────────────────────────────────────
model Bill {
  id                        String    @id @default(cuid())
  shopId                    String
  locationId                String?
  billNo                    String // e.g. KOS-2026-0001
  billType                  String    @default("normal_sale") // estimate | normal_sale | gst_invoice | udhar_entry
  status                    String    @default("active") // active | cancelled
  customerId                String?
  customerName              String    @default("Walk-in")
  buyerGstin                String?
  buyerStateCode            String?
  buyerAddress              String?
  sellerGstin               String?
  sellerStateCode           String?
  sellerLegalName           String?
  sellerTradeName           String?
  sellerAddress             String?
  sellerCity                String?
  subtotal                  Float     @default(0)
  subtotalPaise             BigInt?
  discount                  Float     @default(0)
  discountPaise             BigInt?
  discountReason            String?
  offerId                   String?
  offerCode                 String?
  offerDiscount             Float     @default(0)
  offerDiscountPaise        BigInt?
  loyaltyPointsRedeemed     Int       @default(0)
  loyaltyDiscount           Float     @default(0)
  loyaltyDiscountPaise      BigInt?
  giftCardAmount            Float     @default(0)
  giftCardAmountPaise       BigInt?
  gst                       Float     @default(0)
  gstPaise                  BigInt?
  gstMode                   String    @default("inclusive") // inclusive | exclusive | none
  grandTotal                Float     @default(0)
  grandTotalPaise           BigInt?
  actualAmount              Float     @default(0) // frontend actual bill amount before let-go handling
  actualAmountPaise         BigInt?
  buyerPaidAmount           Float     @default(0) // amount entered/received from buyer
  buyerPaidAmountPaise      BigInt?
  waivedAmount              Float     @default(0) // let-go amount absorbed by shop
  waivedAmountPaise         BigInt?
  grossProfit               Float     @default(0)
  grossProfitPaise          BigInt?
  paidAmount                Float     @default(0)
  paidAmountPaise           BigInt?
  creditAmount              Float     @default(0) // went to udhar
  creditAmountPaise         BigInt?
  createdByUserId           String? // authenticated user who created the bill; nullable for legacy/offline imports
  deviceId                  String? // client device id at bill creation, if available
  clientBillId              String?
  idempotencyKey            String?
  sourceDeviceId            String?
  cancelledAt               DateTime?
  cancelledReason           String?
  deletedAt                 DateTime?
  deletedReason             String?
  returnOfBillId            String? // set on billType "sales_return": the original sale this return reverses
  refundMode                String? // cash | upi | bank | udhar | gift_card
  whatsappDeliveryState     String    @default("not_sent") // not_sent | opened_share_sheet | sent_via_api | failed
  whatsappDeliveryAt        DateTime?
  whatsappProviderMessageId String?
  whatsappDeliveryKey       String?   @unique
  businessDate              DateTime  @default(now()) // when the sale happened; differs from createdAt for delayed offline sync
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  shop                 Shop                  @relation(fields: [shopId], references: [id])
  location             StoreLocation?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  customer             Customer?             @relation(fields: [customerId], references: [id])
  items                BillItem[]
  payments             Payment[]
  udharLedger          UdharLedger[]
  stockLedger          StockLedger[]
  loyaltyTransactions  LoyaltyTransaction[]
  complianceDocuments  ComplianceDocument[]
  giftCardTransactions GiftCardTransaction[]

  @@unique([shopId, billNo])
  @@unique([shopId, idempotencyKey])
  @@unique([shopId, sourceDeviceId, clientBillId])
  @@index([shopId, createdByUserId, createdAt])
  @@index([shopId, status, createdAt])
  @@index([shopId, locationId, status, createdAt])
  @@index([shopId, businessDate])
  @@index([shopId, status, businessDate])
  @@index([shopId, deletedAt, businessDate])
  @@index([shopId, locationId, status, businessDate])
  @@index([shopId, returnOfBillId])
  @@index([shopId, offerId, status])
  // Sync pull keyset pagination
  @@index([shopId, updatedAt, id])
}

// ─────────────────────────────────────────────
// BILL ITEM — line items inside a bill
// ─────────────────────────────────────────────
model BillItem {
  id                        String  @id @default(cuid())
  billId                    String
  productId                 String?
  sellingUnitId             String?
  sellingUnitCode           String?
  sellingUnitLabel          String?
  conversionToBase          Float?
  name                      String
  quantity                  Float
  enteredUnit               String
  baseUnit                  String
  quantityInBaseUnit        Float
  rateUnit                  String
  ratePerRateUnit           Float
  ratePerRateUnitPaise      BigInt?
  costPerRateUnit           Float
  costPerRateUnitPaise      BigInt?
  gstRate                   Float   @default(0)
  hsn                       String?
  originalBillItemId        String?
  note                      String?
  lineDiscount              Float   @default(0)
  lineDiscountPaise         BigInt?
  lineTotal                 Float
  lineTotalPaise            BigInt?
  lineCost                  Float
  lineCostPaise             BigInt?
  lineProfit                Float
  lineProfitPaise           BigInt?
  originalUnitPrice         Float?
  originalUnitPricePaise    BigInt?
  appliedPricingRuleId      String?
  appliedPricingRuleType    String?
  pricingExplanation        String?
  pricingConfidence         Float?
  pricingCalculationVersion String?
  wasPriceOverridden        Boolean @default(false)
  priceOverrideReason       String?
  priceApprovedByUserId     String?

  bill           Bill                    @relation(fields: [billId], references: [id])
  product        Product?                @relation(fields: [productId], references: [id])
  sellingUnit    ProductSellingUnit?     @relation(fields: [sellingUnitId], references: [id], onDelete: SetNull)
  lotAllocations BillItemLotAllocation[]
  addons         BillItemAddon[]

  @@index([billId])
  @@index([originalBillItemId])
}

// ─────────────────────────────────────────────
// PAYMENT — one bill can have multiple payment modes
// ─────────────────────────────────────────────
model Payment {
  id                    String    @id @default(cuid())
  shopId                String?
  billId                String
  mode                  String // cash | upi | credit
  amount                Float
  amountPaise           BigInt?
  clientPaymentId       String?
  idempotencyKey        String?
  sourceDeviceId        String?
  status                String    @default("confirmed") // pending | confirmed | failed | refunded
  provider              String? // manual | razorpay | terminal
  providerReference     String?
  confirmationSource    String    @default("manual") // manual | provider_api | signed_webhook
  confirmedAt           DateTime?
  retailPaymentIntentId String?   @unique
  createdAt             DateTime  @default(now())

  bill                Bill                 @relation(fields: [billId], references: [id])
  shop                Shop?                @relation(fields: [shopId], references: [id])
  retailPaymentIntent RetailPaymentIntent? @relation(fields: [retailPaymentIntentId], references: [id])

  @@unique([shopId, idempotencyKey])
  @@index([billId])
  @@index([shopId, createdAt])
}

model RetailPaymentIntent {
  id                 String    @id @default(cuid())
  shopId             String
  locationId         String
  provider           String    @default("razorpay")
  providerOrderId    String?   @unique
  providerPaymentId  String?   @unique
  amountPaise        Int
  currency           String    @default("INR")
  status             String    @default("creating") // creating | pending | confirmed | failed | expired | refunded
  createdByUserId    String?
  expiresAt          DateTime
  confirmedAt        DateTime?
  confirmationSource String?
  consumedAt         DateTime?
  failureReason      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  shop     Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  location StoreLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  payment  Payment?

  @@index([shopId, locationId, status, createdAt])
  @@index([status, expiresAt])
}

// Store locations are operational branches inside one legal shop tenant. The
// primary location owns the residual of Product.stockBaseQty; secondary
// balances are explicit LocationStock rows. This keeps existing billing and
// offline stock flows backwards compatible while making transfers real.
model StoreLocation {
  id                  String   @id @default(cuid())
  shopId              String
  code                String
  name                String
  address             String?
  city                String?
  gstNumber           String?
  gstStateCode        String?
  gstLegalName        String?
  gstTradeName        String?
  gstRegistrationType String?
  phone               String?
  isPrimary           Boolean  @default(false)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  shop                 Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  stocks               LocationStock[]
  outgoingTransfers    StockTransfer[]        @relation("TransferFrom")
  incomingTransfers    StockTransfer[]        @relation("TransferTo")
  bills                Bill[]
  stockLedger          StockLedger[]
  udharLedger          UdharLedger[]
  purchaseHistory      PurchaseHistory[]
  expenses             Expense[]
  dailyClosings        DailyClosingSnapshot[]
  retailPaymentIntents RetailPaymentIntent[]
  purchaseOrders       PurchaseOrder[]
  purchaseReceipts     PurchaseReceipt[]
  purchaseReturns      PurchaseReturn[]
  customerOrders       CustomerOrder[]
  userAccess           UserLocationAccess[]
  pricingRules         PricingRule[]
  loyaltyTransactions  LoyaltyTransaction[]
  stockCountSessions   StockCountSession[]
  inventoryLots        InventoryLot[]
  restaurantTables     RestaurantTable[]
  kitchenTickets       KitchenTicket[]
  channelSettlementImports ChannelSettlementImport[]
  channelSettlementRows    ChannelSettlementRow[]

  @@unique([shopId, code])
  @@index([shopId, active, createdAt])
  @@index([shopId, isPrimary])
}

model LocationStock {
  id                String   @id @default(cuid())
  shopId            String
  locationId        String
  productId         String
  stockBaseQty      Float    @default(0)
  lowStockThreshold Float?
  updatedAt         DateTime @updatedAt

  shop     Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  location StoreLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([locationId, productId])
  @@index([shopId, productId])
}

model StockCountSession {
  id               String    @id @default(cuid())
  shopId           String
  locationId       String
  activeKey        String?   @unique
  name             String
  status           String    @default("counting") // counting | review | applied | cancelled
  blindCount       Boolean   @default(true)
  createdByUserId  String?
  approvedByUserId String?
  submittedAt      DateTime?
  appliedAt        DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  shop     Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  location StoreLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  lines    StockCountLine[]

  @@index([shopId, locationId, status, createdAt])
}

model StockCountLine {
  id              String    @id @default(cuid())
  sessionId       String
  productId       String
  productName     String
  baseUnit        String
  expectedBaseQty Float
  countedBaseQty  Float?
  varianceBaseQty Float?
  reason          String?
  countedByUserId String?
  countedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  session StockCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([sessionId, productId])
  @@index([productId])
}

model GiftCard {
  id                  String    @id @default(cuid())
  shopId              String
  customerId          String?
  codeHash            String
  codeLast4           String
  status              String    @default("active") // active | depleted | disabled | expired
  initialBalancePaise BigInt
  balancePaise        BigInt
  expiresAt           DateTime?
  issuedAt            DateTime  @default(now())
  disabledAt          DateTime?
  note                String?
  createdByUserId     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  shop         Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer     Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  transactions GiftCardTransaction[]

  @@unique([shopId, codeHash])
  @@index([shopId, status, createdAt])
  @@index([shopId, customerId, createdAt])
}

model GiftCardTransaction {
  id                String   @id @default(cuid())
  shopId            String
  giftCardId        String
  billId            String?
  locationId        String?
  type              String // issue | redeem | redemption_reversal | return_credit | adjustment
  amountPaise       BigInt
  balanceAfterPaise BigInt
  note              String?
  createdByUserId   String?
  createdAt         DateTime @default(now())

  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  giftCard GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Restrict)
  bill     Bill?    @relation(fields: [billId], references: [id], onDelete: SetNull)

  @@unique([giftCardId, billId, type])
  @@index([shopId, createdAt])
  @@index([giftCardId, createdAt])
  @@index([billId])
}

model StockTransfer {
  id                    String    @id @default(cuid())
  shopId                String
  referenceNo           String
  fromLocationId        String
  toLocationId          String
  status                String    @default("completed") // in_transit | partially_received | completed | cancelled
  fulfillmentMode       String    @default("instant") // instant | shipment
  movementReason        String    @default("branch_transfer")
  documentType          String?
  documentNumber        String?
  documentDate          DateTime?
  gstTreatment          String    @default("unregistered_internal")
  fromGstin             String?
  fromStateCode         String?
  toGstin               String?
  toStateCode           String?
  isInterstate          Boolean   @default(false)
  complianceStatus      String    @default("not_applicable")
  eWayReviewRequired    Boolean   @default(false)
  eWayReviewStatus      String    @default("not_required") // not_required | pending | external_reference_recorded | not_required_after_review
  eWayBillNumber        String?
  eWayBillDate          DateTime?
  eWayReviewReason      String?
  eWayReviewedAt        DateTime?
  eWayReviewedByUserId  String?
  taxableValue          Float     @default(0)
  taxableValuePaise     BigInt?
  cgst                  Float     @default(0)
  cgstPaise             BigInt?
  sgst                  Float     @default(0)
  sgstPaise             BigInt?
  igst                  Float     @default(0)
  igstPaise             BigInt?
  taxTotal              Float     @default(0)
  taxTotalPaise         BigInt?
  consignmentValue      Float     @default(0)
  consignmentValuePaise BigInt?
  note                  String?
  createdByUserId       String?
  approvedByUserId      String?
  approvedAt            DateTime?
  dispatchedAt          DateTime?
  expectedArrivalDate   DateTime?
  carrierName           String?
  trackingNumber        String?
  receivedByUserId      String?
  lastReceivedAt        DateTime?
  cancelledAt           DateTime?
  cancelledByUserId     String?
  cancelReason          String?
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  shop         Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  fromLocation StoreLocation       @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation   StoreLocation       @relation("TransferTo", fields: [toLocationId], references: [id])
  items        StockTransferItem[]

  @@unique([shopId, referenceNo])
  @@unique([shopId, documentType, documentNumber])
  @@unique([shopId, eWayBillNumber])
  @@index([shopId, createdAt])
  @@index([shopId, status, createdAt])
  @@index([shopId, eWayReviewStatus, createdAt])
}

model StockTransferItem {
  id                String  @id @default(cuid())
  transferId        String
  productId         String
  productName       String
  quantityBaseQty   Float
  receivedBaseQty   Float   @default(0)
  baseUnit          String
  hsn               String?
  gstRate           Float   @default(0)
  taxableValue      Float   @default(0)
  taxableValuePaise BigInt?
  cgst              Float   @default(0)
  cgstPaise         BigInt?
  sgst              Float   @default(0)
  sgstPaise         BigInt?
  igst              Float   @default(0)
  igstPaise         BigInt?
  taxTotal          Float   @default(0)
  taxTotalPaise     BigInt?
  totalValue        Float   @default(0)
  totalValuePaise   BigInt?

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])

  @@unique([transferId, productId])
  @@index([productId])
}

model TransferDocumentCounter {
  id           String   @id @default(cuid())
  shopId       String
  fiscalYear   String
  documentType String
  lastNumber   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, fiscalYear, documentType])
  @@index([shopId, updatedAt])
}

model LoyaltyProgram {
  id                      String   @id @default(cuid())
  shopId                  String   @unique
  active                  Boolean  @default(false)
  pointsPerRupee          Float    @default(1)
  redemptionPaisePerPoint Int      @default(25)
  minimumRedeemPoints     Int      @default(100)
  pointsExpireDays        Int      @default(365) // 0 disables inactivity expiry
  tierRulesJson           String   @default("[{\"name\":\"Bronze\",\"minLifetimePoints\":0},{\"name\":\"Silver\",\"minLifetimePoints\":1000},{\"name\":\"Gold\",\"minLifetimePoints\":5000}]")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model LoyaltyAccount {
  id               String    @id @default(cuid())
  shopId           String
  customerId       String    @unique
  pointsBalance    Int       @default(0)
  lifetimeEarned   Int       @default(0)
  lifetimeRedeemed Int       @default(0)
  lastEarnedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  shop         Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]

  @@index([shopId, pointsBalance])
}

model LoyaltyTransaction {
  id             String   @id @default(cuid())
  shopId         String
  accountId      String
  billId         String?
  locationId     String?
  type           String // earn | redeem | adjustment | expire | redeem_reversal
  lifecycleCycle Int      @default(0) // 0 = original/legacy; 1+ = immutable cancel/restore cycle
  points         Int
  source         String   @default("pos") // pos | customer_order | admin | system
  note           String?
  createdAt      DateTime @default(now())

  shop     Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  account  LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  bill     Bill?          @relation(fields: [billId], references: [id], onDelete: SetNull)
  location StoreLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([billId, type, lifecycleCycle])
  @@index([shopId, createdAt])
  @@index([accountId, createdAt])
  @@index([shopId, locationId, createdAt])
}

model ComplianceDocument {
  id                String   @id @default(cuid())
  shopId            String
  billId            String
  documentType      String // e_invoice | e_way_bill
  provider          String
  status            String // sandbox_only | submitted | accepted | rejected | cancelled
  externalReference String?
  acknowledgementNo String?
  payloadHash       String
  payloadJson       String
  responseJson      String?
  errorMessage      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@unique([billId, documentType])
  @@index([shopId, documentType, status, createdAt])
}

// ─────────────────────────────────────────────
// STOCK LEDGER — every stock change is logged
// ─────────────────────────────────────────────
model StockLedger {
  id                      String    @id @default(cuid())
  shopId                  String
  locationId              String?
  productId               String
  productName             String
  // Which packaging this movement belongs to, for "per_pack" products. Without it a
  // per-pack balance cannot be audited or rebuilt from the ledger, which is the
  // whole point of having a ledger. Null for pooled products and legacy rows.
  sellingUnitId           String?
  sellingUnitQty          Float? // movement size in that unit's own counts
  action                  String // sale | purchase | damage | correction | cancel_reversal
  changeBaseQty           Float // positive = stock in, negative = stock out
  oldStockBaseQty         Float
  newStockBaseQty         Float
  purchaseBillAmount      Float     @default(0) // total bill amount if it's a purchase
  purchaseBillAmountPaise BigInt?
  calculatedBuyRate       Float     @default(0) // per rateUnit cost computed from purchase
  calculatedBuyRatePaise  BigInt?
  invoiceNumber           String?
  purchasePaymentStatus   String    @default("paid") // paid | partial | due
  purchasePaymentMode     String?
  purchasePaidAmount      Float     @default(0)
  purchasePaidAmountPaise BigInt?
  purchaseDueAmount       Float     @default(0)
  purchaseDueAmountPaise  BigInt?
  purchaseDueDate         DateTime?
  supplierName            String?
  damageLossValue         Float     @default(0) // cost value of damage, affects P&L
  damageLossValuePaise    BigInt?
  billId                  String?
  clientMovementId        String?
  idempotencyKey          String?
  sourceDeviceId          String?
  sourceType              String?
  sourceId                String?
  note                    String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  shop     Shop           @relation(fields: [shopId], references: [id])
  location StoreLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  product  Product        @relation(fields: [productId], references: [id])
  bill     Bill?          @relation(fields: [billId], references: [id])

  @@unique([shopId, idempotencyKey])
  @@index([shopId, createdAt])
  @@index([shopId, sellingUnitId])
  @@index([shopId, locationId, createdAt])
  @@index([shopId, sourceType, sourceId])
  @@index([productId])
  // Sync pull keyset pagination (updatedAt == createdAt for append-only ledger)
  @@index([shopId, updatedAt, id])
}

// ─────────────────────────────────────────────
// UDHAR LEDGER — every udhar/payment event
// ─────────────────────────────────────────────
model UdharLedger {
  id                 String    @id @default(cuid())
  shopId             String
  locationId         String?
  customerId         String
  customerName       String
  type               String // debit | payment
  amount             Float
  amountPaise        BigInt?
  mode               String // cash | upi | reversal | credit
  billId             String?
  billNo             String?
  clientLedgerId     String?
  idempotencyKey     String?
  sourceDeviceId     String?
  sourceType         String?
  sourceId           String?
  note               String?
  reversedAt         DateTime?
  reversedReason     String?
  reversalOfLedgerId String?
  reversedByUserId   String?
  businessDate       DateTime  @default(now()) // economic event time; preserves offline payment/sale timing
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  shop     Shop           @relation(fields: [shopId], references: [id])
  location StoreLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  customer Customer       @relation(fields: [customerId], references: [id])
  bill     Bill?          @relation(fields: [billId], references: [id])

  @@unique([shopId, idempotencyKey])
  @@index([shopId, customerId, createdAt])
  @@index([shopId, locationId, createdAt])
  @@index([shopId, customerId, businessDate])
  @@index([shopId, locationId, businessDate])
  @@index([shopId, reversalOfLedgerId])
  @@index([shopId, sourceType, sourceId])
  // Sync pull keyset pagination
  @@index([shopId, updatedAt, id])
}

// ─────────────────────────────────────────────
// SUPPLIER
// ─────────────────────────────────────────────
model Supplier {
  id        String    @id @default(cuid())
  shopId    String
  name      String
  mobile    String?
  address   String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  shop             Shop              @relation(fields: [shopId], references: [id])
  purchaseHistory  PurchaseHistory[]
  purchaseOrders   PurchaseOrder[]
  purchaseReceipts PurchaseReceipt[]
  purchaseReturns  PurchaseReturn[]

  @@index([shopId])
  @@index([shopId, deletedAt])
  @@index([shopId, updatedAt, id])
}

// ─────────────────────────────────────────────
// EXPENSE — shop operating expenses (rent, salary, utilities…)
// ─────────────────────────────────────────────
model Expense {
  id                String    @id @default(cuid())
  shopId            String
  locationId        String?
  title             String
  amount            Float     @default(0)
  amountPaise       BigInt?
  idempotencyKey    String?
  clientExpenseId   String?
  sourceDeviceId    String?
  category          String    @default("general")
  paymentMode       String    @default("cash")
  vendor            String?
  status            String    @default("paid") // paid | pending
  recurringInterval String    @default("none") // none | daily | weekly | monthly
  nextDueOn         DateTime?
  recordedBy        String?
  notes             String?
  spentAt           DateTime  @default(now())
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  shop     Shop           @relation(fields: [shopId], references: [id])
  location StoreLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([shopId, idempotencyKey])
  @@unique([shopId, sourceDeviceId, clientExpenseId])
  @@index([shopId])
  @@index([shopId, deletedAt])
  @@index([shopId, spentAt])
  @@index([shopId, locationId, spentAt])
  @@index([shopId, updatedAt, id])
}

// ─────────────────────────────────────────────
// OFFER — discounts / coupons applied at billing
// ─────────────────────────────────────────────
model Offer {
  id            String    @id @default(cuid())
  shopId        String
  title         String
  code          String?
  type          String    @default("percentage") // percentage | flat
  value         Float     @default(0)
  minBillAmount Float     @default(0)
  maxDiscount   Float     @default(0) // cap for percentage; 0 = no cap
  scope         String    @default("all") // all | category | product
  scopeValue    String?
  validFrom     DateTime?
  validTo       DateTime?
  usageLimit    Int       @default(0) // 0 = unlimited
  usedCount     Int       @default(0)
  discountGiven Float     @default(0) // accumulated ₹ discount from redemptions
  active        Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  shop Shop @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@index([shopId, deletedAt])
  @@index([shopId, active])
  @@index([shopId, updatedAt, id])
}

// ─────────────────────────────────────────────
// PURCHASE HISTORY — dealer/supplier price tracking
// ─────────────────────────────────────────────
model PurchaseHistory {
  id                      String    @id @default(cuid())
  shopId                  String
  locationId              String?
  productId               String
  supplierId              String?
  purchaseOrderId         String?
  purchaseOrderItemId     String?
  purchaseReceiptId       String?
  supplierName            String
  qtyBase                 Float // quantity in baseUnit
  pricePerRateUnit        Float // computed: totalCost / (qtyBase / conversionFactor)
  pricePerRateUnitPaise   BigInt?
  totalCost               Float
  totalCostPaise          BigInt?
  billAmount              Float // what was written on the supplier's bill
  billAmountPaise         BigInt?
  invoiceNumber           String?
  purchasePaymentStatus   String    @default("paid") // paid | partial | due
  purchasePaymentMode     String?
  purchasePaidAmount      Float     @default(0)
  purchasePaidAmountPaise BigInt?
  purchaseDueAmount       Float     @default(0)
  purchaseDueAmountPaise  BigInt?
  purchaseDueDate         DateTime?
  note                    String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  shop              Shop               @relation(fields: [shopId], references: [id])
  location          StoreLocation?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  product           Product            @relation(fields: [productId], references: [id])
  supplier          Supplier?          @relation(fields: [supplierId], references: [id])
  purchaseOrder     PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)
  purchaseReceipt   PurchaseReceipt?   @relation(fields: [purchaseReceiptId], references: [id], onDelete: SetNull)

  @@index([shopId, productId, createdAt])
  @@index([shopId, locationId, createdAt])
  @@index([shopId, purchaseOrderId, createdAt])
  @@index([shopId, purchaseReceiptId])
  @@index([shopId, updatedAt, id])
}

model PurchaseOrder {
  id                 String    @id @default(cuid())
  shopId             String
  locationId         String
  supplierId         String?
  orderNumber        String
  supplierName       String
  status             String    @default("draft") // draft | sent | partially_received | received | cancelled
  expectedOn         DateTime?
  expectedTotal      Float     @default(0)
  expectedTotalPaise BigInt?
  vendorReference    String?
  paymentTerms       String?
  deliveryAddress    String?
  termsAndConditions String?
  note               String?
  createdByUserId    String?
  sentAt             DateTime?
  receivedAt         DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  shop     Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  location StoreLocation       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  supplier Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items    PurchaseOrderItem[]
  receipts PurchaseReceipt[]
  history  PurchaseHistory[]

  @@unique([shopId, orderNumber])
  @@index([shopId, locationId, status, createdAt])
  @@index([shopId, supplierId, createdAt])
  @@index([shopId, supplierId, vendorReference])
}

model PurchaseOrderItem {
  id                  String  @id @default(cuid())
  purchaseOrderId     String
  productId           String
  productName         String
  baseUnit            String
  rateUnit            String
  orderedBaseQty      Float
  receivedBaseQty     Float   @default(0)
  expectedRate        Float
  expectedRatePaise   BigInt?
  expectedAmount      Float
  expectedAmountPaise BigInt?

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  receiptItems  PurchaseReceiptItem[]
  history       PurchaseHistory[]

  @@unique([purchaseOrderId, productId])
  @@index([productId])
}

model PurchaseReceipt {
  id                         String    @id @default(cuid())
  shopId                     String
  locationId                 String
  purchaseOrderId            String
  supplierId                 String?
  receiptNumber              String
  supplierInvoiceNumber      String?
  supplierInvoiceAmount      Float?
  supplierInvoiceAmountPaise BigInt?
  expectedGoodsAmount        Float     @default(0)
  expectedGoodsAmountPaise   BigInt?
  priceVarianceAmount        Float     @default(0)
  priceVarianceAmountPaise   BigInt?
  invoiceVarianceAmount      Float?
  invoiceVarianceAmountPaise BigInt?
  matchStatus                String    @default("invoice_pending") // invoice_pending | matched | approved_variance
  varianceReason             String?
  varianceApprovedByUserId   String?
  varianceApprovedAt         DateTime?
  idempotencyKey             String?
  totalAmount                Float
  totalAmountPaise           BigInt?
  paidAmount                 Float     @default(0)
  paidAmountPaise            BigInt?
  dueAmount                  Float     @default(0)
  dueAmountPaise             BigInt?
  paymentMode                String?
  dueDate                    DateTime?
  note                       String?
  receivedByUserId           String?
  createdAt                  DateTime  @default(now())

  shop          Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  location      StoreLocation         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  supplier      Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items         PurchaseReceiptItem[]
  history       PurchaseHistory[]
  returns       PurchaseReturn[]

  @@unique([shopId, receiptNumber])
  @@unique([shopId, idempotencyKey])
  @@index([shopId, locationId, createdAt])
  @@index([shopId, purchaseOrderId, createdAt])
  @@index([shopId, matchStatus, createdAt])
}

model PurchaseReceiptItem {
  id                  String  @id @default(cuid())
  receiptId           String
  purchaseOrderItemId String
  productId           String
  quantityBaseQty     Float
  actualRate          Float
  actualRatePaise     BigInt?
  lineAmount          Float
  lineAmountPaise     BigInt?
  stockLedgerId       String?
  purchaseHistoryId   String?

  receipt           PurchaseReceipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem    @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  product           Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventoryLots     InventoryLot[]
  returnItems       PurchaseReturnItem[]

  @@unique([receiptId, purchaseOrderItemId])
  @@index([productId])
}

model PurchaseReturn {
  id                        String    @id @default(cuid())
  shopId                    String
  locationId                String
  supplierId                String?
  purchaseReceiptId         String
  returnNumber              String
  refundMode                String    @default("supplier_credit") // supplier_credit | cash | bank
  totalAmount               Float
  totalAmountPaise          BigInt?
  supplierCreditAmount      Float     @default(0)
  supplierCreditAmountPaise BigInt?
  refundAmount              Float     @default(0)
  refundAmountPaise         BigInt?
  reason                    String
  supplierReference         String?
  idempotencyKey            String?
  status                    String    @default("active") // active | cancelled
  cancelledAt               DateTime?
  cancelledByUserId         String?
  cancellationReason        String?
  createdByUserId           String?
  createdAt                 DateTime  @default(now())

  shop            Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  location        StoreLocation        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  supplier        Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseReceipt PurchaseReceipt      @relation(fields: [purchaseReceiptId], references: [id], onDelete: Restrict)
  items           PurchaseReturnItem[]

  @@unique([shopId, returnNumber])
  @@unique([shopId, idempotencyKey])
  @@index([shopId, locationId, createdAt])
  @@index([shopId, supplierId, createdAt])
  @@index([shopId, purchaseReceiptId, createdAt])
  @@index([shopId, status, createdAt])
}

model PurchaseReturnItem {
  id                    String  @id @default(cuid())
  purchaseReturnId      String
  purchaseReceiptItemId String
  productId             String
  quantityBaseQty       Float
  actualRate            Float
  actualRatePaise       BigInt?
  lineAmount            Float
  lineAmountPaise       BigInt?
  lotAllocationsJson    String  @default("[]")

  purchaseReturn      PurchaseReturn      @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  purchaseReceiptItem PurchaseReceiptItem @relation(fields: [purchaseReceiptItemId], references: [id], onDelete: Restrict)
  product             Product             @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([purchaseReturnId, purchaseReceiptItemId])
  @@index([productId])
}

model InventoryLot {
  id                    String    @id @default(cuid())
  shopId                String
  locationId            String
  productId             String
  purchaseReceiptItemId String?
  batchNumber           String
  manufacturedOn        DateTime?
  expiresOn             DateTime
  receivedBaseQty       Float
  availableBaseQty      Float
  costPerRateUnit       Float
  costPerRateUnitPaise  BigInt?
  // The MRP printed on THIS batch's pack, same basis as Product.mrp (the default
  // pack). Null means the batch carries no price of its own and the product MRP
  // applies. Medicine MRP is revised between batches, so the strip in hand and the
  // product record routinely disagree — billing must cap against the strip.
  mrp                   Float?
  mrpPaise              BigInt?
  status                String    @default("active") // active | depleted | quarantined | recalled
  note                  String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  shop                Shop                    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  location            StoreLocation           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  product             Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  purchaseReceiptItem PurchaseReceiptItem?    @relation(fields: [purchaseReceiptItemId], references: [id], onDelete: SetNull)
  allocations         BillItemLotAllocation[]

  @@unique([shopId, locationId, productId, batchNumber, expiresOn])
  @@index([shopId, locationId, status, expiresOn])
  @@index([shopId, productId, expiresOn])
}

model BillItemLotAllocation {
  id              String   @id @default(cuid())
  billItemId      String
  inventoryLotId  String
  quantityBaseQty Float
  createdAt       DateTime @default(now())

  billItem     BillItem     @relation(fields: [billItemId], references: [id], onDelete: Cascade)
  inventoryLot InventoryLot @relation(fields: [inventoryLotId], references: [id], onDelete: Restrict)

  @@unique([billItemId, inventoryLotId])
  @@index([inventoryLotId])
}

model UserLocationAccess {
  id                 String   @id @default(cuid())
  shopId             String
  userId             String
  locationId         String
  canSell            Boolean  @default(true)
  canPurchase        Boolean  @default(false)
  canManageInventory Boolean  @default(false)
  canTransfer        Boolean  @default(false)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  shop     Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  location StoreLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
  @@index([shopId, locationId, active])
  @@index([shopId, userId, active])
}

// ─────────────────────────────────────────────
// AI ACTION LOG
// ─────────────────────────────────────────────
model AiActionLog {
  id               String   @id @default(cuid())
  shopId           String
  userId           String?
  transcript       String
  parsedActionJson String // JSON string of the parsed command
  permissionLevel  String // safe | confirm | owner_pin | blocked
  status           String // parsed | executed | rejected | failed
  error            String?
  createdAt        DateTime @default(now())

  shop Shop  @relation(fields: [shopId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@index([shopId, createdAt])
}

// ─────────────────────────────────────────────
// AUDIT LOG — central security/action audit trail
// ─────────────────────────────────────────────
model AuditLog {
  id           String   @id @default(cuid())
  shopId       String
  userId       String?
  deviceId     String?
  module       String? // billing | inventory | auth | sync | devices | settings | ...
  action       String
  entityType   String?
  entityId     String?
  beforeJson   String?
  afterJson    String?
  metadataJson String?
  result       String? // success | failure
  durationMs   Int?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  shop Shop  @relation(fields: [shopId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@index([shopId, createdAt])
  @@index([shopId, action, createdAt])
  @@index([shopId, module, createdAt])
  @@index([shopId, result, createdAt])
}

// ─────────────────────────────────────────────
// DAILY CLOSING SNAPSHOT — persisted report snapshot per shop/day
// ─────────────────────────────────────────────
model DailyClosingSnapshot {
  id                     String    @id @default(cuid())
  shopId                 String
  storeId                String?
  date                   DateTime
  totalSalesPaise        Int       @default(0)
  cashReceivedPaise      Int       @default(0)
  upiReceivedPaise       Int       @default(0)
  bankReceivedPaise      Int       @default(0)
  udharGivenPaise        Int       @default(0)
  oldUdharRecoveredPaise Int       @default(0)
  expectedCashPaise      Int       @default(0)
  totalBills             Int       @default(0)
  cancelledBills         Int       @default(0)
  roughBills             Int       @default(0)
  pendingSyncCount       Int       @default(0)
  topProductsJson        String    @default("[]")
  lowStockJson           String    @default("[]")
  generatedByUserId      String?
  generatedAt            DateTime  @default(now())
  lockedAt               DateTime?
  lockedByUserId         String?
  source                 String    @default("live") // live | worker | manual
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  shop  Shop           @relation(fields: [shopId], references: [id])
  store StoreLocation? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@unique([shopId, storeId, date])
  @@index([shopId, date])
  @@index([shopId, storeId, date])
  @@index([shopId, lockedAt])
}

// ─────────────────────────────────────────────
// REPORT EXPORT JOB — persistent async report export tracking
// ─────────────────────────────────────────────
model ReportExportJob {
  id                String    @id @default(cuid())
  shopId            String
  requestedByUserId String
  reportType        String
  status            String    @default("queued") // queued | processing | completed | failed | cancelled
  paramsJson        String    @default("{}")
  fileName          String?
  filePath          String?
  fileUrl           String?
  mimeType          String?
  sizeBytes         Int?
  error             String?
  requestedAt       DateTime  @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  shop        Shop @relation(fields: [shopId], references: [id])
  requestedBy User @relation(fields: [requestedByUserId], references: [id])

  @@index([shopId, status, createdAt])
  @@index([shopId, reportType, createdAt])
  @@index([requestedByUserId, createdAt])
  @@index([expiresAt])
}

model BackupArtifact {
  id                String    @id @default(cuid())
  shopId            String?
  requestedByUserId String?
  type              String // shop_logical
  status            String    @default("queued") // queued | processing | completed | failed | expired
  format            String    @default("kiranaos_aes256gcm_gzip_v1")
  storageProvider   String?
  objectKey         String?
  checksumSha256    String?
  sizeBytes         BigInt?
  recordCount       Int?
  schemaVersion     String?
  errorCode         String?
  errorMessage      String?
  startedAt         DateTime?
  completedAt       DateTime?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  shop Shop? @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@index([status, expiresAt])
}

// ─────────────────────────────────────────────
// REMINDER TEMPLATES / LOGS — WhatsApp udhar reminders foundation
// ─────────────────────────────────────────────
model ReminderTemplate {
  id              String    @id @default(cuid())
  shopId          String
  name            String
  channel         String    @default("whatsapp") // whatsapp | sms | email
  templateText    String
  active          Boolean   @default(true)
  createdByUserId String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shop Shop @relation(fields: [shopId], references: [id])

  @@index([shopId, active])
  @@index([shopId, channel])
  @@index([shopId, deletedAt])
}

model ReminderLog {
  id                String    @id @default(cuid())
  shopId            String
  customerId        String
  channel           String    @default("whatsapp") // whatsapp | sms | email
  templateId        String?
  message           String
  status            String    @default("queued") // queued | accepted | sent | delivered | read | failed | skipped
  provider          String    @default("disabled")
  providerMessageId String?
  error             String?
  acceptedAt        DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  lastStatusAt      DateTime?
  requestedByUserId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  shop     Shop     @relation(fields: [shopId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([provider, providerMessageId])
  @@index([shopId, customerId, createdAt])
  @@index([shopId, status, createdAt])
  @@index([shopId, channel, createdAt])
}

// Signed provider status callbacks are persisted without message/customer data.
// Pending rows close the race where a callback arrives before the send worker has
// stored the provider message id.
model ReminderDeliveryEvent {
  id                String    @id @default(cuid())
  provider          String
  providerMessageId String
  status            String
  errorCode         String?
  eventAt           DateTime
  reminderLogId     String?
  processedAt       DateTime?
  receivedAt        DateTime  @default(now())

  @@unique([provider, providerMessageId, status])
  @@index([provider, providerMessageId, processedAt])
  @@index([processedAt, receivedAt])
}

// ─────────────────────────────────────────────
// OFFLINE SYNC EVENT — idempotency log for IndexedDB queue replay
// ─────────────────────────────────────────────
model OfflineSyncEvent {
  id          String   @id @default(cuid())
  shopId      String
  eventId     String
  type        String
  status      String   @default("processing") // processing | synced | failed | conflict
  attempts    Int      @default(0)
  requestJson String   @default("{}")
  resultJson  String?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id])

  @@unique([shopId, eventId])
  @@index([shopId, status, createdAt])
}

model SyncConflict {
  id                 String    @id @default(cuid())
  shopId             String
  sourceEventId      String?
  clientConflictId   String?
  deviceId           String?
  reportedByUserId   String?
  entityType         String
  entityId           String
  reasonCode         String
  message            String
  status             String    @default("open") // open | resolved | dismissed
  localSnapshotJson  String    @default("{}")
  serverSnapshotJson String?
  baseSnapshotJson   String?
  serverVersion      String?
  resolution         String?
  mergedPayloadJson  String?
  resolutionNote     String?
  resolvedByUserId   String?
  resolvedByDeviceId String?
  version            Int       @default(1)
  detectedAt         DateTime  @default(now())
  resolvedAt         DateTime?
  expiresAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, sourceEventId])
  @@unique([shopId, clientConflictId])
  @@index([shopId, status, createdAt])
  @@index([shopId, entityType, entityId])
  @@index([shopId, deviceId, createdAt])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────
// SYNC ID MAPPING — resolves frontend local IDs to server IDs
// ─────────────────────────────────────────────
model SyncCommand {
  id              String   @id @default(cuid())
  shopId          String
  userId          String?
  deviceId        String?
  clientCommandId String
  idempotencyKey  String
  type            String
  requestHash     String
  status          String   @default("processing") // processing | applied | failed | conflict
  resultJson      String?
  error           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id])

  @@unique([shopId, idempotencyKey])
  @@unique([shopId, deviceId, clientCommandId])
  @@index([shopId, status, createdAt])
}

model ChangeLog {
  // SQLite rowid autoincrement only works on INTEGER PRIMARY KEY. PostgreSQL
  // keeps BigInt in its provider-specific schema for effectively unbounded use.
  seq         Int      @id @default(autoincrement())
  shopId      String
  entityType  String
  entityId    String
  operation   String
  payloadJson String   @default("{}")
  createdAt   DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, seq])
  @@index([shopId, entityType, entityId])
}

model FinancialLedger {
  id             String   @id @default(cuid())
  shopId         String
  customerId     String?
  supplierId     String?
  billId         String?
  paymentId      String?
  purchaseBillId String?
  sourceType     String
  sourceId       String
  entryType      String
  direction      String
  amountPaise    BigInt
  paymentMode    String?
  businessDate   DateTime
  serverSeq      BigInt?
  idempotencyKey String
  reversedById   String?
  createdAt      DateTime @default(now())

  shop                          Shop                           @relation(fields: [shopId], references: [id])
  bankReconciliationAllocations BankReconciliationAllocation[]

  @@unique([shopId, idempotencyKey])
  @@index([shopId, businessDate])
  @@index([shopId, customerId])
  @@index([shopId, billId])
  @@index([shopId, sourceType, sourceId])
}

model BankStatementImport {
  id               String   @id @default(cuid())
  shopId           String
  accountType      String
  accountName      String
  accountLast4     String?
  fileName         String
  statementFrom    DateTime
  statementTo      DateTime
  rowCount         Int
  importedCount    Int
  duplicateCount   Int
  status           String   @default("processed")
  fingerprint      String
  importedByUserId String?
  createdAt        DateTime @default(now())

  shop         Shop                       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  transactions BankStatementTransaction[]

  @@unique([shopId, fingerprint])
  @@index([shopId, createdAt])
  @@index([shopId, accountType, statementFrom, statementTo])
}

model BankStatementTransaction {
  id                    String    @id @default(cuid())
  shopId                String
  importId              String
  rowNumber             Int
  transactionDate       DateTime
  description           String
  reference             String?
  direction             String
  amountPaise           BigInt
  balancePaise          BigInt?
  fingerprint           String
  matchStatus           String    @default("unmatched")
  reconciledAmountPaise BigInt    @default(0)
  ignoredReason         String?
  ignoredByUserId       String?
  ignoredAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  shop        Shop                           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  import      BankStatementImport            @relation(fields: [importId], references: [id], onDelete: Cascade)
  allocations BankReconciliationAllocation[]
  events      BankReconciliationEvent[]

  @@unique([shopId, fingerprint])
  @@index([shopId, transactionDate])
  @@index([shopId, matchStatus, transactionDate])
  @@index([importId, rowNumber])
}

model BankReconciliationAllocation {
  id                         String    @id @default(cuid())
  shopId                     String
  bankStatementTransactionId String
  ledgerRowId                String
  amountPaise                BigInt
  activeLedgerKey            String?   @unique
  activeBankLedgerKey        String?   @unique
  method                     String
  evidenceJson               String    @default("{}")
  status                     String    @default("active")
  matchedByUserId            String?
  matchedAt                  DateTime  @default(now())
  reversedByUserId           String?
  reversedAt                 DateTime?
  reversalReason             String?

  shop            Shop                     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  bankTransaction BankStatementTransaction @relation(fields: [bankStatementTransactionId], references: [id], onDelete: Cascade)
  ledgerRow       FinancialLedger          @relation(fields: [ledgerRowId], references: [id], onDelete: Restrict)

  @@index([shopId, status, matchedAt])
  @@index([bankStatementTransactionId, status])
  @@index([ledgerRowId, status])
}

model BankReconciliationEvent {
  id                         String   @id @default(cuid())
  shopId                     String
  bankStatementTransactionId String
  action                     String
  payloadJson                String   @default("{}")
  userId                     String?
  createdAt                  DateTime @default(now())

  shop            Shop                     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  bankTransaction BankStatementTransaction @relation(fields: [bankStatementTransactionId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@index([bankStatementTransactionId, createdAt])
}

model SyncIdMapping {
  id            String   @id @default(cuid())
  shopId        String
  entityType    String // product | customer | bill | supplier
  localId       String
  serverId      String
  sourceEventId String?
  deviceId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id])

  @@unique([shopId, entityType, localId])
  @@index([shopId, entityType, serverId])
  @@index([shopId, updatedAt, id])
}

// ─────────────────────────────────────────────
// DIAGNOSTICS — own-backend error store (grouped) + support requests.
// Errors are persisted in our own DB (in addition to Sentry) so support can
// diagnose thousands of shops remotely. shopId is nullable because pre-auth
// crashes and some backend 5xxs carry no tenant. Grouping is by a content-hash
// `fingerprint` that bakes in the shop scope, so the upsert is atomic and can
// never collide across tenants.
// ─────────────────────────────────────────────
model ErrorGroup {
  id            String   @id @default(cuid())
  shopId        String?
  fingerprint   String   @unique
  source        String // frontend | backend | worker
  title         String
  errorCode     String?
  sampleMessage String
  sampleStack   String?
  count         Int      @default(1)
  status        String   @default("open") // open | resolved | ignored
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shop   Shop?        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  events ErrorEvent[]

  @@index([shopId, lastSeenAt])
  @@index([shopId, status, lastSeenAt])
}

model ErrorEvent {
  id             String   @id @default(cuid())
  groupId        String
  shopId         String?
  userId         String?
  deviceId       String?
  orgId          String?
  source         String // frontend | backend | worker
  message        String
  stack          String?
  errorCode      String?
  endpoint       String?
  functionName   String?
  fileName       String?
  lineNumber     Int?
  appVersion     String?
  backendVersion String?
  os             String?
  browser        String?
  networkStatus  String? // online | offline
  onlineMode     Boolean?
  memoryUsageMb  Float?
  route          String?
  createdAt      DateTime @default(now())

  group ErrorGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  shop  Shop?      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@index([shopId, createdAt])
}

model SupportRequest {
  id            String   @id @default(cuid())
  shopId        String
  userId        String?
  deviceId      String?
  description   String
  page          String?
  appVersion    String?
  status        String   @default("open") // open | triaged | resolved
  contextJson   String   @default("{}") // recent errors, api requests, sync summary, device info
  screenshotKey String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, status, createdAt])
  @@index([shopId, createdAt])
}

// ─────────────────────────────────────────────
// DEVICE HEALTH — per-device runtime health snapshots (Diagnostics §4).
// Time-series; "current health" is the latest row per (shopId, deviceId).
// overallStatus/healthScore are computed server-side from the raw signals so
// dashboards and the store health score have a single source of truth.
// ─────────────────────────────────────────────
model DeviceHealthSnapshot {
  id              String   @id @default(cuid())
  shopId          String
  deviceId        String
  userId          String?
  overallStatus   String   @default("unknown") // healthy | degraded | critical | unknown
  healthScore     Int? // 0-100, server-computed
  printerStatus   String? // ready | offline | error | not_configured
  printerName     String?
  scannerStatus   String? // connected | disconnected | not_configured
  online          Boolean?
  networkType     String? // effectiveType: 4g | 3g | wifi | slow-2g …
  dbStatus        String? // ok | degraded | error
  storageUsedMb   Float?
  storageQuotaMb  Float?
  appVersion      String?
  os              String?
  browser         String?
  batteryLevel    Int? // 0-100
  batteryCharging Boolean?
  ramUsedMb       Float?
  ramLimitMb      Float?
  cpuPercent      Float?
  extraJson       String?
  createdAt       DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, deviceId, createdAt])
  @@index([shopId, createdAt])
}

// ─────────────────────────────────────────────
// REMOTE SUPPORT — consent-gated remote diagnosis and repair
// ─────────────────────────────────────────────

// A time-boxed grant that lets a platform operator look at ONE shop, and (at the
// "repair" scope) queue allowlisted commands for its devices. Without an active
// row here an operator sees only the anonymous cross-shop rollup, so remote
// access is something the owner hands out rather than something we hold.
//
// The 6-digit code the owner reads out is stored only as a peppered hash: a dump
// of this table yields no usable live codes, and redemption still resolves in a
// single indexed lookup because the hash is deterministic.
model SupportSession {
  id              String    @id @default(cuid())
  shopId          String
  grantedByUserId String?
  deviceId        String? // optional: pin the session to the one device that is broken
  codeHash        String    @unique
  scope           String    @default("diagnose") // diagnose | repair
  status          String    @default("pending") // pending | active | ended | revoked | expired
  operatorEmail   String?
  reason          String?
  redeemedAt      DateTime?
  expiresAt       DateTime
  revokedAt       DateTime?
  endedAt         DateTime?
  commandCount    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shop     Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  commands DeviceCommand[]

  @@index([shopId, status, createdAt])
  @@index([status, expiresAt])
}

// Server→device work queue. The device already polls on its sync timer, so this
// rides that loop instead of needing a socket. `type` is validated against a
// fixed catalog on the way in AND on the way out, so a row written by any means
// still cannot make a device do something outside the allowlist.
model DeviceCommand {
  id             String    @id @default(cuid())
  shopId         String
  sessionId      String? // null = automatic playbook dispatch, no human operator
  playbookId     String? // set when a playbook issued this; drives cooldown + failure streaks
  deviceId       String
  type           String
  paramsJson     String    @default("{}")
  status         String    @default("queued") // queued | delivered | applied | failed | expired | cancelled
  issuedByEmail  String?
  issuedByUserId String?
  reason         String? // shown verbatim to the owner in the activity trail
  attempts       Int       @default(0)
  deliveredAt    DateTime?
  completedAt    DateTime?
  resultJson     String?
  error          String?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  shop    Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  session SupportSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([shopId, deviceId, status, createdAt])
  @@index([shopId, status, createdAt])
  @@index([sessionId])
  @@index([shopId, deviceId, playbookId, createdAt])
}

// ─────────────────────────────────────────────
// SAAS PLANS / SUBSCRIPTIONS — Phase 6 foundation
// ─────────────────────────────────────────────
model Plan {
  id                String   @id @default(cuid())
  code              String   @unique // starter | standard | growth | pro
  name              String
  priceMonthlyPaise Int
  priceYearlyPaise  Int
  maxDevices        Int
  maxStores         Int
  maxStaff          Int
  featuresJson      String   @default("[]")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Subscription {
  id                      String    @id @default(cuid())
  shopId                  String    @unique
  planCode                String
  status                  String    @default("trial") // trial | active | grace | expired | cancelled | payment_failed
  provider                String    @default("manual") // manual | razorpay | admin
  providerSubscriptionId  String?
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  trialEndsAt             DateTime?
  graceEndsAt             DateTime?
  cancelledAt             DateTime?
  lockedPriceMonthlyPaise Int?
  lockedPriceYearlyPaise  Int?
  entitledFeaturesJson    String?
  intendedPaidPlanCode    String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  shop                Shop                 @relation(fields: [shopId], references: [id])
  paymentTransactions PaymentTransaction[]

  @@index([shopId, status])
  @@index([planCode])
}

model OnboardingPurchase {
  id               String    @id @default(cuid())
  shopId           String
  sku              String    @default("FIRST_YEAR_ONBOARDING")
  amountPaise      Int
  status           String    @default("recorded")
  includesJson     String    @default("[]")
  recordedByUserId String?
  deliveredAt      DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  shop             Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@index([sku, status])
}

model PaymentTransaction {
  id                String    @id @default(cuid())
  shopId            String
  subscriptionId    String?
  provider          String    @default("manual") // manual | razorpay | admin
  providerPaymentId String?
  amountPaise       Int
  currency          String    @default("INR")
  status            String    @default("created") // created | paid | failed | refunded
  paidAt            DateTime?
  failureReason     String?
  rawPayloadJson    String?
  createdAt         DateTime  @default(now())

  shop         Shop          @relation(fields: [shopId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([shopId, createdAt])
  @@index([subscriptionId])
  @@index([provider, providerPaymentId])
}

model PaymentProviderEvent {
  id                  String    @id @default(cuid())
  shopId              String?
  provider            String
  eventId             String
  eventType           String
  payloadJson         String
  signatureVerified   Boolean   @default(false)
  processingStatus    String    @default("received") // received | processing | processed | failed | ignored | duplicate
  processingAttempts  Int       @default(0)
  processingError     String?
  processedResultJson String?
  lastAttemptAt       DateTime?
  processedAt         DateTime?
  createdAt           DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([shopId, createdAt])
  @@index([provider, eventType, createdAt])
  @@index([processingStatus, createdAt])
}

// External integration credentials are stored as irreversible hashes. The
// plaintext token is shown exactly once when it is created.
model IntegrationApiKey {
  id              String    @id @default(cuid())
  shopId          String
  name            String
  keyPrefix       String
  keyHash         String    @unique
  scopesJson      String    @default("[]")
  createdByUserId String?
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, revokedAt, createdAt])
}

// Webhook secrets are derived server-side from the endpoint id and the
// deployment signing secret, so no recoverable secret is stored in the DB.
model WebhookEndpoint {
  id              String    @id @default(cuid())
  shopId          String
  name            String
  url             String
  eventsJson      String    @default("[]")
  enabled         Boolean   @default(true)
  deletedAt       DateTime?
  createdByUserId String?
  lastSuccessAt   DateTime?
  lastFailureAt   DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shop       Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([shopId, deletedAt, enabled, createdAt])
}

model WebhookDelivery {
  id              String    @id @default(cuid())
  shopId          String
  endpointId      String
  eventId         String
  eventType       String
  payloadJson     String
  status          String    @default("pending") // pending | delivered | failed
  attemptCount    Int       @default(0)
  httpStatus      Int?
  durationMs      Int?
  responseSnippet String?
  lastError       String?
  lastAttemptAt   DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime  @default(now())

  shop     Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, eventId])
  @@index([shopId, createdAt])
  @@index([endpointId, status, createdAt])
}

// ─────────────────────────────────────────────
// DEVICE FOUNDATION — backend remains final authority
// ─────────────────────────────────────────────
model Device {
  id                   String    @id @default(cuid())
  shopId               String
  userId               String?
  deviceId             String
  deviceName           String?
  platform             String?
  deviceType           String?
  operatingSystem      String?
  browser              String?
  userAgent            String?
  appVersion           String?
  fingerprintHash      String?
  status               String    @default("active") // active | logged_out | blocked | revoked
  isTrusted            Boolean   @default(false)
  activatedAt          DateTime?
  lastActiveAt         DateTime?
  lastLoginAt          DateTime?
  lastSeenAt           DateTime?
  lastSyncAt           DateTime?
  lastAppliedServerSeq Int?
  lastSyncAckAt        DateTime?
  lastIpAddress        String?
  sessionVersion       Int       @default(1)
  dataEpoch            Int       @default(0)
  removedAt            DateTime?
  revokedAt            DateTime?
  revokedByUserId      String?
  revokeReason         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  shop     Shop      @relation(fields: [shopId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])
  sessions Session[]

  @@unique([shopId, deviceId])
  @@index([shopId, status])
  @@index([shopId, lastSeenAt])
  @@index([shopId, lastSyncAckAt])
  @@index([shopId, lastAppliedServerSeq])
  @@index([userId])
}

model DeviceReplacementChallenge {
  id          String    @id @default(cuid())
  shopId      String
  userId      String
  newDeviceId String
  deviceJson  String    @default("{}")
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  shop Shop @relation(fields: [shopId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([shopId, expiresAt])
  @@index([userId, consumedAt])
}

model DeviceLicense {
  id                String    @id @default(cuid())
  shopId            String
  deviceId          String
  planCode          String
  featuresJson      String    @default("[]")
  validUntil        DateTime
  offlineGraceUntil DateTime
  signatureHash     String?
  issuedAt          DateTime  @default(now())
  revokedAt         DateTime?

  shop Shop @relation(fields: [shopId], references: [id])

  @@index([shopId, deviceId])
  @@index([validUntil])
}

// ─────────────────────────────────────────────
// FINANCIAL ASSURANCE ENGINE — continuous financial-control monitoring.
// These tables store findings, evidence and review trails ABOUT canonical
// transactions; they are strictly read-only toward financial truth and are
// never a source for balances, stock or reports. Findings are never deleted;
// status history rows are append-only. See docs/AI_AUDIT_ARCHITECTURE.md.
// ─────────────────────────────────────────────
model AuditRule {
  id              String   @id @default(cuid())
  shopId          String
  ruleCode        String
  enabled         Boolean  @default(true)
  weightOverride  Int?
  thresholdsJson  String   @default("{}")
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, ruleCode])
  @@index([shopId, enabled])
}

model AuditRun {
  id                String    @id @default(cuid())
  shopId            String
  runType           String // TRANSACTION_TRIGGERED | SCHEDULED | MANUAL
  status            String    @default("RUNNING") // RUNNING | COMPLETED | FAILED | PARTIAL
  engineVersion     String
  rulesetVersion    String
  scopeJson         String    @default("{}")
  periodFrom        DateTime?
  periodTo          DateTime?
  entitiesEvaluated Int       @default(0)
  findingsCreated   Int       @default(0)
  findingsUpdated   Int       @default(0)
  summaryJson       String    @default("{}")
  error             String?
  triggeredByUserId String?
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  shop        Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  evaluations AuditEvaluation[]

  @@index([shopId, createdAt])
  @@index([shopId, status, createdAt])
  @@index([shopId, runType, createdAt])
}

// Immutable record of one deterministic evaluation of one entity: the input
// snapshot hash plus the full result JSON make every risk score reproducible
// even after the underlying transaction is later edited.
model AuditEvaluation {
  id                     String   @id @default(cuid())
  shopId                 String
  auditRunId             String
  sourceEntityType       String
  sourceEntityId         String
  inputHash              String
  engineVersion          String
  rulesetVersion         String
  triggeredRuleCodesJson String   @default("[]")
  riskScore              Int      @default(0)
  resultJson             String   @default("{}")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  shop Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  run  AuditRun @relation(fields: [auditRunId], references: [id], onDelete: Cascade)

  @@unique([auditRunId, sourceEntityType, sourceEntityId])
  @@index([shopId, sourceEntityType, sourceEntityId, createdAt])
  @@index([shopId, createdAt])
}

model AuditFinding {
  id                 String    @id @default(cuid())
  shopId             String
  dedupeKey          String // `${sourceEntityType}:${sourceEntityId}` — one finding per entity
  sourceEntityType   String
  sourceEntityId     String
  sourceEventType    String?
  firstAuditRunId    String?
  lastAuditRunId     String?
  lastEvaluationId   String?
  title              String
  status             String    @default("OPEN") // OPEN | EVIDENCE_REQUESTED | UNDER_REVIEW | CONFIRMED_ISSUE | FALSE_POSITIVE | CORRECTED | ACCEPTED_RISK | CLOSED
  primaryCategory    String?
  riskScore          Int       @default(0)
  riskLevel          String    @default("LOW") // LOW | MEDIUM | HIGH | CRITICAL
  confidence         Float     @default(1)
  // amountPaise = size of the record involved (drives materiality banding).
  // discrepancyPaise = the money actually in question (the shortfall, drift or
  // difference a rule measured). Dashboards and reports must total the second:
  // summing record sizes across entity types double-counts the same rupee and
  // mixes inventory valuation with cash. Null = no rule quantified a gap.
  amountPaise        BigInt?
  discrepancyPaise   BigInt?
  scoreBreakdownJson String    @default("{}")
  aiExplanation      String?
  aiExplanationLang  String?
  assignedReviewerId String?
  occurredAt         DateTime?
  resolvedAt         DateTime?
  resolutionType     String?
  reopenCount        Int       @default(0)
  engineVersion      String
  rulesetVersion     String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  shop                 Shop                        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  rules                AuditFindingRule[]
  evidence             AuditEvidence[]
  evidenceRequirements AuditEvidenceRequirement[]
  statusHistory        AuditFindingStatusHistory[]
  reviews              AuditReview[]
  caseLinks            AuditCaseFinding[]

  @@unique([shopId, dedupeKey])
  @@index([shopId, status, createdAt])
  @@index([shopId, riskLevel, status])
  @@index([shopId, sourceEntityType, sourceEntityId])
  @@index([shopId, assignedReviewerId, status])
  @@index([shopId, createdAt])
}

model AuditFindingRule {
  id                String   @id @default(cuid())
  shopId            String
  findingId         String
  ruleCode          String
  ruleVersion       Int
  category          String
  severity          String
  scoreContribution Int
  detailsJson       String   @default("{}")
  active            Boolean  @default(true) // still triggering as of the last evaluation
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  shop    Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  finding AuditFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@unique([findingId, ruleCode])
  @@index([shopId, ruleCode, createdAt])
}

model AuditEvidenceRequirement {
  id                String    @id @default(cuid())
  shopId            String
  findingId         String
  evidenceType      String
  description       String
  status            String    @default("REQUESTED") // REQUESTED | PROVIDED | VERIFIED | REJECTED | INSUFFICIENT | NOT_APPLICABLE
  requestedByUserId String?
  dueAt             DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  shop     Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  finding  AuditFinding    @relation(fields: [findingId], references: [id], onDelete: Cascade)
  evidence AuditEvidence[]

  @@index([shopId, status, createdAt])
  @@index([findingId])
}

model AuditEvidence {
  id                    String    @id @default(cuid())
  shopId                String
  findingId             String
  requirementId         String?
  evidenceType          String
  referenceKind         String    @default("text") // text | reference | url | file | transaction_ref
  referenceValue        String
  originalFilename      String?
  mimeType              String?
  sizeBytes             Int?
  checksumSha256        String?
  storageKey            String?
  uploadedByUserId      String?
  verificationStatus    String    @default("PROVIDED") // PROVIDED | VERIFIED | REJECTED | INSUFFICIENT | NOT_APPLICABLE
  verifiedByUserId      String?
  verifiedAt            DateTime?
  extractedMetadataJson String    @default("{}")
  reviewerNotes         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  shop        Shop                      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  finding     AuditFinding              @relation(fields: [findingId], references: [id], onDelete: Cascade)
  requirement AuditEvidenceRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  @@index([shopId, findingId, createdAt])
  @@index([shopId, verificationStatus, createdAt])
}

// Append-only: rows are created on every finding status transition and never
// updated or deleted. updatedAt exists for model-shape consistency only.
model AuditFindingStatusHistory {
  id              String   @id @default(cuid())
  shopId          String
  findingId       String
  previousStatus  String?
  newStatus       String
  changedByUserId String?
  changedByRole   String?
  comment         String?
  evidenceId      String?
  approvalLevel   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shop    Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  finding AuditFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([shopId, findingId, createdAt])
  @@index([shopId, createdAt])
}

model AuditReview {
  id             String   @id @default(cuid())
  shopId         String
  findingId      String
  reviewerUserId String?
  reviewerRole   String?
  decision       String // CONFIRMED_ISSUE | FALSE_POSITIVE | ACCEPTED_RISK | CORRECTED | NEEDS_MORE_EVIDENCE
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shop    Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  finding AuditFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([shopId, findingId, createdAt])
}

model AuditCase {
  id              String    @id @default(cuid())
  shopId          String
  title           String
  summary         String?
  status          String    @default("OPEN") // OPEN | UNDER_REVIEW | CLOSED
  riskLevel       String    @default("LOW")
  createdByUserId String?
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shop     Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  findings AuditCaseFinding[]

  @@index([shopId, status, createdAt])
}

model AuditCaseFinding {
  id        String   @id @default(cuid())
  shopId    String
  caseId    String
  findingId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop    Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  case    AuditCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  finding AuditFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@unique([caseId, findingId])
  @@index([shopId, findingId])
}

// Shop-specific behavioral baselines from robust statistics. INSUFFICIENT_DATA
// baselines must never contribute to a risk score.
model AuditBaseline {
  id             String   @id @default(cuid())
  shopId         String
  metricKey      String
  scopeKey       String   @default("global")
  windowDays     Int      @default(90)
  sampleCount    Int      @default(0)
  minimumSamples Int      @default(30)
  status         String   @default("INSUFFICIENT_DATA") // OK | INSUFFICIENT_DATA
  median         Float?
  p25            Float?
  p75            Float?
  p90            Float?
  p99            Float?
  mean           Float?
  statsJson      String   @default("{}")
  computedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, metricKey, scopeKey])
  @@index([shopId, computedAt])
}

// ─────────────────────────────────────────────
// USER ACTIVITY & PERSONALIZATION (§13)
//
// ActivityEvent is the append-only fact table: one row per meaningful user
// action, in the POS or in an online customer session. It is behavioural
// telemetry and never a financial record — nothing here is authoritative for
// money, stock or tax, and losing a row must not change a business outcome.
//
// ActivityAggregate is the read model. Recomputing "the 10 products this user
// bills most" from millions of raw events on every keystroke is not viable on a
// counter PC, so ingest folds each event into a small set of counters that the
// personalization endpoints read directly.
// ─────────────────────────────────────────────
model ActivityEvent {
  id            String   @id @default(cuid())
  // Client-generated id, unique so a retried offline batch cannot double-count.
  eventId       String   @unique
  shopId        String
  userId        String?
  orgId         String?
  deviceId      String?
  sessionId     String?
  eventType     String
  module        String   @default("other")
  screen        String?
  appVersion    String?
  networkStatus String? // online | offline
  source        String   @default("pos") // pos | online | server
  durationMs    Int?
  // Sanitized, size-capped event-specific fields (query, results, productId, …).
  metadataJson  String   @default("{}")
  // When it happened on the device. Distinct from createdAt (ingest time)
  // because an offline device can deliver the same batch hours later.
  occurredAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, occurredAt])
  @@index([shopId, eventType, occurredAt])
  @@index([shopId, userId, occurredAt])
  @@index([shopId, sessionId])
}

model ActivityAggregate {
  id     String  @id @default(cuid())
  shopId String
  // The owning user, or the sentinel "*" for a shop-wide rollup (trending
  // products, shop feature adoption). A sentinel rather than NULL because both
  // SQLite and Postgres treat NULLs as distinct in a unique index, which would
  // silently let every shop-wide upsert insert a duplicate row instead of
  // incrementing the existing one.
  userId String  @default("*")
  // product_billed | product_searched | search_query | report | customer |
  // payment_method | filter | page | online_product_view | feature | task_time
  kind   String
  key    String // the thing being counted (productId, report slug, query text…)
  label  String? // display text captured at write time, so reads need no join

  count           Int   @default(0)
  // Half-life decayed score. Raw counts let a product billed 500 times last year
  // outrank one billed 30 times this week; the decay keeps suggestions current.
  score           Float @default(0)
  // Summed duration, for "which tasks consume the most time" and the averages.
  totalMs         Int   @default(0)
  durationSamples Int   @default(0)

  metaJson    String   @default("{}")
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId, kind, key])
  @@index([shopId, kind, score])
  @@index([shopId, userId, kind, lastSeenAt])
}

// ─────────────────────────────────────────────
// CLOTH RENTAL — a garment booked out for a run of days
//
// A booking reserves stock without moving it: the lehenga stays in the product
// catalogue at its full owned count, and an open booking holds N of it for the
// days it is promised to someone. Availability for any window is therefore
//   owned count − Σ qty of active bookings whose [fromDate, toDate] overlaps it
// which is what takes a booked outfit off the customer-facing catalogue for
// exactly the days it is out, and puts it back the day after it returns.
//
// Both dates are day-granular and stored as the shop-timezone day boundaries
// (fromDate = 00:00:00.000, toDate = 23:59:59.999) so an overlap test is a
// plain comparison with no timezone drift — see utils/dates.js.

model RentalBooking {
  id            String @id @default(cuid())
  shopId        String
  bookingNumber String

  // The renter is captured on the booking itself, not only through a Customer
  // row: a rental is usually a one-off walk-in the shop never bills again, and
  // the address/phone must keep saying who took THIS outfit even if the linked
  // customer record is edited or the walk-in is never saved as a customer.
  customerId      String?
  customerName    String
  customerPhone   String
  customerAddress String  @default("")
  idProofType     String? // aadhaar | pan | driving_licence | voter_id | other
  idProofNumber   String?

  fromDate   DateTime // first day the garment is out (inclusive)
  toDate     DateTime // day it is due back (inclusive)
  returnedAt DateTime?
  // booked → picked_up → returned. cancelled is terminal from either open state.
  status     String    @default("booked")

  rentAmount    Float @default(0)
  depositAmount Float @default(0) // refundable security taken at pickup
  advancePaid   Float @default(0)
  lateFee       Float @default(0)
  damageCharge  Float @default(0)

  notes           String?
  createdByUserId String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shop  Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items RentalBookingItem[]

  @@unique([shopId, bookingNumber])
  @@index([shopId, deletedAt])
  // The availability scan: active bookings whose window covers a date.
  @@index([shopId, status, fromDate, toDate])
  // "What is due back today / already overdue?"
  @@index([shopId, status, toDate])
  @@index([shopId, customerPhone])
}

model RentalBookingItem {
  id        String  @id @default(cuid())
  bookingId String
  // Deliberately NOT a foreign key. The line is the record of what was physically
  // handed over, so it has to survive the product being purged from the catalogue;
  // a null/dangling productId simply stops holding availability.
  productId String?

  // Copied at booking time so renaming or deleting a product never rewrites what
  // an old booking says went out of the door.
  name       String
  unit       String @default("piece")
  qty        Float  @default(1)
  ratePerDay Float  @default(0)
  amount     Float  @default(0)

  booking RentalBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([productId])
}

// ── Pharmacy prescription register ───────────────────────────────────────────
// The statutory register a chemist has to produce on inspection: who prescribed
// it, for whom, what was actually handed over, and against which bill. Schedule
// H/H1/X drugs may not be sold without it, so this is the one record a pharmacy
// cannot run without — and the only one no other trade in the app needs.
//
// Not synced to devices. A register entry is written once at the counter that
// dispensed it and read back rarely, so it is online-first like rentals rather
// than another table in every device's offline mirror.

model Prescription {
  id             String @id @default(cuid())
  shopId         String
  registerNumber String

  // The prescriber. Name plus registration number is what an inspector checks,
  // so the number is recorded separately rather than buried in a notes field.
  doctorName   String
  doctorRegNo  String?
  doctorClinic String?

  // The patient is captured on the prescription itself, not only through a
  // Customer row: most are one-off walk-ins the shop never bills again, and the
  // register must keep saying who THIS medicine went to even if a linked
  // customer record is later edited or was never saved at all.
  customerId     String?
  patientName    String
  patientPhone   String  @default("")
  // Free text, not a number: paediatric entries are written "6 months".
  patientAge     String?
  patientGender  String? // male | female | other
  patientAddress String  @default("")

  // h | h1 | x | otc | other — which schedule the strictest drug on this slip
  // falls under, since that decides how long the entry must be retained.
  scheduleType String    @default("h")
  prescribedOn DateTime // the date written on the doctor's slip
  dispensedAt  DateTime? // when the shop actually handed the medicine over
  status       String    @default("pending") // pending | dispensed | cancelled

  // The bill the medicines went out on, when there is one. Deliberately not a
  // foreign key: the register entry is the legal record and has to survive the
  // bill being cancelled or purged. billNumber is copied for the same reason.
  billId     String?
  billNumber String?

  // A repeat prescription may be dispensed more than once. Counting refills is
  // what stops the same slip being used indefinitely.
  refillsAllowed Int @default(0)
  refillsUsed    Int @default(0)

  imageUrl        String? // photo of the paper slip (data URL or hosted URL)
  notes           String?
  createdByUserId String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shop  Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items PrescriptionItem[]

  @@unique([shopId, registerNumber])
  @@index([shopId, deletedAt])
  // The register as an inspector reads it: by date, newest first.
  @@index([shopId, prescribedOn])
  // "What is still waiting to be dispensed?" and the schedule-wise register.
  @@index([shopId, status, prescribedOn])
  @@index([shopId, scheduleType, prescribedOn])
  // Counter lookups: the patient in front of you, or a doctor's slips.
  @@index([shopId, patientPhone])
  @@index([shopId, billId])
}

model PrescriptionItem {
  id             String  @id @default(cuid())
  prescriptionId String
  // Deliberately NOT a foreign key. The line is the record of what was
  // physically dispensed, so it has to survive the medicine being purged from
  // the catalogue.
  productId      String?

  // Copied at dispense time so renaming or deleting a product never rewrites
  // what an old register entry says went out of the door.
  name           String
  strength       String? // "500 mg", "5 ml"
  dosage         String? // as written: "1-0-1 for 5 days"
  qty            Float   @default(1)
  unit           String  @default("strip")
  batchNumber    String? // the lot actually handed over, for a recall trace
  // Set when a generic went out against a brand written on the slip. The
  // register has to show the substitution, not hide it.
  substitutedFor String?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@index([productId])
}

// ── Electronics: serialised units ────────────────────────────────────────────
// Stock here is not fungible. The shop does not sell "a Galaxy A16", it sells
// THAT handset, and a return, a warranty claim or a police enquiry has to find
// the same physical unit again months later. Every other trade in the app counts
// stock as a number; this one has to name each piece of it.
//
// A unit is deliberately NOT a replacement for Product.stockBaseQty — the
// product still carries the count that billing and reports read. This table
// answers "which one, and where did it go", which a count cannot.
//
// Not synced to devices: a unit is written once when the box is opened and read
// by lookup, so it is online-first like rentals and the prescription register.

model ProductUnit {
  id     String @id @default(cuid())
  shopId String

  // Deliberately NOT a foreign key, and the name is copied. The unit is the
  // record of a physical thing that left the shop; it has to outlive the
  // catalogue row being renamed or purged, exactly like a bill line.
  productId   String
  productName String

  // What is stamped on the box. A phone carries an IMEI (two, on a dual-SIM
  // handset) and usually a serial as well; a laptop or a mixer has only a
  // serial. At least one is required — a unit nobody can identify is just stock.
  imei         String?
  imei2        String?
  serialNumber String?

  // in_stock → sold → returned. rma is "away with the service centre", and
  // lost/scrapped are terminal write-offs.
  status    String @default("in_stock")
  // new | open_box | refurbished. Open-box is a real shelf category here: a
  // returned handset cannot go back to the pile as new.
  condition String @default("new")

  // Where it came from.
  purchaseBillId String?
  supplierId     String?
  costPrice      Float    @default(0)
  receivedAt     DateTime @default(now())

  // Where it went. billId is not a foreign key for the same reason as above —
  // the unit's history must survive the bill being cancelled or purged.
  billId        String?
  billNumber    String?
  customerId    String?
  customerName  String?
  customerPhone String    @default("")
  soldAt        DateTime?
  sellingPrice  Float     @default(0)

  // Warranty is stored as an absolute end date rather than only a duration:
  // the shop's policy can change next year, and this unit's cover cannot.
  warrantyMonths Int       @default(0)
  warrantyUntil  DateTime?

  notes           String?
  createdByUserId String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // Two units in one shop may never share an identifier. NULLs are distinct in
  // both SQLite and PostgreSQL, so a laptop with no IMEI does not collide with
  // every other laptop that has none.
  @@unique([shopId, imei])
  @@unique([shopId, serialNumber])
  // The counter's lookup — someone puts a handset on the counter and asks.
  @@index([shopId, imei2])
  @@index([shopId, status])
  @@index([shopId, productId, status])
  @@index([shopId, billId])
  @@index([shopId, customerPhone])
  // "What cover is about to run out?"
  @@index([shopId, warrantyUntil])
}

// ── Auto parts: vehicle fitment and cross-references ─────────────────────────
// The question this trade lives on is "does this fit?", and nothing in the
// shared catalogue can answer it: a part number means nothing to a customer who
// says "Swift, 2015, diesel". Today the advice is to type that into the product
// notes, which no query can read.
//
// A fitment is a claim that one product fits one vehicle over a range of years.
// A part has many, and a vehicle takes many parts, so this is deliberately its
// own table rather than a column on Product.

model PartFitment {
  id     String @id @default(cuid())
  shopId String

  // Deliberately NOT a foreign key, and the name is copied. The claim is
  // reference data the shop built up over years; it must survive a product
  // being renamed or repurchased under a new row.
  productId   String
  productName String

  make    String // Maruti Suzuki
  model   String // Swift
  variant String? // "Diesel 1.3 DDiS", "VXi" — null means every variant

  // An open-ended range. yearFrom null = "since forever", yearTo null = "still
  // current", which is the common case for a part in production.
  yearFrom Int?
  yearTo   Int?

  notes     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // The counter query: "what fits a Swift?" — make and model together, because
  // a model name alone is not unique across makers.
  @@index([shopId, make, model])
  // "What does this part fit?", read from the product side.
  @@index([shopId, productId])
  @@index([shopId, make])
}

// What else will do when the part the customer wants is not on the shelf.
//
// The other side may be a product in this catalogue or just a number the shop
// knows about — an OEM code they have never stocked. Both are worth recording,
// because "we don't have it but this one fits" is a sale either way.
model PartCrossReference {
  id     String @id @default(cuid())
  shopId String

  productId   String
  productName String

  // Set only when the alternative is something the shop actually stocks.
  alternateProductId String?
  // Always set: the number written on the box, whether or not it is stocked.
  partNumber         String
  brand              String?
  // oem            — the manufacturer's own number for this part
  // alternative    — a different brand that does the same job
  // supersedes     — this part replaces the referenced one
  // superseded_by  — this part has been replaced by the referenced one
  kind               String  @default("alternative")

  notes     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, productId])
  // "Someone read me a number off a box" — the lookup that does not start from
  // a product at all.
  @@index([shopId, partNumber])
}

// ── Footwear: which size system a style is sold in ───────────────────────────
// A shoe is sold by the pair in a size *system*, and "8" means three different
// shoes in UK, EU and US. The size run itself is ordinary variant machinery —
// a Size axis on the Product, one ProductSellingUnit per size holding its own
// stock — so nothing here duplicates that. What cannot be derived is which
// scale the numbers on those variants are written in, and that is all this
// table records.
//
// One row per style, not per size. A style is sold in one system.

model FootwearSizeProfile {
  id     String @id @default(cuid())
  shopId String

  // Deliberately NOT a foreign key, and the name is copied — consistent with the
  // other trade registers, so the profile survives a catalogue row being renamed.
  productId   String
  productName String

  // uk | us | eu | cm. India uses UK numbering, so it is not a separate system.
  sizeSystem String  @default("uk")
  // mens | womens | kids | unisex — the conversion between systems differs by
  // last, so a UK 6 women's is not a UK 6 men's.
  gender     String  @default("unisex")
  // "D", "2E", "Narrow" — recorded for the shops that stock width fittings and
  // ignored by everyone else.
  widthFit   String?

  notes     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, productId])
  @@index([shopId, deletedAt])
}

// ── Stationery: class book lists ─────────────────────────────────────────────
// A book shop's whole year turns on one document: the school publishes the Class
// 6 list, a parent walks in and says "Class 6, DPS", and the counter assembles
// eleven books, four notebooks and a geometry box from a sheet taped to the wall.
// Nothing in the app can hold that today, so the list lives on paper and the
// shop finds out what it is short of when a parent is already standing there.
//
// A list is a recipe, not stock and not an order: it names what a class needs,
// and readiness is computed against the live catalogue every time it is read.

model BookList {
  id     String @id @default(cuid())
  shopId String

  schoolName   String
  className    String
  // "2026-27" — Indian academic years straddle two calendar years, so a single
  // year number would be ambiguous every April.
  academicYear String
  // Optional label for the case one class has two lists ("Science stream").
  // Empty rather than null on purpose: NULLs are DISTINCT in a unique index on
  // both SQLite and PostgreSQL, so a nullable column here would let the same
  // class be entered twice — the exact duplicate the index exists to stop.
  name         String @default("")

  notes    String?
  // Last year's list stays on the books for reference but should not be offered
  // at the counter, which is what this separates.
  isActive Boolean @default(true)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  shop  Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items BookListItem[]

  @@unique([shopId, schoolName, className, academicYear, name])
  @@index([shopId, deletedAt])
  // The counter lookup: "Class 6, DPS".
  @@index([shopId, schoolName, className])
  @@index([shopId, academicYear])
}

model BookListItem {
  id     String @id @default(cuid())
  listId String

  // Deliberately NOT a foreign key, and the name is copied. A list is a document
  // the school published: it has to keep naming the book even after the shop
  // stops stocking it, and a null productId is exactly how "we don't carry this"
  // is recorded rather than a missing row.
  productId String?
  name      String

  qty        Float   @default(1)
  unit       String  @default("piece")
  // Drawing books and the second geometry box are on many lists as optional;
  // counting them as shortfalls would make every list look unfulfillable.
  isOptional Boolean @default(false)

  notes     String?
  // Lists are read aloud in order — subject by subject — so the order the school
  // published them in is part of the document.
  sortOrder Int     @default(0)

  list BookList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId])
  @@index([productId])
}

// ── Furniture: the sales order ───────────────────────────────────────────────
// The only trade in the app where the sale usually happens before the goods
// exist or leave the floor. A showroom quotes, takes an advance, has the piece
// made or reserved, delivers it weeks later and installs it — and for that whole
// stretch the money and the goods are in different places. A bill cannot hold
// that, because a bill is the moment both change hands at once.
//
// The order is NOT a bill. It carries no tax treatment and settles nothing; when
// the piece finally goes out the shop rings an ordinary bill and links it here.
// What this holds is the promise: what was agreed, what has been paid against
// it, and when it was said to arrive.

model FurnitureOrder {
  id          String @id @default(cuid())
  shopId      String
  orderNumber String

  // The buyer is captured on the order itself, like a rental's renter: a
  // showroom sale is often a one-off, and the delivery address must keep saying
  // where THIS wardrobe went even if the customer record is later edited.
  customerId      String?
  customerName    String
  customerPhone   String  @default("")
  deliveryAddress String  @default("")

  // quote → confirmed → in_production → ready → delivered → installed.
  // cancelled is terminal from any open state. Transitions are enforced in the
  // service; a showroom that does not install simply stops at delivered.
  status String @default("quote")

  // Money. grandTotal is computed from the lines and charges server-side, so a
  // client cannot disagree with the arithmetic it will later be billed on.
  itemsTotal     Float @default(0)
  discount       Float @default(0)
  deliveryCharge Float @default(0)
  installCharge  Float @default(0)
  grandTotal     Float @default(0)

  quotedOn    DateTime
  // What the customer was told. The single most chased number in this trade.
  promisedOn  DateTime?
  deliveredAt DateTime?
  installedAt DateTime?

  // Made to order rather than sold off the floor — nothing to reserve, and the
  // lead time is real production time.
  isCustom Boolean @default(false)

  // The bill raised when the goods finally went out. Not a foreign key: the
  // order is the record of the promise and outlives a cancelled bill.
  billId     String?
  billNumber String?

  notes           String?
  createdByUserId String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shop     Shop                    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items    FurnitureOrderItem[]
  payments FurnitureOrderPayment[]

  @@unique([shopId, orderNumber])
  @@index([shopId, deletedAt])
  // "What is open, and what is due?" — the two questions a showroom asks daily.
  @@index([shopId, status, promisedOn])
  @@index([shopId, customerPhone])
  @@index([shopId, quotedOn])
}

model FurnitureOrderItem {
  id      String @id @default(cuid())
  orderId String

  // Null for a made-to-order piece that is not in the catalogue at all — which
  // is most of what this trade sells to order.
  productId String?
  name      String
  // "Teak, 6ft, walnut finish" — the spec a carpenter works from.
  variant   String?

  qty    Float @default(1)
  rate   Float @default(0)
  amount Float @default(0)

  // Whether this line holds a piece off the floor while the order is open. False
  // for anything being made: there is nothing on the floor to hold.
  reserveStock Boolean @default(true)

  notes String?

  order FurnitureOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

// Advances against an order. Several are normal — a booking amount, a second
// instalment when production starts, the balance on delivery — so this is a
// child table rather than one "advancePaid" column that could only ever hold
// the last one.
model FurnitureOrderPayment {
  id      String @id @default(cuid())
  orderId String

  amount    Float    @default(0)
  mode      String   @default("cash") // cash | upi | bank | card | other
  paidOn    DateTime
  reference String? // UPI ref, cheque number
  notes     String?

  createdByUserId String?
  createdAt       DateTime @default(now())

  order FurnitureOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ── Cosmetics: tester stock ──────────────────────────────────────────────────
// A tester is a unit opened for customers to try, and it will never be sold.
// Counted as sellable it makes the shelf wrong in three ways at once: the shop
// thinks it has stock it cannot sell, the missing units surface later as
// shrinkage that looks like theft, and nobody ever finds out what testers cost —
// which in this trade is a real line of expenditure hidden inside "loss".
//
// Opening a tester therefore moves stock out through the ordinary inventory
// path, and this table is the record of where it went and when it is due to be
// replaced.

model TesterUnit {
  id     String @id @default(cuid())
  shopId String

  // Deliberately NOT a foreign key, and the name is copied — consistent with the
  // other trade registers, so the record survives a catalogue row being renamed.
  productId   String
  productName String
  // The shade. A tester is opened per shade, not per product: "Matte Lipstick"
  // has twelve of them on the counter and they wear out at different rates.
  variant     String?

  // in_use → replaced (a fresh one went out) or discarded (thrown away, none
  // put back). Both are terminal; a new tester is a new row.
  status       String    @default("in_use")
  openedOn     DateTime
  // How long this tester is expected to last on the counter before it is grubby,
  // dried out or empty. Per tester, because a mascara and a lipstick differ.
  expectedDays Int       @default(90)
  closedOn     DateTime?

  // What the unit cost the shop. Snapshotted at opening rather than read live,
  // because the point of the figure is what testers cost over a period, and a
  // later price change must not rewrite last quarter's number.
  costValue Float @default(0)

  // The stock movement this tester came out of, when one was made. Null when the
  // shop recorded a tester it had already taken off the shelf by hand.
  stockLedgerId String?

  notes           String?
  createdByUserId String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, deletedAt])
  // "What is on the counter, and what needs replacing?"
  @@index([shopId, status, openedOn])
  @@index([shopId, productId, status])
}

// ─────────────────────────────────────────────
// RESTAURANT — the floor and the recipe book
// ─────────────────────────────────────────────

// A table on the restaurant floor.
//
// The floor plan used to live only in the till's own IndexedDB, which was fine
// while the only reader was the till. A QR code stuck to table 5 is read by a
// stranger's phone, and that phone talks to the server — which knew nothing
// about table 5. So the floor plan is a shop record now: the server can answer
// "is this a real table here, and what is it called" without trusting anything
// printed on the sticker.
//
// `code` is what the QR carries. It is short and human-checkable (t5,
// terrace-2) because a waiter has to be able to read it off a curling sticker,
// and it is deliberately not a secret: it names a piece of furniture in a public
// room. The protection that matters is that a guest can only ever add to their
// own table's order — never see a bill, a total, or another table.
model RestaurantTable {
  id         String  @id @default(cuid())
  shopId     String
  // Which branch's floor this table is on. Null means the shop's primary
  // location, which is every single-outlet restaurant.
  locationId String?

  code    String // printed on the QR sticker: "t5", "terrace-2"
  name    String // what the staff call it: "T5", "Terrace 2"
  section String @default("Dining") // "Ground floor", "Terrace", "AC hall"
  seats   Int    @default(4)

  // Ordering from this table's QR, independently of the shop-wide switch: a
  // restaurant can open the terrace to self-ordering and keep the private room
  // on waiter service.
  selfOrderEnabled Boolean @default(true)
  active           Boolean @default(true)
  sortOrder        Int     @default(0)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  shop     Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  location StoreLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  // One sticker, one table. The guard that stops a mistyped code silently
  // pointing two tables at the same order.
  @@unique([shopId, code])
  @@index([shopId, deletedAt])
  @@index([shopId, section, sortOrder])
  @@index([shopId, locationId, active])
}

// One ingredient of one dish — the line that turns "we sold 4 butter chickens"
// into "we are down 600 g of butter".
//
// Without this a restaurant's stock figures are fiction: the POS decrements the
// dish, and the dish is not a thing anybody buys or stores. The kitchen buys
// chicken, cream and butter, and those are what run out mid-service.
//
// Neither product id is a foreign key, consistent with the other trade
// registers: a recipe must survive its dish being renamed, and an ingredient
// being replaced by an equivalent one, without cascading a delete through the
// kitchen's costing history.
//
// Rows are deleted outright rather than soft-deleted. A recipe line is
// configuration, not history — and a soft-deleted row would sit inside the
// unique index below, silently refusing to let the cook add the ingredient back.
model DishRecipeComponent {
  id     String @id @default(cuid())
  shopId String

  dishProductId       String
  ingredientProductId String
  ingredientName      String // copied so a costing report reads without a join

  // Ingredient consumed per ONE portion of the dish, in the ingredient's own
  // base unit (g, ml, piece) — the same unit stock is kept in, so depletion is a
  // subtraction with no conversion to get wrong.
  qtyBase    Float   @default(0)
  // Trim, spillage and the bit left in the pan, as a percentage on top of qtyBase.
  wastagePct Float   @default(0)
  // An ingredient the dish can be served without (a garnish). Excluded from
  // "can the kitchen still make this?", so a shop that has run out of coriander
  // is not told it cannot serve dal.
  optional   Boolean @default(false)
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, dishProductId, ingredientProductId])
  @@index([shopId, dishProductId])
  // "What else uses paneer?" — asked whenever an ingredient runs low.
  @@index([shopId, ingredientProductId])
}

// A kitchen ticket (KOT) — what the pass is actually working off.
//
// This lives on the server rather than on the till because the kitchen display
// is a DIFFERENT DEVICE from the counter that fires it. Held device-locally, a
// ticket never reached the screen it was written for.
//
// tableId and billId are deliberately NOT foreign keys. A table's order is the
// parked HeldBill on the till taking it, whose id is local to that device; the
// server only groups by it. That also lets a ticket outlive the sitting it came
// from, which is what a kitchen record is for.
model KitchenTicket {
  id         String  @id @default(cuid())
  shopId     String
  locationId String?

  // Per-shop, server-assigned. The till cannot number these: two devices firing
  // at the same moment would both read the same highest number and pick it.
  ticketNo Int

  tableId   String
  tableName String
  // The sitting this belongs to, so a re-seated table starts owing the kitchen
  // everything on the new order rather than inheriting the last party's tally.
  billId    String

  // new | preparing | ready | served
  status    String    @default("new")
  // KotLine[]: { key, name, qty, unit, note }. A fired snapshot — never queried
  // line by line, so it is one column rather than a child table.
  linesJson String    @default("[]")
  firedAt   DateTime  @default(now())
  servedAt  DateTime?

  // Durable create idempotency: a retried fire must not put the dish on twice.
  // Nullable, and NULLs are DISTINCT in a unique index, so tickets without a
  // key never collide with each other.
  idempotencyKey String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  shop     Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  location StoreLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([shopId, idempotencyKey])
  @@unique([shopId, ticketNo])
  @@index([shopId, deletedAt, firedAt])
  @@index([shopId, status, firedAt])
  @@index([shopId, billId])
}

// ─────────────────────────────────────────────
// MENU ADD-ONS — "extra cheese", "no onion", "choose your bread"
// ─────────────────────────────────────────────
// A group is defined ONCE per shop and attached to as many dishes as serve it.
// Petpooja-style per-dish add-on lists mean editing the price of extra cheese in
// forty places; here the paneer tikka and the paneer roll share one group, and a
// price rise is one edit.
//
// What a group carries is the RULE, not just the list: how many options a guest
// must pick (minSelect 1 = "choose your bread" is compulsory) and how many they
// may (maxSelect). Those two numbers are what stop a kitchen receiving an order
// for a burger with no bun or with four.
model MenuAddonGroup {
  id        String    @id @default(cuid())
  shopId    String
  name      String
  // 0 = optional. 1 or more = the guest must choose that many before the line
  // can be added, which is how a compulsory choice is expressed.
  minSelect Int       @default(0)
  // 0 = no ceiling. Anything else caps the picks.
  maxSelect Int       @default(0)
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  shop    Shop                @relation(fields: [shopId], references: [id])
  options MenuAddonOption[]
  dishes  ProductAddonGroup[]

  @@unique([shopId, name])
  @@index([shopId, isActive, sortOrder])
}

model MenuAddonOption {
  id              String  @id @default(cuid())
  shopId          String
  groupId         String
  name            String
  // May be zero, and often is: "no onion" and "less spicy" are instructions the
  // kitchen needs and the guest is not charged for.
  priceDelta      Float   @default(0)
  priceDeltaPaise BigInt?
  // The stock item this actually consumes, when it consumes one. Null means a
  // cooking instruction rather than an ingredient, so nothing is deducted.
  linkedProductId String?
  linkedQtyBase   Float   @default(1)
  sortOrder       Int     @default(0)
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop           Shop            @relation(fields: [shopId], references: [id])
  group          MenuAddonGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  billItemAddons BillItemAddon[]

  @@unique([shopId, groupId, name])
  @@index([shopId, groupId, isActive])
}

/// Which dishes offer which group. The join is what makes a group reusable.
model ProductAddonGroup {
  id        String @id @default(cuid())
  shopId    String
  productId String
  groupId   String
  sortOrder Int    @default(0)

  shop    Shop           @relation(fields: [shopId], references: [id])
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  group   MenuAddonGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([productId, groupId])
  @@index([shopId, productId])
}

/// What was actually chosen on one sold line, snapshotted.
///
/// Every descriptive field is copied rather than joined, for the same reason a
/// bill item copies the product name: a receipt reprinted next year must read
/// what was sold at the price it was sold for, not what the option is called and
/// costs today. optionId is nullable so retiring an option never orphans a bill.
model BillItemAddon {
  id         String  @id @default(cuid())
  billItemId String
  optionId   String?
  groupName  String
  name       String
  price      Float   @default(0)
  pricePaise BigInt?
  quantity   Float   @default(1)

  createdAt DateTime @default(now())

  billItem BillItem         @relation(fields: [billItemId], references: [id], onDelete: Cascade)
  option   MenuAddonOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@index([billItemId])
  @@index([optionId])
}

// Provider-neutral order and payout reconciliation. Importers map their own
// CSV headers onto these canonical fields; no proprietary format is guessed.
model ChannelSettlementImport {
  id                 String   @id @default(cuid())
  shopId             String
  locationId         String?
  provider           String
  fileName           String
  fileHash           String
  mappingJson        String
  periodFrom         DateTime?
  periodTo           DateTime?
  rowCount           Int      @default(0)
  grossPaise         BigInt   @default(0)
  calculatedNetPaise BigInt   @default(0)
  paidNetPaise       BigInt   @default(0)
  variancePaise      BigInt   @default(0)
  status             String   @default("processed")
  importedByUserId   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  shop     Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  location StoreLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  rows     ChannelSettlementRow[]

  @@unique([shopId, provider, fileHash])
  @@index([shopId, createdAt])
  @@index([shopId, locationId, createdAt])
  @@index([shopId, provider, createdAt])
}

model ChannelSettlementRow {
  id                         String   @id @default(cuid())
  importId                   String
  shopId                     String
  locationId                 String?
  provider                   String
  rowNumber                  Int
  rowFingerprint             String
  externalOrderId            String
  orderDate                  DateTime
  channelStatus              String?
  currency                   String   @default("INR")
  grossPaise                 BigInt
  merchantDiscountPaise      BigInt   @default(0)
  platformCommissionPaise    BigInt   @default(0)
  paymentFeePaise            BigInt   @default(0)
  taxOnFeesPaise             BigInt   @default(0)
  tcsPaise                   BigInt   @default(0)
  tdsPaise                   BigInt   @default(0)
  adjustmentPaise            BigInt   @default(0)
  refundPaise                BigInt   @default(0)
  providerExpectedNetPaise   BigInt?
  calculatedExpectedNetPaise BigInt
  paidNetPaise               BigInt
  variancePaise              BigInt
  mismatchTypesJson          String   @default("[]")
  matchStatus                String   @default("open")
  candidateCustomerOrderId   String?
  candidateBillId            String?
  matchedCustomerOrderId     String?
  matchedBillId              String?
  bankStatementTransactionId String?
  resolutionStatus           String   @default("open")
  resolutionNote             String?
  resolvedByUserId           String?
  resolvedAt                 DateTime?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  import   ChannelSettlementImport  @relation(fields: [importId], references: [id], onDelete: Cascade)
  shop     Shop                     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  location StoreLocation?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  events   ChannelSettlementEvent[]

  @@unique([importId, rowNumber])
  @@index([shopId, externalOrderId])
  @@index([shopId, locationId, orderDate])
  @@index([shopId, resolutionStatus, orderDate])
  @@index([shopId, provider, orderDate])
  @@index([importId, matchStatus])
}

model ChannelSettlementEvent {
  id           String   @id @default(cuid())
  shopId       String
  rowId        String
  action       String
  previousJson String
  nextJson     String
  reason       String?
  actorUserId  String?
  createdAt    DateTime @default(now())

  shop Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  row  ChannelSettlementRow @relation(fields: [rowId], references: [id], onDelete: Cascade)

  @@index([shopId, rowId, createdAt])
  @@index([shopId, action, createdAt])
}

// ─────────────────────────────────────────────
// COMBOS — a thali, a meal deal, "burger + fries + coke"
// ─────────────────────────────────────────────
// A combo needs no pricing of its own: it IS a Product, sold at that product's
// price, taxed and reported through the same path as any dish. What it adds is
// the list of dishes a guest actually receives, which is what the kitchen has to
// cook and what stock has to lose.
//
// Depth is deliberately ONE. A component must be a plain dish, never another
// combo. That is not a simplification for its own sake: it makes a cycle
// impossible to write, so no query can loop and no thali can contain itself.
// combos.service.js enforces it with a sentence rather than a stack overflow.
model MenuComboComponent {
  id     String @id @default(cuid())
  shopId String

  /// The sellable combo. Its own price is what the guest pays.
  comboProductId     String
  componentProductId String
  /// Copied so a combo report reads without a join, like a recipe's ingredientName.
  componentName      String

  /// How many of this dish the combo includes — 2 roti in a thali.
  quantity  Float @default(1)
  sortOrder Int   @default(0)
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, comboProductId, componentProductId])
  @@index([shopId, comboProductId])
  /// "Which combos include roti?" — asked whenever a dish is 86'd or repriced.
  @@index([shopId, componentProductId])
}
