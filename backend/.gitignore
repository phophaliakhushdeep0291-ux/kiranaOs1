# Release proof artifacts
release-artifacts
/backups/
# Runtime shop backup snapshots (BACKUP_STORAGE_DIR default) — anchored so
# src/modules/backups source is never hidden (deployment-readiness asserts this).
/storage/backups/
# Generated report exports (CSV/PDF/XLSX) written by the local storage provider.
# These contain real shop data and are regenerated per job — never commit them.
/storage/exports/
*.dump

# Year-sim run outputs — scripts/year-sim/*.mjs regenerate this dir every run
# (simulation-summary.json, crash.json, YEAR-REPORT.md, csvBills.csv, ...).
# The .mjs scripts stay tracked; only their generated output is ignored.
/scripts/year-sim/out/

# Stray database / file backups (e.g. dev.db.before-*.bak from QA snapshots)
*.bak

/scripts/year-sim/runs/
